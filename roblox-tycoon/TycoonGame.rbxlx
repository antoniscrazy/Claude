			<Item class="ModuleScript" referent="RBX6">
				<Properties>
					<string name="Name">Types</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Types – zentrale Typdefinitionen.

	Dieses Modul enthaelt absichtlich KEINE Laufzeitlogik. Es exportiert nur
	Typen, damit Server, Client und Config gegen dieselben Vertraege arbeiten
	und der Luau-Typechecker Fehler an der Grenze zwischen den Schichten
	findet, statt erst zur Laufzeit.
]]

export type UpgradeKind = "dropper" | "upgrader" | "collector" | "rate" | "speed" | "cosmetic"

-- Effekt eines Upgrades. Ein Union waere praeziser, ist aber in Luau ohne
-- Tagged-Union-Narrowing bei Tabellen-Literalen unhandlich; stattdessen ein
-- Record mit optionalen Feldern plus `kind` als Diskriminator.
export type UpgradeEffect = {
	kind: UpgradeKind,
	value: number?,     -- dropper: Wert eines erzeugten Erzes
	interval: number?,  -- dropper: Sekunden zwischen zwei Drops
	mult: number?,      -- upgrader / collector: Multiplikator
	factor: number?,    -- rate: Beschleunigung aller Dropper
	speed: number?,     -- speed: neue Bandgeschwindigkeit in studs/s
}

export type UpgradeDef = {
	id: string,
	rank: number,
	price: number,
	requires: { string },  -- Abhaengigkeiten; Button erscheint erst, wenn alle gekauft
	label: string,
	desc: string,
	effect: UpgradeEffect,
}

export type DropperDef = {
	value: number,
	interval: number,
}

-- Was dauerhaft pro Spieler gespeichert wird.
export type ProfileData = {
	version: number,
	cash: number,
	gems: number,
	rebirths: number,
	totalEarned: number,
	purchased: { [string]: boolean },   -- gekaufte Upgrade-Ids
	redeemedCodes: { [string]: boolean },
	receipts: { [string]: boolean },    -- Idempotenz fuer Developer-Products
	quests: { [string]: number },       -- Fortschrittszaehler
	claimedQuests: { [string]: boolean },
	dailyLastClaim: number,             -- os.time() der letzten Abholung
	dailyStreak: number,
	settings: { [string]: boolean },
	playtime: number,                   -- Sekunden Gesamtspielzeit
}

export type Profile = {
	data: ProfileData,
	userId: number,
	key: string,
	loaded: boolean,
	releasing: boolean,
	lockAcquired: boolean,
	lastSave: number,
	dirty: boolean,
}

-- Zustand, den der Server an den Client repliziert.
export type ClientState = {
	cash: number,
	gems: number,
	rebirths: number,
	totalEarned: number,
	incomePerSecond: number,
	purchased: { [string]: boolean },
	available: { [string]: boolean },   -- Abhaengigkeiten erfuellt, noch nicht gekauft
	plotIndex: number?,
	rebirthCost: number,
	rebirthMultiplier: number,
	nextRebirthMultiplier: number,
	dailyReady: boolean,
	dailyStreak: number,
	quests: { [string]: number },
	claimedQuests: { [string]: boolean },
	owns2xCash: boolean,
	ownsVip: boolean,
}

export type QuestDef = {
	id: string,
	label: string,
	metric: string,   -- welcher Zaehler in ProfileData.quests
	target: number,
	rewardGems: number,
}

export type CodeDef = {
	cash: number?,
	gems: number?,
}

export type GemProductDef = {
	id: string,
	productId: number,
	gems: number,
	label: string,
}

-- Lifecycle, den jeder Serverdienst implementiert. Init verdrahtet nur
-- Referenzen (darf nicht yielden), Start darf yielden und Arbeit aufnehmen.
export type Service = {
	name: string,
	Init: ((Registry) -> ())?,
	Start: (() -> ())?,
	priority: number?,
}

export type Registry = { [string]: any }

return {}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7">
				<Properties>
					<string name="Name">Log</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Log – strukturiertes Logging mit Level.

	Warum eigenes Logging statt print(): im Live-Betrieb ist der Output sonst
	nach wenigen Minuten unlesbar. Ueber Config.LOG_LEVEL laesst sich die
	Geschwaetzigkeit zentral drehen, ohne print-Aufrufe zu suchen.
	Zusaetzlich drosselt `throttled` wiederkehrende Meldungen, damit ein
	Fehler in einer Schleife nicht 10.000 Zeilen produziert.
]]

local Config = require(script.Parent.Config)

local Log = {}

local LEVEL_NAMES = { [0] = "DEBUG", [1] = "INFO", [2] = "WARN", [3] = "ERROR" }

-- Zeitpunkt der letzten Ausgabe je Drossel-Schluessel.
local lastEmit: { [string]: number } = {}

local function emit(level: number, scope: string, message: string)
	if level < Config.LOG_LEVEL then
		return
	end
	local line = string.format("[%s][%s] %s", LEVEL_NAMES[level] or "?", scope, message)
	if level >= 3 then
		-- warn statt error: ein Logeintrag darf niemals den aufrufenden
		-- Thread abbrechen.
		warn(line)
	elseif level == 2 then
		warn(line)
	else
		print(line)
	end
end

function Log.debug(scope: string, message: string)
	emit(0, scope, message)
end

function Log.info(scope: string, message: string)
	emit(1, scope, message)
end

function Log.warn(scope: string, message: string)
	emit(2, scope, message)
end

function Log.error(scope: string, message: string)
	emit(3, scope, message)
end

--[[
	Gibt eine Meldung hoechstens alle `seconds` Sekunden aus.
	Gedacht fuer Fehler, die in einer Schleife auftreten koennen
	(z. B. DataStore nicht erreichbar).
]]
function Log.throttled(key: string, seconds: number, level: number, scope: string, message: string)
	local now = os.clock()
	local last = lastEmit[key]
	if last ~= nil and now - last < seconds then
		return
	end
	lastEmit[key] = now
	emit(level, scope, message)
end

return Log
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8">
				<Properties>
					<string name="Name">Format</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Format – Zahlen- und Zeitformatierung fuer die UI.

	Liegt in Shared, weil Server (Billboards ueber der Welt) und Client (HUD)
	exakt dieselbe Darstellung brauchen. Zwei verschiedene Formatierer waeren
	eine sichere Quelle fuer "im HUD steht 1.2M, am Button 1.19M".
]]

local Format = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

--[[
	Kurzform fuer Geldbetraege: 1234 -> "1.23K", 1500000 -> "1.5M".
	Ab 1e36 wird auf wissenschaftliche Notation umgeschaltet, damit die
	Suffixliste nicht ueberlaeuft (passiert bei hohen Rebirths wirklich).
]]
function Format.abbreviate(value: number): string
	if value ~= value then          -- NaN abfangen, sonst steht "nan" in der UI
		return "0"
	end
	local sign = if value < 0 then "-" else ""
	local n = math.abs(value)
	if n < 1000 then
		return sign .. tostring(math.floor(n))
	end
	local tier = math.floor(math.log(n, 1000))
	if tier > #SUFFIXES then
		return sign .. string.format("%.2e", n)
	end
	local scaled = n / (1000 ^ tier)
	-- %.3g haelt die Breite konstant (3 signifikante Stellen), damit die
	-- Buttons in der UI nicht springen.
	return sign .. string.format("%.3g", scaled) .. SUFFIXES[tier]
end

-- Volle Schreibweise mit Tausenderpunkten: 1234567 -> "1.234.567"
function Format.full(value: number): string
	local sign = if value < 0 then "-" else ""
	local s = tostring(math.floor(math.abs(value)))
	local out = ""
	local count = 0
	for i = #s, 1, -1 do
		out = string.sub(s, i, i) .. out
		count += 1
		if count % 3 == 0 and i > 1 then
			out = "." .. out
		end
	end
	return sign .. out
end

-- Sekunden -> "2h 14m" / "14m 3s" / "9s"
function Format.duration(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	local sec = s % 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	elseif m > 0 then
		return string.format("%dm %ds", m, sec)
	end
	return string.format("%ds", sec)
end

return Format
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX9">
				<Properties>
					<string name="Name">Trove</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Trove – Aufraeumtabelle gegen Memory Leaks.

	Jede Verbindung, jede Instanz und jeder Timer, den ein Dienst anlegt,
	wandert in einen Trove. Beim Spielerabgang oder Plot-Reset wird der Trove
	einmal geleert und damit garantiert ALLES freigegeben - statt in jedem
	Dienst eine eigene, unvollstaendige Aufraeumliste zu pflegen.

	Bewusst minimal gehalten: add / connect / extend / clean / destroy.
]]

export type Trove = {
	_objects: { any },
	_cleaning: boolean,

	add: <T>(self: Trove, object: T) -> T,
	connect: (self: Trove, signal: RBXScriptSignal, handler: (...any) -> ()) -> RBXScriptConnection,
	extend: (self: Trove) -> Trove,
	remove: (self: Trove, object: any) -> boolean,
	clean: (self: Trove) -> (),
	destroy: (self: Trove) -> (),
}

local Trove = {}
Trove.__index = Trove

-- Raeumt genau ein Objekt auf. Die Reihenfolge der Faelle ist bewusst:
-- Funktionen zuerst (billigster Test), dann Verbindungen, dann Instanzen.
local function cleanupOne(object: any)
	local t = typeof(object)
	if t == "function" then
		object()
	elseif t == "RBXScriptConnection" then
		object:Disconnect()
	elseif t == "Instance" then
		object:Destroy()
	elseif t == "table" then
		if typeof(object.destroy) == "function" then
			object:destroy()
		elseif typeof(object.Destroy) == "function" then
			object:Destroy()
		end
	end
end

function Trove.new(): Trove
	return (setmetatable({ _objects = {}, _cleaning = false }, Trove) :: any) :: Trove
end

-- Nimmt ein Objekt auf und gibt es unveraendert zurueck, damit sich
-- `local c = trove:add(part.Touched:Connect(fn))` in einer Zeile schreibt.
function Trove.add<T>(self: Trove, object: T): T
	table.insert(self._objects, object)
	return object
end

function Trove.connect(self: Trove, signal: RBXScriptSignal, handler: (...any) -> ()): RBXScriptConnection
	local conn = signal:Connect(handler)
	table.insert(self._objects, conn)
	return conn
end

-- Ein Unter-Trove, der mitgeleert wird. Praktisch fuer "alles zu diesem
-- einen Plot", das innerhalb eines laengerlebigen Troves liegt.
function Trove.extend(self: Trove): Trove
	local sub = Trove.new()
	table.insert(self._objects, sub)
	return sub
end

function Trove.remove(self: Trove, object: any): boolean
	local index = table.find(self._objects, object)
	if index == nil then
		return false
	end
	table.remove(self._objects, index)
	cleanupOne(object)
	return true
end

function Trove.clean(self: Trove)
	if self._cleaning then
		-- Schutz gegen Rekursion: ein aufgeraeumtes Objekt darf beim
		-- Aufraeumen nicht denselben Trove nochmal leeren.
		return
	end
	self._cleaning = true
	-- Rueckwaerts: zuletzt angelegte Objekte zuerst freigeben.
	for i = #self._objects, 1, -1 do
		local object = self._objects[i]
		self._objects[i] = nil
		-- Der Wrapper mit explizitem Rueckgabetyp ist noetig, damit pcall
		-- laut Typechecker zwei Werte liefert (cleanupOne gibt nichts zurueck).
		local ok, err = pcall(function(): string?
			cleanupOne(object)
			return nil
		end)
		if not ok then
			warn("[Trove] Aufraeumen fehlgeschlagen: " .. tostring(err))
		end
	end
	self._cleaning = false
end

function Trove.destroy(self: Trove)
	self:clean()
end

return Trove
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX10">
				<Properties>
					<string name="Name">RateLimiter</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RateLimiter – Token-Bucket pro Spieler und pro Remote.

	Warum: jedes RemoteEvent ist eine offene Tuer. Ein Exploiter kann ein
	Remote in einer Schleife tausendfach pro Sekunde feuern. Ohne Limit
	haengt der Server an der Validierung oder am DataStore. Der Bucket
	kostet pro Aufruf eine Subtraktion und eine Zeitdifferenz.

	Der Bucket fuellt sich kontinuierlich (nicht in festen Fenstern), damit
	eine ehrliche UI mit kurzen Bursts nicht faelschlich geblockt wird.
]]

export type Bucket = { tokens: number, last: number, rate: number }

local RateLimiter = {}

-- [userId][key] = Bucket
local buckets: { [number]: { [string]: Bucket } } = {}

--[[
	Gibt true zurueck, wenn der Aufruf erlaubt ist, und verbraucht dann ein
	Token. Gibt false zurueck, wenn das Budget erschoepft ist.
	`rate` = erlaubte Aufrufe pro Sekunde; die Bucket-Tiefe ist rate (also
	maximal eine Sekunde Burst im Voraus).
]]
function RateLimiter.consume(userId: number, key: string, rate: number): boolean
	local perPlayer = buckets[userId]
	if perPlayer == nil then
		perPlayer = {}
		buckets[userId] = perPlayer
	end

	local bucket = perPlayer[key]
	local now = os.clock()
	if bucket == nil then
		bucket = { tokens = rate, last = now, rate = rate }
		perPlayer[key] = bucket
	end

	-- Auffuellen seit dem letzten Aufruf, gedeckelt auf die Bucket-Tiefe.
	local elapsed = now - bucket.last
	bucket.last = now
	bucket.tokens = math.min(rate, bucket.tokens + elapsed * rate)

	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

-- Muss bei PlayerRemoving aufgerufen werden, sonst waechst die Tabelle
-- ueber die Serverlaufzeit unbegrenzt (klassisches Leak).
function RateLimiter.clear(userId: number)
	buckets[userId] = nil
end

return RateLimiter
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">Config</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Config – die EINZIGE Quelle fuer Zahlen, Preise und Asset-Ids.

	Regel im Projekt: keine Magic Numbers im Logikcode. Wer eine Zahl braucht,
	holt sie hier. Die Upgrade-Tabelle unten ist NICHT von Hand getippt, sondern
	von tools/balance_sim.py erzeugt und dort auch verifiziert
	(Erstkauf < 45 s, Rebirth 1 nach ~30 min, kein Schritt > 2.5x langsamer
	als der vorherige). Wer Preise aendert, aendert sie im Simulator und
	generiert diese Tabelle neu - sonst stimmt die Kurve nicht mehr.

	Thema: Bergbau-Imperium. Das Thema steckt ausschliesslich in Namen, Farben
	und Materialien in diesem Modul - die Spiellogik ist themenneutral.
]]

local Types = require(script.Parent.Types)

local Config = {}

-- ==========================================================================
-- ALLGEMEIN
-- ==========================================================================

Config.GAME_NAME = "Bergbau-Imperium"
Config.DATA_STORE_NAME = "BergbauImperium_Profiles_v1"
Config.LEADERBOARD_STORE_NAME = "BergbauImperium_Leaderboard_v1"

-- Log-Level: 0=Debug 1=Info 2=Warn 3=Error. Im Live-Betrieb auf 1 lassen,
-- damit der Output nicht zugemuellt wird.
Config.LOG_LEVEL = 1

-- ==========================================================================
-- WELT
-- ==========================================================================

Config.WORLD = {
	PLOT_COUNT = 6,
	-- Plots liegen in einem 3x2-Raster.
	PLOT_COLUMNS = 3,
	PLOT_SPACING_X = 190,
	PLOT_SPACING_Z = 210,
	PLOT_SIZE = Vector3.new(160, 2, 170),
	-- Ein Kauf ueber die Shop-UI ist nur gueltig, wenn der Spieler innerhalb
	-- dieses Radius um sein Plot-Zentrum steht (Server-Distanzpruefung).
	PURCHASE_RADIUS = 140,
	LOBBY_CENTER = Vector3.new(0, 4, 300),
	LOBBY_SIZE = Vector3.new(140, 2, 90),
}

Config.COLORS = {
	ROCK = Color3.fromRGB(88, 92, 102),
	STEEL = Color3.fromRGB(122, 128, 140),
	DARK_STEEL = Color3.fromRGB(52, 56, 66),
	ACCENT = Color3.fromRGB(255, 176, 48),
	ACCENT_DARK = Color3.fromRGB(190, 120, 20),
	CASH = Color3.fromRGB(120, 235, 150),
	GEM = Color3.fromRGB(130, 190, 255),
	LOCKED = Color3.fromRGB(96, 100, 112),
	BUYABLE = Color3.fromRGB(70, 170, 255),
	BOUGHT = Color3.fromRGB(70, 200, 120),
	PANEL = Color3.fromRGB(22, 24, 32),
	PANEL_LIGHT = Color3.fromRGB(34, 37, 48),
	TEXT = Color3.fromRGB(236, 238, 245),
	TEXT_DIM = Color3.fromRGB(158, 163, 178),
	DANGER = Color3.fromRGB(255, 96, 96),
}

-- ==========================================================================
-- OEKONOMIE (Werte aus tools/balance_sim.py)
-- ==========================================================================

Config.ECONOMY = {
	-- Gratis-Startdropper: sorgt dafuer, dass in < 10 s das erste Geld laeuft.
	START_DROPPER = { value = 20, interval = 2.0 } :: Types.DropperDef,
	START_CASH = 0,
	START_GEMS = 0,

	CONVEYOR_BASE_SPEED = 20,       -- studs/s, bevor Band-Upgrades greifen
	ORE_LIFETIME = 25,              -- Sekunden, danach wird ein Erz entsorgt
	MAX_ORES_PER_PLOT = 45,         -- harte Obergrenze gegen Lag
	ORE_SIZE = Vector3.new(1.6, 1.6, 1.6),
	ORE_FALL_KILL_Y = -40,          -- darunter gilt ein Erz als verloren

	-- Wie oft der zentrale Scheduler laeuft. Alles Serverseitige haengt an
	-- diesen beiden Frequenzen - es gibt KEINEN Heartbeat pro Instanz.
	DROP_TICK_HZ = 10,              -- Dropper-Takt
	SWEEP_TICK_HZ = 2,              -- Aufraeumen / Limits
	STATE_PUSH_HZ = 4,              -- Zustands-Replikation zum Client
}

-- ==========================================================================
-- UPGRADE-BAUM (generiert - siehe Kopfkommentar)
-- ==========================================================================

Config.UPGRADES = {
	-- GENERIERT-ANFANG (tools/gen_config.py) - nicht von Hand aendern
	{ id = "dropper_2", rank = 1, price = 200, requires = {},
	  label = "Zweiter Bohrer", desc = "Ein weiterer Bohrer am Band",
	  effect = { kind = "dropper", value = 10, interval = 2 } },
	{ id = "conveyor_1", rank = 2, price = 310, requires = {"dropper_2"},
	  label = "Band Stufe I", desc = "Hoeherer Durchsatz auf dem Band",
	  effect = { kind = "speed", speed = 26 } },
	{ id = "upgrader_1", rank = 3, price = 481, requires = {"conveyor_1"},
	  label = "Schmelzofen I", desc = "Veredelt jedes Erz beim Durchfahren",
	  effect = { kind = "upgrader", mult = 1.49 } },
	{ id = "dropper_3", rank = 4, price = 745, requires = {"upgrader_1"},
	  label = "Dritter Bohrer", desc = "Noch ein Bohrer am Band",
	  effect = { kind = "dropper", value = 15, interval = 2 } },
	{ id = "rate_1", rank = 5, price = 1150, requires = {"dropper_3"},
	  label = "Bohrkopf I", desc = "Alle Bohrer foerdern schneller",
	  effect = { kind = "rate", factor = 1.25 } },
	{ id = "collector_1", rank = 6, price = 1790, requires = {"rate_1"},
	  label = "Waage I", desc = "Der Sammler zahlt mehr aus",
	  effect = { kind = "collector", mult = 1.79 } },
	{ id = "upgrader_2", rank = 7, price = 2770, requires = {"collector_1"},
	  label = "Schmelzofen II", desc = "Zweite Veredelungsstufe",
	  effect = { kind = "upgrader", mult = 1.49 } },
	{ id = "dropper_4", rank = 8, price = 4300, requires = {"upgrader_2"},
	  label = "Vierter Bohrer", desc = "Ein Bohrer mehr",
	  effect = { kind = "dropper", value = 22, interval = 2 } },
	{ id = "walls", rank = 9, price = 6660, requires = {"dropper_4"},
	  label = "Hallenwaende", desc = "Schliesst die Fabrikhalle ein",
	  effect = { kind = "cosmetic" } },
	{ id = "rate_2", rank = 10, price = 10300, requires = {"walls"},
	  label = "Bohrkopf II", desc = "Bohrer foerdern noch schneller",
	  effect = { kind = "rate", factor = 1.25 } },
	{ id = "conveyor_2", rank = 11, price = 16000, requires = {"rate_2"},
	  label = "Band Stufe II", desc = "Schnelleres Foerderband",
	  effect = { kind = "speed", speed = 32 } },
	{ id = "upgrader_3", rank = 12, price = 24800, requires = {"conveyor_2"},
	  label = "Schmelzofen III", desc = "Dritte Veredelungsstufe",
	  effect = { kind = "upgrader", mult = 1.79 } },
	{ id = "dropper_5", rank = 13, price = 38500, requires = {"upgrader_3"},
	  label = "Fuenfter Bohrer", desc = "Ein Bohrer mehr",
	  effect = { kind = "dropper", value = 33, interval = 2 } },
	{ id = "collector_2", rank = 14, price = 59600, requires = {"dropper_5"},
	  label = "Waage II", desc = "Der Sammler zahlt noch mehr aus",
	  effect = { kind = "collector", mult = 1.49 } },
	{ id = "roof", rank = 15, price = 92400, requires = {"collector_2", "walls"},
	  label = "Hallendach", desc = "Setzt der Halle ein Dach auf",
	  effect = { kind = "cosmetic" } },
	{ id = "rate_3", rank = 16, price = 143000, requires = {"roof"},
	  label = "Bohrkopf III", desc = "Bohrer foerdern noch schneller",
	  effect = { kind = "rate", factor = 1.25 } },
	{ id = "upgrader_4", rank = 17, price = 222000, requires = {"rate_3"},
	  label = "Schmelzofen IV", desc = "Vierte Veredelungsstufe",
	  effect = { kind = "upgrader", mult = 1.79 } },
	{ id = "dropper_6", rank = 18, price = 344000, requires = {"upgrader_4"},
	  label = "Sechster Bohrer", desc = "Ein Bohrer mehr",
	  effect = { kind = "dropper", value = 49, interval = 2 } },
	{ id = "conveyor_3", rank = 19, price = 533000, requires = {"dropper_6"},
	  label = "Band Stufe III", desc = "Maximales Bandtempo",
	  effect = { kind = "speed", speed = 40 } },
	{ id = "collector_3", rank = 20, price = 827000, requires = {"conveyor_3"},
	  label = "Waage III", desc = "Maximale Auszahlung",
	  effect = { kind = "collector", mult = 1.49 } },
	{ id = "lights", rank = 21, price = 1280000, requires = {"collector_3", "roof"},
	  label = "Hallenbeleuchtung", desc = "Flutlicht fuer die Halle",
	  effect = { kind = "cosmetic" } },
	{ id = "rate_4", rank = 22, price = 1990000, requires = {"lights"},
	  label = "Bohrkopf IV", desc = "Maximale Foerdergeschwindigkeit",
	  effect = { kind = "rate", factor = 1.25 } },
	{ id = "upgrader_5", rank = 23, price = 3080000, requires = {"rate_4"},
	  label = "Schmelzofen V", desc = "Fuenfte Veredelungsstufe",
	  effect = { kind = "upgrader", mult = 1.79 } },
	{ id = "dropper_7", rank = 24, price = 4770000, requires = {"upgrader_5"},
	  label = "Siebter Bohrer", desc = "Der letzte Bohrer",
	  effect = { kind = "dropper", value = 74, interval = 2 } },
	{ id = "vip_room", rank = 25, price = 7400000, requires = {"dropper_7"},
	  label = "VIP-Lounge", desc = "Oeffnet den VIP-Bereich auf dem Plot",
	  effect = { kind = "cosmetic" } },
	-- GENERIERT-ENDE
} :: { Types.UpgradeDef }

-- Schneller Zugriff nach Id. Wird einmal beim Laden gebaut.
Config.UPGRADES_BY_ID = {} :: { [string]: Types.UpgradeDef }
for _, def in ipairs(Config.UPGRADES) do
	Config.UPGRADES_BY_ID[def.id] = def
end

-- ==========================================================================
-- REBIRTH
-- ==========================================================================

Config.REBIRTH = {
	BASE_COST = 1000000,   -- Kosten fuer Rebirth 1 (im Simulator verifiziert)
	COST_GROWTH = 6.5,     -- jeder weitere Rebirth kostet das 6.5-fache
	CASH_MULT_PER = 0.75,  -- +75 % Einkommen je Rebirth
	GEMS_PER = 5,          -- Gems als Belohnung je Rebirth
}

-- Einkommensmultiplikator bei n Rebirths.
function Config.rebirthMultiplier(rebirths: number): number
	return 1 + Config.REBIRTH.CASH_MULT_PER * rebirths
end

-- Kosten fuer den naechsten Rebirth bei n bereits absolvierten.
function Config.rebirthCost(rebirths: number): number
	return math.floor(Config.REBIRTH.BASE_COST * (Config.REBIRTH.COST_GROWTH ^ rebirths))
end

-- ==========================================================================
-- MONETARISIERUNG
-- Alle Ids sind Platzhalter. Solange sie 0 sind, ueberspringt der Server
-- jeden Marketplace-Aufruf - dadurch startet das Spiel ohne Fehler im Output.
-- ==========================================================================

Config.MONETIZATION = {
	GAMEPASS_2X_CASH = 0,   -- REPLACE ME: GamePass-Id fuer 2x Cash
	GAMEPASS_VIP = 0,       -- REPLACE ME: GamePass-Id fuer den VIP-Bereich
	CASH_MULT_2X = 2,
	VIP_CASH_MULT = 1.25,
}

Config.GEM_PRODUCTS = {
	{ id = "gems_small",  productId = 0, gems = 50,   label = "50 Gems"   },  -- REPLACE ME
	{ id = "gems_medium", productId = 0, gems = 300,  label = "300 Gems"  },  -- REPLACE ME
	{ id = "gems_large",  productId = 0, gems = 1000, label = "1000 Gems" },  -- REPLACE ME
} :: { Types.GemProductDef }

-- ==========================================================================
-- CODES  (Gross-/Kleinschreibung wird beim Einloesen normalisiert)
-- ==========================================================================

Config.CODES = {
	release   = { cash = 5000,  gems = 10 },
	bergbau   = { cash = 2500,  gems = 5  },
	danke1k   = { cash = 25000, gems = 25 },
	glueckauf = { gems = 50 },
} :: { [string]: Types.CodeDef }

-- ==========================================================================
-- QUESTS / ERFOLGE
-- ==========================================================================

Config.QUESTS = {
	{ id = "earn_10k",    label = "Verdiene 10.000 $",      metric = "earned",    target = 10000,   rewardGems = 5  },
	{ id = "earn_1m",     label = "Verdiene 1.000.000 $",   metric = "earned",    target = 1000000, rewardGems = 25 },
	{ id = "buy_5",       label = "Kaufe 5 Upgrades",       metric = "purchases", target = 5,       rewardGems = 5  },
	{ id = "buy_15",      label = "Kaufe 15 Upgrades",      metric = "purchases", target = 15,      rewardGems = 15 },
	{ id = "buy_all",     label = "Kaufe alle 25 Upgrades", metric = "purchases", target = 25,      rewardGems = 50 },
	{ id = "rebirth_1",   label = "Mache 1 Rebirth",        metric = "rebirths",  target = 1,       rewardGems = 30 },
	{ id = "rebirth_5",   label = "Mache 5 Rebirths",       metric = "rebirths",  target = 5,       rewardGems = 120 },
	{ id = "playtime_1h", label = "Spiele 1 Stunde",        metric = "playtime",  target = 3600,    rewardGems = 20 },
} :: { Types.QuestDef }

-- ==========================================================================
-- DAILY REWARD
-- Die Pruefung laeuft ausschliesslich serverseitig gegen os.time() des
-- Servers. Der Client sagt nur "ich will abholen" und bekommt ja oder nein.
-- ==========================================================================

Config.DAILY = {
	COOLDOWN = 20 * 3600,        -- fruehestens nach 20 Stunden wieder
	STREAK_RESET = 48 * 3600,    -- nach 48 h ohne Abholung faellt die Serie
	BASE_CASH = 2500,
	CASH_PER_STREAK = 2500,
	MAX_STREAK = 7,
	GEMS_AT_MAX = 25,
}

-- ==========================================================================
-- LEADERBOARD
-- ==========================================================================

Config.LEADERBOARD = {
	TOP_N = 50,
	REFRESH_SECONDS = 120,
	PUBLISH_SECONDS = 60,
}

-- ==========================================================================
-- SOUND
-- Leerer String = kein Sound. Es werden bewusst KEINE Asset-Ids erfunden;
-- trage eigene ein, dann spielt das Spiel sie automatisch ab.
-- ==========================================================================

Config.SOUNDS = {
	AMBIENCE = "",   -- REPLACE ME: rbxassetid://...
	PURCHASE = "",   -- REPLACE ME
	COLLECT  = "",   -- REPLACE ME
	REBIRTH  = "",   -- REPLACE ME
	ERROR    = "",   -- REPLACE ME
}

-- ==========================================================================
-- REMOTE-RATE-LIMITS (Aufrufe pro Sekunde und Spieler)
-- Bewusst knapp ueber dem, was eine ehrliche UI braucht.
-- ==========================================================================

Config.RATE_LIMITS = {
	RequestPurchase = 8,
	RequestRebirth = 1,
	RedeemCode = 1,
	ClaimDaily = 1,
	ClaimQuest = 4,
	PromptGemProduct = 2,
}

table.freeze(Config.WORLD)
table.freeze(Config.ECONOMY)
table.freeze(Config.REBIRTH)

return Config
]]></ProtectedString>
