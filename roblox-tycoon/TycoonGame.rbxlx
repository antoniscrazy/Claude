			<Item class="ModuleScript" referent="RBX7">
				<Properties>
					<string name="Name">Format</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Format – Zahlen- und Zeitformatierung fuer die UI.

	Liegt in Shared, weil Server (Billboards ueber der Welt) und Client (HUD)
	exakt dieselbe Darstellung brauchen. Zwei verschiedene Formatierer waeren
	eine sichere Quelle fuer "im HUD steht 1.2M, am Button 1.19M".
]]

local Format = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

--[[
	Kurzform fuer Geldbetraege: 1234 -> "1.23K", 1500000 -> "1.5M".
	Ab 1e36 wird auf wissenschaftliche Notation umgeschaltet, damit die
	Suffixliste nicht ueberlaeuft (passiert bei hohen Rebirths wirklich).
]]
function Format.abbreviate(value: number): string
	if value ~= value then          -- NaN abfangen, sonst steht "nan" in der UI
		return "0"
	end
	local sign = if value < 0 then "-" else ""
	local n = math.abs(value)
	if n < 1000 then
		return sign .. tostring(math.floor(n))
	end
	local tier = math.floor(math.log(n, 1000))
	if tier > #SUFFIXES then
		return sign .. string.format("%.2e", n)
	end
	local scaled = n / (1000 ^ tier)
	-- %.3g haelt die Breite konstant (3 signifikante Stellen), damit die
	-- Buttons in der UI nicht springen.
	return sign .. string.format("%.3g", scaled) .. SUFFIXES[tier]
end

-- Volle Schreibweise mit Tausenderpunkten: 1234567 -> "1.234.567"
function Format.full(value: number): string
	local sign = if value < 0 then "-" else ""
	local s = tostring(math.floor(math.abs(value)))
	local out = ""
	local count = 0
	for i = #s, 1, -1 do
		out = string.sub(s, i, i) .. out
		count += 1
		if count % 3 == 0 and i > 1 then
			out = "." .. out
		end
	end
	return sign .. out
end

-- Sekunden -> "2h 14m" / "14m 3s" / "9s"
function Format.duration(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	local sec = s % 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	elseif m > 0 then
		return string.format("%dm %ds", m, sec)
	end
	return string.format("%ds", sec)
end

return Format
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8">
				<Properties>
					<string name="Name">Log</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Log – strukturiertes Logging mit Level.

	Warum eigenes Logging statt print(): im Live-Betrieb ist der Output sonst
	nach wenigen Minuten unlesbar. Ueber Config.LOG_LEVEL laesst sich die
	Geschwaetzigkeit zentral drehen, ohne print-Aufrufe zu suchen.
	Zusaetzlich drosselt `throttled` wiederkehrende Meldungen, damit ein
	Fehler in einer Schleife nicht 10.000 Zeilen produziert.
]]

local Config = require(script.Parent.Config)

local Log = {}

local LEVEL_NAMES = { [0] = "DEBUG", [1] = "INFO", [2] = "WARN", [3] = "ERROR" }

-- Zeitpunkt der letzten Ausgabe je Drossel-Schluessel.
local lastEmit: { [string]: number } = {}

local function emit(level: number, scope: string, message: string)
	if level < Config.LOG_LEVEL then
		return
	end
	local line = string.format("[%s][%s] %s", LEVEL_NAMES[level] or "?", scope, message)
	if level >= 3 then
		-- warn statt error: ein Logeintrag darf niemals den aufrufenden
		-- Thread abbrechen.
		warn(line)
	elseif level == 2 then
		warn(line)
	else
		print(line)
	end
end

function Log.debug(scope: string, message: string)
	emit(0, scope, message)
end

function Log.info(scope: string, message: string)
	emit(1, scope, message)
end

function Log.warn(scope: string, message: string)
	emit(2, scope, message)
end

function Log.error(scope: string, message: string)
	emit(3, scope, message)
end

--[[
	Gibt eine Meldung hoechstens alle `seconds` Sekunden aus.
	Gedacht fuer Fehler, die in einer Schleife auftreten koennen
	(z. B. DataStore nicht erreichbar).
]]
function Log.throttled(key: string, seconds: number, level: number, scope: string, message: string)
	local now = os.clock()
	local last = lastEmit[key]
	if last ~= nil and now - last < seconds then
		return
	end
	lastEmit[key] = now
	emit(level, scope, message)
end

return Log
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX9">
				<Properties>
					<string name="Name">RateLimiter</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RateLimiter – Token-Bucket pro Spieler und pro Remote.

	Warum: jedes RemoteEvent ist eine offene Tuer. Ein Exploiter kann ein
	Remote in einer Schleife tausendfach pro Sekunde feuern. Ohne Limit
	haengt der Server an der Validierung oder am DataStore. Der Bucket
	kostet pro Aufruf eine Subtraktion und eine Zeitdifferenz.

	Der Bucket fuellt sich kontinuierlich (nicht in festen Fenstern), damit
	eine ehrliche UI mit kurzen Bursts nicht faelschlich geblockt wird.
]]

export type Bucket = { tokens: number, last: number, rate: number }

local RateLimiter = {}

-- [userId][key] = Bucket
local buckets: { [number]: { [string]: Bucket } } = {}

--[[
	Gibt true zurueck, wenn der Aufruf erlaubt ist, und verbraucht dann ein
	Token. Gibt false zurueck, wenn das Budget erschoepft ist.
	`rate` = erlaubte Aufrufe pro Sekunde; die Bucket-Tiefe ist rate (also
	maximal eine Sekunde Burst im Voraus).
]]
function RateLimiter.consume(userId: number, key: string, rate: number): boolean
	local perPlayer = buckets[userId]
	if perPlayer == nil then
		perPlayer = {}
		buckets[userId] = perPlayer
	end

	local bucket = perPlayer[key]
	local now = os.clock()
	if bucket == nil then
		bucket = { tokens = rate, last = now, rate = rate }
		perPlayer[key] = bucket
	end

	-- Auffuellen seit dem letzten Aufruf, gedeckelt auf die Bucket-Tiefe.
	local elapsed = now - bucket.last
	bucket.last = now
	bucket.tokens = math.min(rate, bucket.tokens + elapsed * rate)

	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

-- Muss bei PlayerRemoving aufgerufen werden, sonst waechst die Tabelle
-- ueber die Serverlaufzeit unbegrenzt (klassisches Leak).
function RateLimiter.clear(userId: number)
	buckets[userId] = nil
end

return RateLimiter
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX10">
				<Properties>
					<string name="Name">Remotes</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Remotes – zentrale Registry aller Netzwerkgrenzen.

	Es gibt genau eine Stelle im Projekt, an der ein Remote entsteht. Grund:
	verstreute Instance.new("RemoteEvent") sind im Review nicht auffindbar,
	und jede uebersehene Tuer ist eine Luecke. Wer hier nichts eintraegt,
	kann auch nichts senden.

	Richtung ist dokumentiert, nicht erzwungen (Roblox kann das nicht), aber
	der Server prueft bei jedem eingehenden Remote ohnehin alles selbst.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type RemoteKind = "Event" | "Function"

export type RemoteDef = {
	kind: RemoteKind,
	-- "c2s" = Client sendet Absicht, "s2c" = Server informiert.
	direction: "c2s" | "s2c",
	note: string,
}

local DEFS: { [string]: RemoteDef } = {
	-- Client -> Server (Absichten; der Server validiert jedes Argument)
	RequestPurchase  = { kind = "Event",    direction = "c2s", note = "Spieler will Upgrade kaufen" },
	RequestRebirth   = { kind = "Event",    direction = "c2s", note = "Spieler will rebirthen" },
	RedeemCode       = { kind = "Function", direction = "c2s", note = "Code einloesen, gibt (ok, text)" },
	ClaimDaily       = { kind = "Function", direction = "c2s", note = "Tagesbelohnung, gibt (ok, text)" },
	ClaimQuest       = { kind = "Function", direction = "c2s", note = "Quest-Belohnung, gibt (ok, text)" },
	PromptGemProduct = { kind = "Event",    direction = "c2s", note = "Kaufdialog fuer Gem-Paket oeffnen" },

	-- Server -> Client (reine Information; nie autoritativ auf Clientseite)
	StateChanged     = { kind = "Event",    direction = "s2c", note = "Voller Spielerzustand" },
	Notify           = { kind = "Event",    direction = "s2c", note = "Kurze Meldung (text, kind)" },
	PlaySfx          = { kind = "Event",    direction = "s2c", note = "Soundeffekt ausloesen" },
}

local Remotes = {}
Remotes.DEFS = DEFS

local folder: Folder? = nil

-- Legt den Ordner und alle Remotes an. Darf NUR der Server aufrufen.
function Remotes.initServer(): Folder
	assert(RunService:IsServer(), "Remotes.initServer nur auf dem Server")
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing ~= nil and existing:IsA("Folder") then
		folder = existing
		return existing
	end

	local created = Instance.new("Folder")
	created.Name = "Remotes"
	for name, def in pairs(DEFS) do
		local remote: Instance = if def.kind == "Event"
			then Instance.new("RemoteEvent")
			else Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = created
	end
	created.Parent = ReplicatedStorage
	folder = created
	return created
end

local function container(): Folder
	if folder ~= nil then
		return folder
	end
	local found = ReplicatedStorage:WaitForChild("Remotes", 30)
	assert(found ~= nil and found:IsA("Folder"), "Remotes-Ordner nicht gefunden")
	folder = found
	return found
end

function Remotes.event(name: string): RemoteEvent
	local def = DEFS[name]
	assert(def ~= nil and def.kind == "Event", `Unbekanntes RemoteEvent: {name}`)
	local remote = container():WaitForChild(name, 30)
	assert(remote ~= nil and remote:IsA("RemoteEvent"), `RemoteEvent fehlt: {name}`)
	return remote
end

function Remotes.fn(name: string): RemoteFunction
	local def = DEFS[name]
	assert(def ~= nil and def.kind == "Function", `Unbekannte RemoteFunction: {name}`)
	local remote = container():WaitForChild(name, 30)
	assert(remote ~= nil and remote:IsA("RemoteFunction"), `RemoteFunction fehlt: {name}`)
	return remote
end

return Remotes
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">Theme</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Theme – das Design-System. EINZIGE Quelle fuer Farbe, Abstand, Radius,
	Typografie, Bewegung, Groesse, Ebene und Material.

	Harte Projektregel: ausserhalb dieser Datei steht kein Color3, kein
	Enum.Font, keine Schriftgroesse, kein Radius, kein Pixel-Padding und
	kein TweenInfo. `tools/theme_lint.py` prueft das und bricht den Build
	ab, wenn doch. Wer hier eine Farbe aendert, aendert das ganze Spiel.

	Der Farbblock unten ist GENERIERT aus tools/contrast.py – dort wird
	jede Kombination aus Text und Untergrund gegen WCAG 4.5:1 geprueft,
	bevor sie hier landet.
]]

local Theme = {}

-- ==========================================================================
-- 1. FARBEN
-- ==========================================================================

Theme.Color = {
	-- GENERIERT-ANFANG (tools/gen_theme.py) - nicht von Hand aendern
	-- Oberflaechen
	bg0 = Color3.fromRGB(12, 13, 20),
	bg1 = Color3.fromRGB(20, 22, 33),
	bg2 = Color3.fromRGB(29, 32, 47),
	bg3 = Color3.fromRGB(41, 45, 64),

	-- Text
	textHigh = Color3.fromRGB(243, 243, 249),
	textMid = Color3.fromRGB(183, 188, 208),
	textLow = Color3.fromRGB(146, 152, 176),

	-- Primary - Aktion und Kauf
	primary = Color3.fromRGB(128, 144, 247),
	primaryHover = Color3.fromRGB(157, 169, 249),
	primaryPressed = Color3.fromRGB(92, 112, 245),
	primaryDeep = Color3.fromRGB(33, 54, 189),

	-- Success - Cash und Gewinn
	success = Color3.fromRGB(48, 207, 149),
	successHover = Color3.fromRGB(73, 212, 161),
	successPressed = Color3.fromRGB(41, 176, 126),
	successDeep = Color3.fromRGB(26, 76, 58),

	-- Gem - Hartwaehrung
	gem = Color3.fromRGB(167, 192, 251),
	gemHover = Color3.fromRGB(196, 213, 253),
	gemPressed = Color3.fromRGB(130, 166, 250),
	gemDeep = Color3.fromRGB(42, 96, 223),

	-- Premium - NUR Monetarisierung
	premium = Color3.fromRGB(235, 163, 20),
	premiumHover = Color3.fromRGB(237, 174, 49),
	premiumPressed = Color3.fromRGB(199, 139, 17),
	premiumDeep = Color3.fromRGB(85, 62, 17),
	premiumLight = Color3.fromRGB(250, 210, 120),

	-- Warning
	warning = Color3.fromRGB(236, 135, 19),
	warningHover = Color3.fromRGB(238, 149, 47),
	warningPressed = Color3.fromRGB(200, 115, 16),
	warningDeep = Color3.fromRGB(86, 53, 16),

	-- Danger - Rebirth und Reset
	danger = Color3.fromRGB(237, 86, 69),
	dangerHover = Color3.fromRGB(239, 111, 97),
	dangerPressed = Color3.fromRGB(233, 54, 35),
	dangerDeep = Color3.fromRGB(127, 36, 26),
	-- GENERIERT-ENDE
}

--[[
	Zustandsvarianten. Kein Hover- oder Pressed-Ton wird irgendwo im Code
	improvisiert (kein :Lerp(weiss, 0.1) o. ae.) – jede Variante ist oben
	definiert und kontrastgeprueft.

	Label-Regel: ALLE gefuellten Akzentflaechen tragen bg0 als Textfarbe.
	Ein heller Text auf primary waere bei der noetigen Flaechenhelligkeit
	unter 4.5:1 gefallen; ein Labelwechsel zwischen den Zustaenden wuerde
	ausserdem beim Druecken sichtbar flackern.
]]
export type Variant = "primary" | "secondary" | "ghost" | "danger" | "premium" | "success"

export type ColorSet = {
	fill: Color3,
	fillHover: Color3,
	fillPressed: Color3,
	border: Color3,
	label: Color3,
}

local C = Theme.Color

function Theme.variant(name: Variant): ColorSet
	if name == "primary" then
		return { fill = C.primary, fillHover = C.primaryHover, fillPressed = C.primaryPressed,
			border = C.primaryDeep, label = C.bg0 }
	elseif name == "danger" then
		return { fill = C.danger, fillHover = C.dangerHover, fillPressed = C.dangerPressed,
			border = C.dangerDeep, label = C.bg0 }
	elseif name == "premium" then
		return { fill = C.premium, fillHover = C.premiumHover, fillPressed = C.premiumPressed,
			border = C.premiumDeep, label = C.bg0 }
	elseif name == "success" then
		return { fill = C.success, fillHover = C.successHover, fillPressed = C.successPressed,
			border = C.successDeep, label = C.bg0 }
	elseif name == "secondary" then
		-- Gefuellte, aber neutrale Flaeche: Text in Akzentfarbe.
		return { fill = C.bg3, fillHover = C.bg3, fillPressed = C.bg2,
			border = C.bg3, label = C.textHigh }
	end
	-- ghost: keine Flaeche, nur Rand und Akzenttext
	return { fill = C.bg2, fillHover = C.bg3, fillPressed = C.bg2,
		border = C.bg3, label = C.primary }
end

-- Deckkraft-Stufen. Textabstufungen laufen ueber FARBE (textMid/textLow),
-- nicht ueber Transparency – transparenter Text ueber bunten Flaechen
-- verliert sonst unkontrolliert Kontrast.
Theme.Alpha = {
	opaque = 0,
	glass = 0.08,
	veil = 0.35,
	backdrop = 0.45,
	divider = 0.4,
	ghost = 0.55,
	hidden = 1,
}

-- ==========================================================================
-- 2. ABSTAENDE  (nur diese acht Werte, nichts dazwischen)
-- ==========================================================================

Theme.Space = {
	x2 = 2,
	x4 = 4,
	x8 = 8,
	x12 = 12,
	x16 = 16,
	x24 = 24,
	x32 = 32,
	x48 = 48,
}

-- ==========================================================================
-- 3. RADIEN
-- ==========================================================================

--[[
	Verschachtelungsregel: ein Element IN einem Container hat immer den
	kleineren Radius. Deshalb sind Card (12) und Control (8) getrennt –
	waeren beide 8, haette ein Button in einer Card denselben Radius wie
	die Card selbst und die Regel waere verletzt.
	Ebenen: panel 16 > card 12 > control 8 > chip 4.
]]
Theme.Radius = {
	chip = 4,
	control = 8,
	card = 12,
	panel = 16,
	pill = 999,
}

-- ==========================================================================
-- 4. TYPOGRAFIE
-- ==========================================================================

export type FontRole = "display" | "heading" | "body" | "numeric"

Theme.Font = {
	display = Enum.Font.GothamBlack,
	heading = Enum.Font.GothamBold,
	body = Enum.Font.GothamMedium,
	numeric = Enum.Font.GothamBold,
}

Theme.TextSize = {
	xs = 12,
	sm = 14,
	md = 16,
	lg = 20,
	xl = 24,
	xxl = 32,
	display = 44,
}

Theme.LineHeight = {
	tight = 1.15,
	normal = 1.25,
	loose = 1.3,
}

-- Kontur fuer Text vor bunten oder unruhigen Flaechen.
Theme.TextStroke = {
	thickness = 2,
	transparency = 0.3,
}

-- ==========================================================================
-- 5. RAHMEN, ELEVATION, ASSETS
-- ==========================================================================

Theme.Stroke = {
	hair = 1,
	thin = 2,
	thick = 3,
}

Theme.Elevation = {
	-- Versatz des Schattens nach unten, in Pixeln
	offset = 4,
	transparency = 0.45,
	-- Wie weit der Schatten ueber die Flaeche hinausragt
	spread = 8,
}

--[[
	Schatten-Asset.

	Roblox kennt keine echten Schlagschatten fuer GUI. Der uebliche Weg ist
	ein 9-Slice-PNG hinter der Flaeche. So legst du eines an: ein 128x128
	PNG mit transparentem Rand und weichem schwarzen Kern (Gauss ca. 24 px)
	exportieren, in Roblox hochladen, die Asset-Id unten eintragen und
	SLICE_CENTER auf Rect.new(32, 32, 96, 96) lassen – das haelt die
	weichen 32 px an jeder Kante und streckt nur die Mitte.

	Solange die Id leer ist, zeichnet Theme.shadow eine assetfreie
	Ersatzvariante: eine zweite, dunklere Flaeche mit groesserem Radius,
	nach unten versetzt. Die hat harte Kanten statt Weichzeichnung, liest
	sich aber als Tiefe und kommt ohne erfundene Asset-Ids aus.
]]
Theme.Asset = {
	SHADOW_9SLICE = "", -- REPLACE: 128x128 PNG, weicher schwarzer Schatten
	SLICE_CENTER = Rect.new(32, 32, 96, 96),

	-- Eingebaute Client-Texturen (kein Upload noetig). Austauschbar.
	PARTICLE_SPARKLE = "rbxasset://textures/particles/sparkles_main.dds",
	PARTICLE_SMOKE = "rbxasset://textures/particles/smoke_main.dds",
}

--[[
	Icons. Es werden bewusst KEINE Asset-Ids erfunden und keine Emojis
	benutzt. Solange hier "" steht, zeichnet das Icon-Modul den Glyph aus
	Frames (Kreise, Ringe, gedrehte Quadrate). Traegst du eine Id ein,
	nimmt dasselbe Modul stattdessen ein ImageLabel – ohne Codeaenderung.
]]
Theme.Icon = {
	cash = "",     -- REPLACE: Muenze von vorn, gefuellt
	gem = "",      -- REPLACE: geschliffener Edelstein, Raute
	rebirth = "",  -- REPLACE: kreisender Pfeil
	shop = "",     -- REPLACE: Einkaufstasche
	upgrade = "",  -- REPLACE: Pfeil nach oben in Kreis
	quest = "",    -- REPLACE: Haekchenliste
	code = "",     -- REPLACE: Geschenk
	settings = "", -- REPLACE: Zahnrad
	lock = "",     -- REPLACE: geschlossenes Vorhaengeschloss
	check = "",    -- REPLACE: Haekchen
	close = "",    -- REPLACE: X
	plus = "",     -- REPLACE: Pluszeichen
	drill = "",    -- REPLACE: Bohrkopf
	furnace = "",  -- REPLACE: Schmelzofen
	belt = "",     -- REPLACE: Foerderband
	scale = "",    -- REPLACE: Waage
}

-- ==========================================================================
-- 6. GROESSEN  (jede Pixelzahl im UI-Code kommt aus dieser Tabelle)
-- ==========================================================================

Theme.Size = {
	-- Mindestgroesse fuer eine Tippflaeche NACH UIScale (Apple/Google: 44)
	touchMin = 44,

	controlHeight = 44,
	controlHeightSm = 36,
	iconButton = 48,
	iconInner = 24,
	iconSm = 16,
	iconXs = 12,

	pillHeight = 48,
	pillWidth = 196,
	pillIcon = 32,

	panelWidth = 760,
	panelHeight = 540,
	panelHeaderHeight = 72,
	tabWidth = 152,

	slotWidth = 232,
	slotHeight = 268,
	slotPreview = 116,

	rowHeight = 56,
	barHeight = 10,
	badge = 14,
	dividerHeight = 1,
	scrollBar = 6,
	tooltipMaxWidth = 260,
	toastWidth = 320,
	hintWidth = 420,
	hintHeight = 52,

	-- Weltobjekte (Studs)
	worldSignWidth = 11,
	worldSignOffset = 6,
}

-- Sicherheitsabstaende zu den Bildschirmkanten.
Theme.Safe = {
	edge = 24,
	top = 48,          -- Roblox-Topbar
	bottomMobile = 72, -- Sprungknopf und Bewegungsstick
}

--[[
	Skalierung: 1920x1080 ist die Referenz (Faktor 1.0), gedeckelt bei 1.25.

	Die Untergrenze ist 0.92 und NICHT 0.72. Grund, nachgerechnet: die
	kleinste Stufe der Schriftskala ist 12 px. Unter etwa 11 px ist Text
	auf einem Handy nicht mehr zuverlaessig lesbar. 11 / 12 = 0.917, also
	0.92. Bei 0.72 waere dieselbe Stufe 8.6 px gross - das waere zwar
	regelkonform, aber unlesbar, und die Abnahmebedingung "UI lesbar auf
	375x667" waere verletzt. Der Wert ist damit aus der Lesbarkeits-
	schwelle hergeleitet statt gesetzt; tools/layout_check.py prueft ihn.

	Nebeneffekt: die noetige Entwurfsgroesse fuer eine Tippflaeche sinkt
	von 44/0.72 = 62 px auf 44/0.92 = 48 px - genau Theme.Size.iconButton.
]]
Theme.ScaleRule = {
	referenceWidth = 1920,
	referenceHeight = 1080,
	min = 0.92,
	max = 1.25,
}

-- ==========================================================================
-- 7. EBENEN  (feste ZIndex-Baender, keine ad-hoc Zahlen)
-- ==========================================================================

Theme.Layer = {
	world = 0,
	hud = 100,
	panel = 200,
	modal = 300,
	toast = 400,
	tooltip = 500,
}

-- Innerhalb eines Bandes: Hintergrund, Inhalt, darueberliegendes Element.
Theme.Depth = {
	behind = -1,
	base = 0,
	content = 2,
	raised = 4,
	overlay = 6,
}

-- ==========================================================================
-- 8. BEWEGUNG
-- ==========================================================================

Theme.Duration = {
	fast = 0.12,
	base = 0.18,
	slow = 0.32,
	press = 0.06,
	countUp = 0.32,
	shake = 0.18,
	spin = 0.9,
	shine = 1.6,
	pulse = 1.1,
}

Theme.Easing = {
	-- Eingaenge bremsen aus, Ausgaenge ziehen an, Erfolge federn leicht.
	enter = { style = Enum.EasingStyle.Quart, direction = Enum.EasingDirection.Out },
	exit = { style = Enum.EasingStyle.Quart, direction = Enum.EasingDirection.In },
	pop = { style = Enum.EasingStyle.Back, direction = Enum.EasingDirection.Out },
	press = { style = Enum.EasingStyle.Quart, direction = Enum.EasingDirection.Out },
}

Theme.Scale = {
	hover = 1.03,
	pressed = 0.96,
	panelEnter = 0.92,
	rest = 1,
}

-- Vom Einstellungsmenue gesetzt. Bei true werden alle Dauern zu 0 –
-- das Layout bleibt identisch, nur die Interpolation entfaellt.
Theme.reduceMotion = false

function Theme.duration(seconds: number): number
	return if Theme.reduceMotion then 0 else seconds
end

--[[
	Einziger Ort im Projekt, an dem ein TweenInfo entsteht.
	`easing` ist einer der Schluessel aus Theme.Easing.
]]
function Theme.tweenInfo(seconds: number, easing: string?): TweenInfo
	local preset = (Theme.Easing :: { [string]: { style: Enum.EasingStyle, direction: Enum.EasingDirection } })[easing or "enter"]
	return TweenInfo.new(
		Theme.duration(seconds),
		preset.style,
		preset.direction
	)
end

-- Endlos laufende Bewegung (Ladeanzeige, Glanzstreifen). Bei reduzierter
-- Bewegung liefert diese Funktion nil - der Aufrufer laesst die Animation
-- dann einfach weg, statt mit Dauer 0 endlos schnell zu drehen.
function Theme.loopInfo(seconds: number, reverses: boolean?): TweenInfo?
	if Theme.reduceMotion then
		return nil
	end
	return TweenInfo.new(
		seconds,
		Enum.EasingStyle.Linear,
		Enum.EasingDirection.InOut,
		-1,
		reverses == true
	)
end

-- ==========================================================================
-- 9. MATERIALIEN  (Weltobjekte beziehen ihr Material ebenfalls von hier)
-- ==========================================================================

Theme.Material = {
	surface = Enum.Material.SmoothPlastic,
	metal = Enum.Material.Metal,
	brushed = Enum.Material.DiamondPlate,
	concrete = Enum.Material.Concrete,
	rock = Enum.Material.Slate,
	wood = Enum.Material.WoodPlanks,
	glass = Enum.Material.Glass,
	neon = Enum.Material.Neon,
	force = Enum.Material.ForceField,
	marble = Enum.Material.Marble,
}

-- Reflectance bleibt bewusst niedrig: hohe Werte lassen Roblox-Teile
-- nass statt metallisch aussehen.
Theme.Reflectance = {
	none = 0,
	subtle = 0.06,
	metal = 0.12,
	max = 0.15,
}

-- ==========================================================================
-- 10. BAUSTEINE
-- ==========================================================================

function Theme.corner(parent: Instance, radius: number): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

function Theme.stroke(parent: Instance, color: Color3, thickness: number): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = parent
	return stroke
end

-- Kontur fuer Text. Pflicht vor bunten Flaechen.
function Theme.textStroke(label: Instance): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = C.bg0
	stroke.Thickness = Theme.TextStroke.thickness
	stroke.Transparency = Theme.TextStroke.transparency
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = label
	return stroke
end

export type PaddingSpec = { top: number?, bottom: number?, left: number?, right: number?, all: number? }

function Theme.padding(parent: Instance, spec: PaddingSpec): UIPadding
	local padding = Instance.new("UIPadding")
	local all = spec.all
	padding.PaddingTop = UDim.new(0, spec.top or all or 0)
	padding.PaddingBottom = UDim.new(0, spec.bottom or all or 0)
	padding.PaddingLeft = UDim.new(0, spec.left or all or 0)
	padding.PaddingRight = UDim.new(0, spec.right or all or 0)
	padding.Parent = parent
	return padding
end

--[[
	Vertikaler Verlauf fuer plastische Anmutung: oben heller, unten dunkler.
	`strength` ist der Helligkeitsversatz an beiden Enden (0.06 = +-6 %).
]]
function Theme.gradient(parent: Instance, base: Color3, strength: number, rotation: number?): UIGradient
	local gradient = Instance.new("UIGradient")
	local white = Color3.new(1, 1, 1)
	local black = Color3.new(0, 0, 0)
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, base:Lerp(white, strength)),
		ColorSequenceKeypoint.new(1, base:Lerp(black, strength)),
	})
	gradient.Rotation = rotation or 90
	gradient.Parent = parent
	return gradient
end

--[[
	Schattenschicht hinter einer Flaeche.
	Mit Asset-Id: 9-Slice-ImageLabel. Ohne: assetfreie Ersatzflaeche.
]]
function Theme.shadow(parent: GuiObject, radius: number): GuiObject
	local spread = Theme.Elevation.spread
	local offset = Theme.Elevation.offset

	if Theme.Asset.SHADOW_9SLICE ~= "" then
		local image = Instance.new("ImageLabel")
		image.Name = "Shadow"
		image.BackgroundTransparency = Theme.Alpha.hidden
		image.Image = Theme.Asset.SHADOW_9SLICE
		image.ImageColor3 = C.bg0
		image.ImageTransparency = Theme.Elevation.transparency
		image.ScaleType = Enum.ScaleType.Slice
		image.SliceCenter = Theme.Asset.SLICE_CENTER
		image.Size = UDim2.new(1, spread * 2, 1, spread * 2)
		image.Position = UDim2.new(0, -spread, 0, -spread + offset)
		image.ZIndex = parent.ZIndex + Theme.Depth.behind
		image.Parent = parent
		return image
	end

	local fallback = Instance.new("Frame")
	fallback.Name = "Shadow"
	fallback.BackgroundColor3 = C.bg0
	fallback.BackgroundTransparency = Theme.Elevation.transparency
	fallback.BorderSizePixel = 0
	fallback.Size = UDim2.new(1, Theme.Space.x4, 1, Theme.Space.x4)
	fallback.Position = UDim2.new(0, -Theme.Space.x2, 0, -Theme.Space.x2 + offset)
	fallback.ZIndex = parent.ZIndex + Theme.Depth.behind
	fallback.Parent = parent
	Theme.corner(fallback, radius + Theme.Space.x2)
	return fallback
end

export type CardProps = {
	name: string?,
	parent: Instance?,
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	fill: Color3?,
	radius: number?,
	zIndex: number?,
	shadow: boolean?,
	gradient: boolean?,
	strokeColor: Color3?,
	padding: number?,
	visible: boolean?,
}

--[[
	Die Karte: Schatten, Flaeche, Radius, Rand, optionaler Verlauf.
	Alles, was im Spiel wie eine Flaeche aussieht, kommt hier durch – es
	gibt keine zweite Stelle, die diese vier Schichten zusammenbaut.
]]
function Theme.Card(props: CardProps): Frame
	local fill = props.fill or C.bg2
	local radius = props.radius or Theme.Radius.card
	local zIndex = props.zIndex or Theme.Layer.hud

	local card = Instance.new("Frame")
	card.Name = props.name or "Card"
	card.Size = props.size or UDim2.fromScale(1, 1)
	card.Position = props.position or UDim2.fromScale(0, 0)
	card.AnchorPoint = props.anchor or Vector2.zero
	card.BackgroundColor3 = fill
	card.BackgroundTransparency = Theme.Alpha.opaque
	card.BorderSizePixel = 0
	card.ZIndex = zIndex
	card.Visible = if props.visible == nil then true else props.visible
	card.Parent = props.parent

	if props.shadow ~= false then
		Theme.shadow(card, radius)
	end
	Theme.corner(card, radius)
	-- Rand: eine Stufe heller als die Flaeche, damit die Kante liest.
	Theme.stroke(card, props.strokeColor or C.bg3, Theme.Stroke.hair)
	if props.gradient ~= false then
		Theme.gradient(card, fill, Theme.Elevation.transparency / Theme.Space.x8)
	end
	if props.padding ~= nil then
		Theme.padding(card, { all = props.padding })
	end
	return card
end

-- Trennlinie zwischen Gruppen.
function Theme.divider(parent: Instance, order: number): Frame
	local line = Instance.new("Frame")
	line.Name = "Divider"
	line.Size = UDim2.new(1, 0, 0, Theme.Size.dividerHeight)
	line.BackgroundColor3 = C.bg3
	line.BackgroundTransparency = Theme.Alpha.divider
	line.BorderSizePixel = 0
	line.LayoutOrder = order
	line.ZIndex = Theme.Depth.base
	line.Parent = parent
	return line
end

export type LabelProps = {
	name: string?,
	parent: Instance?,
	text: string?,
	role: FontRole?,
	size: number?,
	color: Color3?,
	layoutSize: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	xAlign: Enum.TextXAlignment?,
	yAlign: Enum.TextYAlignment?,
	wrapped: boolean?,
	zIndex: number?,
	stroke: boolean?,
	lineHeight: number?,
	autoSize: Enum.AutomaticSize?,
	layoutOrder: number?,
}

function Theme.label(props: LabelProps): TextLabel
	local role: FontRole = props.role or "body"
	local label = Instance.new("TextLabel")
	label.Name = props.name or "Label"
	label.Size = props.layoutSize or UDim2.fromScale(1, 1)
	label.Position = props.position or UDim2.fromScale(0, 0)
	label.AnchorPoint = props.anchor or Vector2.zero
	label.BackgroundTransparency = Theme.Alpha.hidden
	label.Text = props.text or ""
	label.Font = (Theme.Font :: { [string]: Enum.Font })[role]
	label.TextSize = props.size or Theme.TextSize.md
	label.TextColor3 = props.color or C.textHigh
	label.TextXAlignment = props.xAlign or Enum.TextXAlignment.Left
	label.TextYAlignment = props.yAlign or Enum.TextYAlignment.Center
	label.TextWrapped = props.wrapped == true
	label.LineHeight = props.lineHeight or Theme.LineHeight.normal
	label.ZIndex = props.zIndex or Theme.Depth.content
	label.AutomaticSize = props.autoSize or Enum.AutomaticSize.None
	label.LayoutOrder = props.layoutOrder or 0
	label.Parent = props.parent
	if props.stroke ~= false then
		Theme.textStroke(label)
	end
	return label
end

export type ListProps = {
	parent: Instance,
	gap: number,
	direction: Enum.FillDirection?,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?,
	wraps: boolean?,
}

function Theme.list(props: ListProps): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, props.gap)
	layout.FillDirection = props.direction or Enum.FillDirection.Vertical
	layout.HorizontalAlignment = props.hAlign or Enum.HorizontalAlignment.Left
	layout.VerticalAlignment = props.vAlign or Enum.VerticalAlignment.Top
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Wraps = props.wraps == true
	layout.Parent = props.parent
	return layout
end

return Theme
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX12">
				<Properties>
					<string name="Name">Trove</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Trove – Aufraeumtabelle gegen Memory Leaks.

	Jede Verbindung, jede Instanz und jeder Timer, den ein Dienst anlegt,
	wandert in einen Trove. Beim Spielerabgang oder Plot-Reset wird der Trove
	einmal geleert und damit garantiert ALLES freigegeben - statt in jedem
	Dienst eine eigene, unvollstaendige Aufraeumliste zu pflegen.

	Bewusst minimal gehalten: add / connect / extend / clean / destroy.
]]

export type Trove = {
	_objects: { any },
	_cleaning: boolean,

	add: <T>(self: Trove, object: T) -> T,
	connect: (self: Trove, signal: RBXScriptSignal, handler: (...any) -> ()) -> RBXScriptConnection,
	extend: (self: Trove) -> Trove,
	remove: (self: Trove, object: any) -> boolean,
	clean: (self: Trove) -> (),
	destroy: (self: Trove) -> (),
}

local Trove = {}
Trove.__index = Trove

-- Raeumt genau ein Objekt auf. Die Reihenfolge der Faelle ist bewusst:
-- Funktionen zuerst (billigster Test), dann Verbindungen, dann Instanzen.
local function cleanupOne(object: any)
	local t = typeof(object)
	if t == "function" then
		object()
	elseif t == "RBXScriptConnection" then
		object:Disconnect()
	elseif t == "Instance" then
		object:Destroy()
	elseif t == "table" then
		if typeof(object.destroy) == "function" then
			object:destroy()
		elseif typeof(object.Destroy) == "function" then
			object:Destroy()
		end
	end
end

function Trove.new(): Trove
	return (setmetatable({ _objects = {}, _cleaning = false }, Trove) :: any) :: Trove
end

-- Nimmt ein Objekt auf und gibt es unveraendert zurueck, damit sich
-- `local c = trove:add(part.Touched:Connect(fn))` in einer Zeile schreibt.
function Trove.add<T>(self: Trove, object: T): T
	table.insert(self._objects, object)
	return object
end

function Trove.connect(self: Trove, signal: RBXScriptSignal, handler: (...any) -> ()): RBXScriptConnection
	local conn = signal:Connect(handler)
	table.insert(self._objects, conn)
	return conn
end

-- Ein Unter-Trove, der mitgeleert wird. Praktisch fuer "alles zu diesem
-- einen Plot", das innerhalb eines laengerlebigen Troves liegt.
function Trove.extend(self: Trove): Trove
	local sub = Trove.new()
	table.insert(self._objects, sub)
	return sub
end

function Trove.remove(self: Trove, object: any): boolean
	local index = table.find(self._objects, object)
	if index == nil then
		return false
	end
	table.remove(self._objects, index)
	cleanupOne(object)
	return true
end

function Trove.clean(self: Trove)
	if self._cleaning then
		-- Schutz gegen Rekursion: ein aufgeraeumtes Objekt darf beim
		-- Aufraeumen nicht denselben Trove nochmal leeren.
		return
	end
	self._cleaning = true
	-- Rueckwaerts: zuletzt angelegte Objekte zuerst freigeben.
	for i = #self._objects, 1, -1 do
		local object = self._objects[i]
		self._objects[i] = nil
		-- Der Wrapper mit explizitem Rueckgabetyp ist noetig, damit pcall
		-- laut Typechecker zwei Werte liefert (cleanupOne gibt nichts zurueck).
		local ok, err = pcall(function(): string?
			cleanupOne(object)
			return nil
		end)
		if not ok then
			warn("[Trove] Aufraeumen fehlgeschlagen: " .. tostring(err))
		end
	end
	self._cleaning = false
end

function Trove.destroy(self: Trove)
	self:clean()
end

return Trove
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX13">
				<Properties>
					<string name="Name">Types</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Types – zentrale Typdefinitionen.

	Dieses Modul enthaelt absichtlich KEINE Laufzeitlogik. Es exportiert nur
	Typen, damit Server, Client und Config gegen dieselben Vertraege arbeiten
	und der Luau-Typechecker Fehler an der Grenze zwischen den Schichten
	findet, statt erst zur Laufzeit.
]]

export type UpgradeKind = "dropper" | "upgrader" | "collector" | "rate" | "speed" | "cosmetic"

-- Effekt eines Upgrades. Ein Union waere praeziser, ist aber in Luau ohne
-- Tagged-Union-Narrowing bei Tabellen-Literalen unhandlich; stattdessen ein
-- Record mit optionalen Feldern plus `kind` als Diskriminator.
export type UpgradeEffect = {
	kind: UpgradeKind,
	value: number?,     -- dropper: Wert eines erzeugten Erzes
	interval: number?,  -- dropper: Sekunden zwischen zwei Drops
	mult: number?,      -- upgrader / collector: Multiplikator
	factor: number?,    -- rate: Beschleunigung aller Dropper
	speed: number?,     -- speed: neue Bandgeschwindigkeit in studs/s
}

export type UpgradeDef = {
	id: string,
	rank: number,
	price: number,
	requires: { string },  -- Abhaengigkeiten; Button erscheint erst, wenn alle gekauft
	label: string,
	desc: string,
	effect: UpgradeEffect,
}

export type DropperDef = {
	value: number,
	interval: number,
}

-- Was dauerhaft pro Spieler gespeichert wird.
export type ProfileData = {
	version: number,
	cash: number,
	gems: number,
	rebirths: number,
	totalEarned: number,
	purchased: { [string]: boolean },   -- gekaufte Upgrade-Ids
	redeemedCodes: { [string]: boolean },
	receipts: { [string]: boolean },    -- Idempotenz fuer Developer-Products
	quests: { [string]: number },       -- Fortschrittszaehler
	claimedQuests: { [string]: boolean },
	dailyLastClaim: number,             -- os.time() der letzten Abholung
	dailyStreak: number,
	settings: { [string]: boolean },
	playtime: number,                   -- Sekunden Gesamtspielzeit
}

export type Profile = {
	data: ProfileData,
	userId: number,
	key: string,
	loaded: boolean,
	releasing: boolean,
	lockAcquired: boolean,
	lastSave: number,
	dirty: boolean,
}

-- Zustand, den der Server an den Client repliziert.
export type ClientState = {
	cash: number,
	gems: number,
	rebirths: number,
	totalEarned: number,
	incomePerSecond: number,
	purchased: { [string]: boolean },
	available: { [string]: boolean },   -- Abhaengigkeiten erfuellt, noch nicht gekauft
	plotIndex: number?,
	rebirthCost: number,
	rebirthMultiplier: number,
	nextRebirthMultiplier: number,
	dailyReady: boolean,
	dailyStreak: number,
	quests: { [string]: number },
	claimedQuests: { [string]: boolean },
	owns2xCash: boolean,
	ownsVip: boolean,
}

export type QuestDef = {
	id: string,
	label: string,
	metric: string,   -- welcher Zaehler in ProfileData.quests
	target: number,
	rewardGems: number,
}

export type CodeDef = {
	cash: number?,
	gems: number?,
}

export type GemProductDef = {
	id: string,
	productId: number,
	gems: number,
	label: string,
}

-- Lifecycle, den jeder Serverdienst implementiert. Init verdrahtet nur
-- Referenzen (darf nicht yielden), Start darf yielden und Arbeit aufnehmen.
export type Service = {
	name: string,
	Init: ((Registry) -> ())?,
	Start: (() -> ())?,
	priority: number?,
}

export type Registry = { [string]: any }

return {}
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX30">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Folder" referent="RBX29">
			<Properties>
				<string name="Name">Server</string>
			</Properties>
			<Item class="Script" referent="RBX16">
				<Properties>
					<string name="Name">Bootstrap</string>
					<bool name="Disabled">false</bool>
					<token name="RunContext">0</token>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Bootstrap – Einstiegspunkt des Servers.

	Zwei-Phasen-Lifecycle, weil die Reihenfolge sonst nicht beherrschbar ist:

	  Init()  – darf NICHT yielden. Hier werden nur Instanzen angelegt und
	            Referenzen verdrahtet. Nach Abschluss aller Init-Aufrufe
	            steht die Welt, und jeder Dienst darf davon ausgehen, dass
	            die anderen existieren.
	  Start() – darf yielden. Hier werden Ereignisse verbunden, Threads
	            gestartet und Webaufrufe gemacht.

	Wuerde man beides mischen, haette z. B. EconomyService.Start die Plots
	noch nicht, weil PlotService.Init erst spaeter liefe. Die Liste unten
	ist deshalb bewusst von Hand sortiert und nicht alphabetisch.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Log = require(Shared.Log)
local Remotes = require(Shared.Remotes)

-- Remotes muessen existieren, bevor irgendein Dienst sie bindet oder ein
-- Client sie sucht.
Remotes.initServer()

local Server = script.Parent

type LifecycleModule = {
	name: string,
	Init: (() -> ())?,
	Start: (() -> ())?,
}

-- Reihenfolge = Abhaengigkeitsreihenfolge.
-- Die Annotation ist noetig, damit Luau den Elementtyp nicht vom ERSTEN
-- Eintrag ableitet; jeder Dienst erfuellt LifecycleModule per Breiten-
-- Subtyping (zusaetzliche Felder wie TickScheduler.every stoeren nicht).
local services: { LifecycleModule } = {
	require(Server.TickScheduler),
	require(Server.DataService),
	require(Server.WorldService),
	require(Server.PlotService),
	require(Server.MonetizationService),
	require(Server.ProgressionService),
	require(Server.EconomyService),
	require(Server.RebirthService),
	require(Server.LeaderboardService),
	require(Server.StateService),
}

local function phase(label: string, key: "Init" | "Start")
	for _, module in ipairs(services) do
		-- Bewusst kein dynamischer Index ueber einen String: eine
		-- Fallunterscheidung bleibt typsicher, module[key] waere ein
		-- any-Zugriff.
		local fn: (() -> ())? = if key == "Init" then module.Init else module.Start
		if fn == nil then
			continue
		end
		local startedAt = os.clock()
		-- pcall pro Dienst: ein kaputter Dienst darf nicht das ganze Spiel
		-- verhindern. Der Rest laeuft weiter und der Fehler steht genau
		-- einmal im Output statt als Kaskade.
		local ok, err = pcall(function(): string?
			fn()
			return nil
		end)
		local ms = (os.clock() - startedAt) * 1000
		if ok then
			Log.debug("Bootstrap", `{label} {module.name} in {string.format("%.1f", ms)} ms`)
		else
			Log.error("Bootstrap", `{label} {module.name} FEHLGESCHLAGEN: {tostring(err)}`)
		end
	end
end

local bootStart = os.clock()
phase("Init", "Init")
phase("Start", "Start")
Log.info("Bootstrap",
	`Server bereit in {string.format("%.0f", (os.clock() - bootStart) * 1000)} ms ` ..
	`({#services} Dienste)`)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX17">
				<Properties>
					<string name="Name">DataService</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	DataService – Profilspeicherung nach dem ProfileStore-Muster,
	hier eigenstaendig implementiert (keine externe Abhaengigkeit).

	Das Problem, das dieses Modul loest: naives :SetAsync() verliert Daten.
	Konkret in vier Faellen, die im Livebetrieb alle vorkommen:

	  1. Zwei Server halten dasselbe Profil (Teleport, schneller Rejoin,
	     Serverwechsel). Der langsamere ueberschreibt am Ende den neueren
	     Fortschritt.  -> geloest durch SESSION-LOCKING via UpdateAsync.
	  2. Der DataStore ist kurz nicht erreichbar. Ein einzelner Versuch
	     schlaegt fehl und der Fortschritt ist weg.
	     -> geloest durch RETRY MIT EXPONENTIELLEM BACKOFF.
	  3. Der Server stirbt (Shutdown, Crash). Nicht gespeicherte Minuten
	     sind verloren.  -> geloest durch AUTOSAVE + BindToClose-Flush.
	  4. Ein neues Feld kommt dazu und alte Profile haben es nicht.
	     -> geloest durch RECONCILE gegen das Template.

	Ein abgestuerzter Server kann seinen Lock nicht freigeben. Deshalb gilt
	ein Lock nach LOCK_STALE Sekunden als tot und darf uebernommen werden -
	sonst waere der Spieler dauerhaft ausgesperrt.

	Ohne API-Zugriff (Studio ohne "Studio Access to API Services") schlaegt
	jeder DataStore-Aufruf fehl. Dann laeuft das Spiel mit einem frischen
	Profil im Modus canSave = false weiter, und es wird GENAU EINMAL
	gewarnt statt im Sekundentakt.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Log = require(Shared.Log)
local Types = require(Shared.Types)

type ProfileData = Types.ProfileData

-- Struktur im DataStore. `lock` und `data` liegen bewusst getrennt, damit
-- das Uebernehmen eines toten Locks die Nutzdaten nicht anfasst.
type StoredRecord = {
	lock: { jobId: string, t: number }?,
	data: ProfileData?,
}

type Profile = {
	userId: number,
	key: string,
	data: ProfileData,
	canSave: boolean,     -- false = Lock nie bekommen, wir schreiben NICHTS
	releasing: boolean,
	dirty: boolean,       -- Zustand hat sich seit dem letzten Push geaendert
	lastSave: number,
}

local LOCK_STALE = 90          -- Sekunden, nach denen ein Lock als tot gilt
local LOCK_ATTEMPTS = 5        -- Versuche, den Lock zu bekommen
local SAVE_ATTEMPTS = 4        -- Versuche pro Speichervorgang
local AUTOSAVE_SECONDS = 60
local BACKOFF_BASE = 1.5       -- Sekunden; waechst exponentiell

local DataService = {}
DataService.name = "DataService"

local store: DataStore? = nil
local profiles: { [Player]: Profile } = {}
local apiWarned = false

-- ==========================================================================
-- Template und Reconcile
-- ==========================================================================

local function template(): ProfileData
	return {
		version = 1,
		cash = Config.ECONOMY.START_CASH,
		gems = Config.ECONOMY.START_GEMS,
		rebirths = 0,
		totalEarned = 0,
		purchased = {},
		redeemedCodes = {},
		receipts = {},
		quests = { earned = 0, purchases = 0, rebirths = 0, playtime = 0 },
		claimedQuests = {},
		dailyLastClaim = 0,
		dailyStreak = 0,
		settings = { music = true, sfx = true },
		playtime = 0,
	}
end

--[[
	Fuellt fehlende Felder aus dem Template nach. Bewusst NICHT rekursiv
	ueber beliebige Tiefe: die Profilstruktur ist flach plus Maps, und ein
	generisches Deep-Merge wuerde Spielerdaten in `purchased` ueberschreiben,
	wenn das Template dort je einen Eintrag bekaeme.
]]
local function reconcile(data: any): ProfileData
	local base = template()
	if typeof(data) ~= "table" then
		return base
	end
	for key, defaultValue in pairs(base :: { [string]: any }) do
		local given = (data :: { [string]: any })[key]
		if typeof(given) ~= typeof(defaultValue) then
			(data :: { [string]: any })[key] = defaultValue
		elseif typeof(defaultValue) == "table" then
			-- Untertabellen: nur fehlende Schluessel ergaenzen, vorhandene
			-- Spielerdaten unangetastet lassen.
			for subKey, subDefault in pairs(defaultValue :: { [string]: any }) do
				if (given :: { [string]: any })[subKey] == nil then
					(given :: { [string]: any })[subKey] = subDefault
				end
			end
		end
	end
	return data :: ProfileData
end

-- ==========================================================================
-- DataStore-Zugriff mit Backoff
-- ==========================================================================

local function jobIdentity(): string
	-- In Studio ist JobId leer. Ein stabiler Ersatzwert verhindert, dass
	-- zwei Studio-Sitzungen sich gegenseitig fuer denselben Server halten.
	return if game.JobId ~= "" then game.JobId else "studio-" .. tostring(RunService:IsStudio())
end

--[[
	Fuehrt eine DataStore-Operation mit exponentiellem Backoff aus.
	Gibt (erfolg, ergebnis) zurueck. Jeder einzelne Aufruf steckt in pcall -
	DataStore-Fehler duerfen nie bis in die Spiellogik durchschlagen.
]]
local function withRetry<T>(label: string, attempts: number, operation: () -> T): (boolean, T?)
	for attempt = 1, attempts do
		local ok, result = pcall(operation)
		if ok then
			return true, result
		end
		if not apiWarned then
			apiWarned = true
			Log.warn("DataService",
				`DataStore nicht erreichbar ({label}): {tostring(result)}. ` ..
				`In Studio: "Studio Access to API Services" aktivieren. ` ..
				`Das Spiel laeuft weiter, speichert aber nicht.`)
		else
			Log.throttled("ds_" .. label, 30, 2, "DataService",
				`{label} fehlgeschlagen (Versuch {attempt}/{attempts})`)
		end
		if attempt < attempts then
			-- Exponentiell plus Jitter: ohne Jitter laufen bei einem
			-- DataStore-Ausfall alle Server synchron in denselben Retry.
			task.wait(BACKOFF_BASE * (2 ^ (attempt - 1)) + math.random() * 0.5)
		end
	end
	return false, nil
end

-- ==========================================================================
-- Lock holen / halten / freigeben
-- ==========================================================================

--[[
	Versucht, den Session-Lock zu uebernehmen und die Daten zu laden.
	Rueckgabe: (gelungen, daten).

	Die Transaktion laeuft in UpdateAsync, weil nur dort Lesen und Schreiben
	atomar sind. Gibt der Transformer nil zurueck, bricht Roblox den Schreib-
	vorgang ab - genau das nutzen wir als "fremder Lock ist noch frisch".
]]
local function acquire(userId: number, key: string): (boolean, ProfileData?)
	local activeStore = store
	if activeStore == nil then
		return false, nil
	end
	local me = jobIdentity()

	for attempt = 1, LOCK_ATTEMPTS do
		local blocked = false
		local ok, result = withRetry(`lock:{userId}`, 2, function(): StoredRecord?
			return activeStore:UpdateAsync(key, function(old: any): StoredRecord?
				local record: StoredRecord = if typeof(old) == "table"
					then old :: StoredRecord
					else { lock = nil, data = nil }

				local lock = record.lock
				if lock ~= nil and lock.jobId ~= me then
					local age = os.time() - lock.t
					if age < LOCK_STALE then
						blocked = true
						return nil   -- Schreibvorgang abbrechen
					end
					-- Lock ist aelter als LOCK_STALE: der haltende Server
					-- ist mit hoher Wahrscheinlichkeit tot. Uebernehmen.
				end
				record.lock = { jobId = me, t = os.time() }
				return record
			end)
		end)

		if ok and result ~= nil then
			return true, reconcile(result.data)
		end
		if not blocked then
			-- Kein fremder Lock, sondern ein echter Fehler: aufgeben,
			-- withRetry hat bereits eigene Versuche verbraucht.
			return false, nil
		end
		Log.info("DataService",
			`Profil {userId} noch von einer anderen Sitzung gehalten ` ..
			`(Versuch {attempt}/{LOCK_ATTEMPTS})`)
		task.wait(BACKOFF_BASE * attempt)
	end
	return false, nil
end

--[[
	Schreibt die Daten und aktualisiert oder loest den Lock.
	`release = true` gibt den Lock frei (beim Verlassen / Shutdown).
]]
local function commit(profile: Profile, release: boolean): boolean
	local activeStore = store
	if activeStore == nil or not profile.canSave then
		return false
	end
	local me = jobIdentity()
	local data = profile.data

	local ok = withRetry(`save:{profile.userId}`, SAVE_ATTEMPTS, function(): boolean
		activeStore:UpdateAsync(profile.key, function(old: any): StoredRecord
			local record: StoredRecord = if typeof(old) == "table"
				then old :: StoredRecord
				else { lock = nil, data = nil }
			-- Nur schreiben, wenn WIR den Lock halten. Sonst hat ein anderer
			-- Server uebernommen und wuerde hier ueberschrieben werden.
			local lock = record.lock
			if lock ~= nil and lock.jobId ~= me then
				return record
			end
			record.data = data
			record.lock = if release then nil else { jobId = me, t = os.time() }
			return record
		end)
		return true
	end)

	if ok then
		profile.lastSave = os.clock()
		Log.debug("DataService", `Profil {profile.userId} gespeichert (release={tostring(release)})`)
	end
	return ok
end

-- ==========================================================================
-- Oeffentliche API
-- ==========================================================================

function DataService.get(player: Player): ProfileData?
	local profile = profiles[player]
	return if profile ~= nil then profile.data else nil
end

-- Wartet, bis das Profil geladen ist (oder die Zeit ablaeuft). Dienste, die
-- beim Join sofort Daten brauchen, rufen das statt selbst zu pollen.
function DataService.await(player: Player, timeout: number?): ProfileData?
	local deadline = os.clock() + (timeout or 20)
	while profiles[player] == nil and os.clock() < deadline do
		if player.Parent == nil then
			return nil
		end
		task.wait(0.1)
	end
	local profile = profiles[player]
	return if profile ~= nil then profile.data else nil
end

function DataService.canSave(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.canSave
end

-- Markiert das Profil als geaendert. StateService liest dieses Flag und
-- repliziert dann; so braucht kein Dienst eine Referenz auf StateService
-- (das waere ein Abhaengigkeitszyklus).
function DataService.markDirty(player: Player)
	local profile = profiles[player]
	if profile ~= nil then
		profile.dirty = true
	end
end

function DataService.consumeDirty(player: Player): boolean
	local profile = profiles[player]
	if profile == nil or not profile.dirty then
		return false
	end
	profile.dirty = false
	return true
end

function DataService.forEach(callback: (player: Player, data: ProfileData) -> ())
	for player, profile in pairs(profiles) do
		callback(player, profile.data)
	end
end

-- ==========================================================================
-- Lifecycle
-- ==========================================================================

local function onPlayerAdded(player: Player)
	local key = "Player_" .. player.UserId
	local ok, data = acquire(player.UserId, key)

	-- Der Spieler kann waehrend des Ladens schon wieder weg sein.
	if player.Parent == nil then
		return
	end

	if not ok or data == nil then
		Log.warn("DataService",
			`Profil fuer {player.Name} nicht gesperrt/geladen - Sitzung laeuft OHNE Speichern.`)
		data = template()
	end

	profiles[player] = {
		userId = player.UserId,
		key = key,
		data = data :: ProfileData,
		canSave = ok,
		releasing = false,
		dirty = true,
		lastSave = os.clock(),
	}
	Log.info("DataService", `Profil geladen: {player.Name} (speichern={tostring(ok)})`)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile == nil then
		return
	end
	profile.releasing = true
	commit(profile, true)
	profiles[player] = nil
end

function DataService.Init()
	local ok, result = pcall(function(): DataStore
		return DataStoreService:GetDataStore(Config.DATA_STORE_NAME)
	end)
	store = if ok then result else nil
	if not ok then
		Log.warn("DataService", "GetDataStore fehlgeschlagen - Spiel laeuft ohne Speichern.")
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(function(player: Player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	-- Spieler, die vor dem Start schon drin waren (Studio-Reload).
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	-- Autosave. Laeuft in einem eigenen Thread statt im TickScheduler,
	-- weil UpdateAsync yieldet und der Scheduler nicht blockieren darf.
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player, profile in pairs(profiles) do
				if not profile.releasing and player.Parent ~= nil then
					task.spawn(commit, profile, false)
				end
			end
		end
	end)

	--[[
		BindToClose: beim Herunterfahren bleiben ~30 s. Alle Profile werden
		parallel geschrieben und der Lock freigegeben, damit ein Spieler auf
		dem neuen Server sofort wieder rein kann statt LOCK_STALE zu warten.
	]]
	game:BindToClose(function()
		Log.info("DataService", "Shutdown - schreibe alle Profile")
		local pending = 0
		for _, profile in pairs(profiles) do
			if profile.canSave then
				pending += 1
				task.spawn(function()
					commit(profile, true)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
		Log.info("DataService", "Shutdown abgeschlossen")
	end)
end

return DataService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX18">
				<Properties>
					<string name="Name">EconomyService</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	EconomyService – die eigentliche Tycoon-Schleife.

	Dropper -> Foerderband -> Veredler -> Sammler -> Geld.

	Performance-Entscheidungen, die hier bewusst getroffen wurden:

	* Das Band bewegt die Erze ueber AssemblyLinearVelocity eines
	  VERANKERTEN Teils. Die Physik-Engine erledigt das in C++; es laeuft
	  kein einziger Luau-Frame dafuer. Der veraltete Weg (BasePart.Velocity
	  oder ein BodyVelocity pro Erz) wuerde pro Erz ein Constraint kosten.
	* Es gibt genau zwei periodische Aufgaben im ganzen Modul (Drop und
	  Sweep), beide im zentralen TickScheduler. Kein Heartbeat pro Dropper,
	  kein task.spawn pro Erz, kein while-Loop pro Plot.
	* Multiplikatoren werden gecacht und nur bei Kauf/Rebirth/Gamepass
	  verworfen. Sonst laege bei 6 Plots x 10 Hz eine Neuberechnung ueber
	  25 Upgrades pro Tick an.
	* Harte Obergrenze an Erzen pro Plot plus Verfallszeit. Ohne beides
	  fuellt ein Spieler, der den Sammler blockiert, den Server mit Teilen.
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Log = require(Shared.Log)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)
local PlotBuilder = require(script.Parent.PlotBuilder)
local PlotService = require(script.Parent.PlotService)
local ProgressionService = require(script.Parent.ProgressionService)
local TickScheduler = require(script.Parent.TickScheduler)

local ORE_GROUP = "Ores"
local CHARACTER_GROUP = "Characters"

type Multipliers = {
	dropRate: number,      -- Faktor auf die Drop-Frequenz
	collector: number,     -- Faktor auf die Auszahlung
	conveyorSpeed: number,
	incomePerSecond: number,
}

local EconomyService = {}
EconomyService.name = "EconomyService"

local multCache: { [Player]: Multipliers } = {}
-- Akkumulierte Zeit pro Plot und Dropper, damit Drops unabhaengig von der
-- Tickfrequenz exakt im konfigurierten Takt fallen.
local dropAccum: { [number]: { [string]: number } } = {}
-- Kurze Sperre pro Spieler nach einer fehlgeschlagenen Pad-Beruehrung,
-- damit ein Spieler, der auf einem Pad steht, nicht 60 Meldungen pro
-- Sekunde bekommt.
local padCooldown: { [Player]: number } = {}
-- Haltefortschritt je Plot und Knopf, in Sekunden.
local holdProgress: { [number]: { [string]: number } } = {}

-- ==========================================================================
-- Multiplikatoren
-- ==========================================================================

local function dropperDefs(purchased: { [string]: boolean }): { [string]: Types.DropperDef }
	local out: { [string]: Types.DropperDef } = {
		__base = Config.ECONOMY.START_DROPPER,
	}
	for id, bought in pairs(purchased) do
		if not bought then
			continue
		end
		local def = Config.UPGRADES_BY_ID[id]
		if def ~= nil and def.effect.kind == "dropper" then
			out[id] = {
				value = def.effect.value or 0,
				interval = def.effect.interval or 1,
			}
		end
	end
	return out
end

local function computeMultipliers(player: Player): Multipliers
	local data = DataService.get(player)
	local blank: Multipliers = {
		dropRate = 1, collector = 1,
		conveyorSpeed = Config.ECONOMY.CONVEYOR_BASE_SPEED,
		incomePerSecond = 0,
	}
	if data == nil then
		return blank
	end

	local dropRate = 1
	local collector = 1
	local upgraderMult = 1
	local speed = Config.ECONOMY.CONVEYOR_BASE_SPEED

	for id, bought in pairs(data.purchased) do
		if not bought then
			continue
		end
		local def = Config.UPGRADES_BY_ID[id]
		if def == nil then
			continue
		end
		local effect = def.effect
		if effect.kind == "rate" then
			dropRate *= effect.factor or 1
		elseif effect.kind == "collector" then
			collector *= effect.mult or 1
		elseif effect.kind == "upgrader" then
			upgraderMult *= effect.mult or 1
		elseif effect.kind == "speed" then
			speed = math.max(speed, effect.speed or speed)
		end
	end

	-- Anzeige-Einkommen: was pro Sekunde beim Sammler ankaeme, wenn kein
	-- Erz verloren geht. Dieselbe Formel wie im Balancing-Simulator.
	local raw = 0
	for _, dropper in pairs(dropperDefs(data.purchased)) do
		raw += dropper.value / (dropper.interval / dropRate)
	end
	local global = Config.rebirthMultiplier(data.rebirths) * MonetizationService.cashMultiplier(player)

	return {
		dropRate = dropRate,
		collector = collector,
		conveyorSpeed = speed,
		incomePerSecond = raw * upgraderMult * collector * global,
	}
end

local function multipliers(player: Player): Multipliers
	local cached = multCache[player]
	if cached ~= nil then
		return cached
	end
	local fresh = computeMultipliers(player)
	multCache[player] = fresh
	return fresh
end

-- Muss nach jedem Kauf, Rebirth und Gamepass-Kauf aufgerufen werden.
function EconomyService.invalidate(player: Player)
	multCache[player] = nil
	local state = PlotService.forPlayer(player)
	if state ~= nil then
		PlotService.applyConveyorSpeed(state, multipliers(player).conveyorSpeed)
	end
end

function EconomyService.incomePerSecond(player: Player): number
	return multipliers(player).incomePerSecond
end

-- ==========================================================================
-- Geld gutschreiben
-- ==========================================================================

local function award(player: Player, amount: number)
	local data = DataService.get(player)
	if data == nil or amount <= 0 then
		return
	end
	data.cash += amount
	data.totalEarned += amount
	DataService.markDirty(player)
	ProgressionService.addMetric(player, "earned", amount)
end

-- ==========================================================================
-- Erze
-- ==========================================================================

local function spawnOre(state: PlotService.PlotState, id: string, dropper: Types.DropperDef)
	if state.oreCount >= Config.ECONOMY.MAX_ORES_PER_PLOT then
		return
	end
	-- Explizit optional: der Map-Index liefert laut Typ ein CFrame, aber
	-- eine unbekannte Dropper-Id gibt zur Laufzeit nil.
	local spawnCFrame: CFrame? = state.refs.dropSpawns[id]
	if spawnCFrame == nil then
		return
	end

	local ore = Instance.new("Part")
	ore.Name = "Ore"
	ore.Size = Config.ECONOMY.ORE_SIZE
	ore.CFrame = spawnCFrame :: CFrame
	ore.Material = Theme.Material.neon
	ore.Color = Theme.Color.primary
	ore.Anchored = false
	ore.CanCollide = true
	ore.CastShadow = false
	ore.CollisionGroup = ORE_GROUP
	-- Leicht und traege genug, damit das Band sie sauber mitnimmt, ohne
	-- dass sie beim Aufprall wegspringen.
	ore.CustomPhysicalProperties = PhysicalProperties.new(0.6, 0.3, 0, 1, 1)
	ore:SetAttribute("OreValue", dropper.value)
	--[[
		Trail nur fuer die beiden wertvollsten Bohrer.
		Ein Trail kostet drei Instanzen (zwei Attachments plus Trail). Bei
		45 Erzen mal sechs Plots waeren das ueber 800 zusaetzliche
		Instanzen fuer einen Effekt, den man bei Dauerfeuer ohnehin kaum
		sieht. Bei den teuersten Erzen ist er selten und faellt auf.
	]]
	if id == "dropper_6" or id == "dropper_7" then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0, -Config.ECONOMY.ORE_SIZE.Z / 2)
		a0.Parent = ore
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, 0, Config.ECONOMY.ORE_SIZE.Z / 2)
		a1.Parent = ore
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = Theme.Duration.base
		trail.LightEmission = 1
		trail.Color = ColorSequence.new(Theme.Color.premium)
		trail.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, Theme.Alpha.veil),
			NumberSequenceKeypoint.new(1, 1),
		})
		trail.Parent = ore
	end
	ore:SetAttribute("ExpireAt", os.clock() + Config.ECONOMY.ORE_LIFETIME)
	ore.Parent = state.refs.ores
	state.oreCount += 1
end

local function onDropTick(_dt: number)
	for _, state in ipairs(PlotService.all()) do
		local owner = state.owner
		if owner == nil then
			continue
		end
		local data = DataService.get(owner)
		if data == nil then
			continue
		end

		local accum = dropAccum[state.index]
		if accum == nil then
			accum = {}
			dropAccum[state.index] = accum
		end

		local rate = multipliers(owner).dropRate
		local period = 1 / Config.ECONOMY.DROP_TICK_HZ
		for id, dropper in pairs(dropperDefs(data.purchased)) do
			local elapsed = (accum[id] or 0) + period * rate
			local interval = dropper.interval
			if elapsed >= interval then
				-- Rest behalten statt auf 0 setzen: sonst verliert ein
				-- schneller Dropper bei jedem Tick Bruchteile eines Drops.
				elapsed -= interval
				spawnOre(state, id, dropper)
			end
			accum[id] = elapsed
		end
	end
end

--[[
	Aufraeumen. Laeuft mit 2 Hz und macht drei Dinge:
	  * abgelaufene Erze entfernen (ein Erz, das irgendwo klemmt, wuerde
	    sonst bis zum Serverende Physik kosten)
	  * heruntergefallene Erze entfernen
	  * den Zaehler mit der Wirklichkeit abgleichen, statt ihn nur
	    hochzuzaehlen (Zaehler driften sonst unweigerlich auseinander)
]]
local function onSweepTick(_dt: number)
	local now = os.clock()
	local killY = Config.ECONOMY.ORE_FALL_KILL_Y
	for _, state in ipairs(PlotService.all()) do
		local children = state.refs.ores:GetChildren()
		local alive = 0
		for _, child in ipairs(children) do
			if not child:IsA("BasePart") then
				continue
			end
			local expireAt = child:GetAttribute("ExpireAt")
			local expired = typeof(expireAt) == "number" and now >= expireAt
			if expired or child.Position.Y < killY then
				child:Destroy()
			else
				alive += 1
			end
		end
		state.oreCount = alive
	end
end

-- ==========================================================================
-- Kauf
-- ==========================================================================

--[[
	Die einzige Stelle im Projekt, an der ein Upgrade gekauft werden kann -
	egal ob per Pad-Beruehrung oder per Shop-Knopf. Jede Pruefung steht hier
	und ist einzeln begruendet.
]]
function EconomyService.purchase(player: Player, upgradeId: string): (boolean, string)
	-- (1) Kennen wir das Upgrade ueberhaupt? Der Client schickt eine Id;
	--     ein Exploiter schickt "gib_mir_alles".
	local def = Config.UPGRADES_BY_ID[upgradeId]
	if def == nil then
		return false, "Unbekanntes Upgrade."
	end

	-- (2) Profil geladen? Sonst wuerde ein Kauf in einem Zustand landen,
	--     der gleich vom Laden ueberschrieben wird.
	local data = DataService.get(player)
	if data == nil then
		return false, "Profil noch nicht geladen."
	end

	-- (3) Besitzt der Spieler ueberhaupt einen Plot? Ohne Plot gibt es
	--     nichts zu bebauen.
	local state = PlotService.forPlayer(player)
	if state == nil then
		return false, "Du hast noch keine Fabrik."
	end

	-- (4) Schon gekauft? Verhindert Doppelabbuchung bei mehrfachem
	--     Touched-Event auf demselben Pad.
	if data.purchased[upgradeId] then
		return false, "Schon gekauft."
	end

	-- (5) Abhaengigkeiten erfuellt? Ohne diese Pruefung koennte der Client
	--     den kompletten Baum ueberspringen und direkt das letzte Upgrade
	--     kaufen.
	if not PlotService.isAvailable(data.purchased, def) then
		return false, "Voraussetzung fehlt."
	end

	-- (6) Ist der Spieler nah genug an seiner eigenen Fabrik? Verhindert
	--     Fernkaeufe aus der Lobby per gefaelschtem Remote.
	if not PlotService.isNearOwnPlot(player) then
		return false, "Du musst bei deiner Fabrik stehen."
	end

	-- (7) Genug Geld? Der Server rechnet, nie der Client.
	if data.cash < def.price then
		return false, `Es fehlen {Format.abbreviate(def.price - data.cash)} $.`
	end

	data.cash -= def.price
	data.purchased[upgradeId] = true
	DataService.markDirty(player)

	EconomyService.invalidate(player)
	PlotService.refresh(state)
	ProgressionService.addMetric(player, "purchases", 1)

	Remotes.event("PlaySfx"):FireClient(player, "purchase")
	Log.debug("Economy", `{player.Name} kauft {upgradeId} fuer {def.price}`)
	return true, `{def.label} gekauft!`
end

-- ==========================================================================
-- Beruehrungs-Handler (einmal pro Plot, nicht pro Besitzerwechsel)
-- ==========================================================================

local function connectPlot(state: PlotService.PlotState)
	local refs = state.refs

	-- Sammler: Erz einloesen.
	refs.collector.Touched:Connect(function(hit: BasePart)
		local owner = state.owner
		if owner == nil then
			return
		end
		local value = hit:GetAttribute("OreValue")
		if typeof(value) ~= "number" then
			return
		end
		-- Attribut sofort entfernen: Touched kann im selben Frame mehrfach
		-- feuern, und ohne diese Sperre wird dasselbe Erz doppelt bezahlt.
		hit:SetAttribute("OreValue", nil)
		hit:Destroy()
		state.oreCount = math.max(0, state.oreCount - 1)

		local data = DataService.get(owner)
		if data == nil then
			return
		end
		local mult = multipliers(owner)
		local payout = value
			* mult.collector
			* Config.rebirthMultiplier(data.rebirths)
			* MonetizationService.cashMultiplier(owner)
		award(owner, payout)
		-- Kurzer Funkenstoss statt dauerhaft laufendem Emitter: die Rate
		-- bleibt so an die tatsaechlichen Einloesungen gekoppelt.
		--[[
			Bewusst KEIN Remote pro Erz: bei acht Erzen pro Sekunde und
			sechs Plots waeren das ueber 50 Netzwerknachrichten je Sekunde
			nur fuer einen Klickton. Der Client spielt den Ton stattdessen,
			wenn im regulaeren Zustands-Push das Guthaben steigt.
		]]
		refs.collectorBurst:Emit(3)
	end)

	-- Veredler: Erzwert erhoehen.
	for id, upgrader in pairs(refs.upgraders) do
		local def = Config.UPGRADES_BY_ID[id]
		local factor = def.effect.mult or 1
		local marker = "Up_" .. id
		upgrader.field.Touched:Connect(function(hit: BasePart)
			local owner = state.owner
			if owner == nil then
				return
			end
			local data = DataService.get(owner)
			if data == nil or not data.purchased[id] then
				return
			end
			local value = hit:GetAttribute("OreValue")
			if typeof(value) ~= "number" then
				return
			end
			-- Ein Erz darf jeden Veredler nur einmal passieren, sonst
			-- multipliziert ein auf dem Feld liegendes Erz endlos.
			if hit:GetAttribute(marker) ~= nil then
				return
			end
			hit:SetAttribute(marker, true)
			hit:SetAttribute("OreValue", value * factor)
			hit.Color = Theme.Color.premium
			hit.Size = hit.Size * 1.08
		end)
	end

	-- Kauf-Pads werden NICHT ueber Touched ausgeloest, sondern ueber den
	-- Haltevorgang in onHoldTick (siehe dort). Touched allein wuerde den
	-- Fortschrittsring unmoeglich machen, weil das Ereignis bei einem
	-- stillstehenden Charakter nicht erneut feuert.
end

--[[
	Halten statt Antippen.

	Wer auf einer Trittplatte steht, fuellt in HOLD_SECONDS den Ring auf
	dem schwebenden Panel; erst dann wird gekauft. Das verhindert
	Fehlkaeufe beim Durchlaufen und gibt dem Kauf ein Gewicht.

	Wer es eilig hat, kauft im Shop-Panel weiterhin mit einem Klick - der
	Serverpfad ist in beiden Faellen derselbe (EconomyService.purchase mit
	allen sieben Pruefungen).

	Die Naehe wird ueber die Position des HumanoidRootPart geprueft, nicht
	ueber Touched: das ist unabhaengig davon, ob sich der Charakter bewegt.
	Geprueft werden nur Knoepfe, die ueberhaupt kaufbar sind - das sind in
	der Praxis ein bis drei pro Plot, nicht 25.
]]
local HOLD_SECONDS = 0.45

local function resetHolds(state: PlotService.PlotState)
	local hold = holdProgress[state.index]
	if hold == nil then
		return
	end
	for id, value in pairs(hold) do
		if value > 0 then
			local button = state.refs.buttons[id]
			if button ~= nil then
				PlotService.setButtonProgress(button, 0)
			end
			hold[id] = 0
		end
	end
end

local function onHoldTick(dt: number)
	local radius = PlotBuilder.BUTTON_RADIUS / 2 + 1
	for _, state in ipairs(PlotService.all()) do
		local owner = state.owner
		if owner == nil then
			continue
		end
		local data = DataService.get(owner)
		local character = owner.Character
		local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
		if data == nil or root == nil or not root:IsA("BasePart") then
			resetHolds(state)
			continue
		end

		local hold = holdProgress[state.index]
		if hold == nil then
			hold = {}
			holdProgress[state.index] = hold
		end

		for id, button in pairs(state.refs.buttons) do
			if data.purchased[id] or not PlotService.isAvailable(data.purchased, button.def) then
				continue
			end
			local delta = root.Position - button.tread.Position
			local standing = math.abs(delta.X) <= radius
				and math.abs(delta.Z) <= radius
				and math.abs(delta.Y) <= radius

			if not standing then
				if (hold[id] or 0) > 0 then
					hold[id] = 0
					PlotService.setButtonProgress(button, 0)
				end
				continue
			end

			local elapsed = (hold[id] or 0) + dt
			if elapsed < HOLD_SECONDS then
				hold[id] = elapsed
				PlotService.setButtonProgress(button, elapsed / HOLD_SECONDS)
				continue
			end

			hold[id] = 0
			PlotService.setButtonProgress(button, 0)
			local ok, message = EconomyService.purchase(owner, id)
			Remotes.event("Notify"):FireClient(owner, message, if ok then "success" else "error")
		end
	end
end

-- ==========================================================================
-- Lifecycle
-- ==========================================================================

function EconomyService.Init()
	--[[
		Kollisionsgruppen: Erze sollen mit der Welt kollidieren, aber NICHT
		mit Spielern. Ohne diese Trennung kickt ein Spieler, der auf dem
		Band steht, die Erze vom Plot - und auf einem fremden Plot koennte
		er den Nachbarn sabotieren.
	]]
	-- Einzeln registrieren: ein gemeinsames pcall wuerde nach dem ersten
	-- Fehler abbrechen und die zweite Gruppe nie anlegen.
	for _, group in ipairs({ ORE_GROUP, CHARACTER_GROUP }) do
		local ok = pcall(function()
			PhysicsService:RegisterCollisionGroup(group)
		end)
		if not ok then
			Log.debug("Economy", `Kollisionsgruppe '{group}' existierte bereits`)
		end
	end
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(ORE_GROUP, CHARACTER_GROUP, false)
		PhysicsService:CollisionGroupSetCollidable(ORE_GROUP, ORE_GROUP, true)
	end)
end

function EconomyService.Start()
	for _, state in ipairs(PlotService.all()) do
		connectPlot(state)
	end

	-- Charaktere in ihre Kollisionsgruppe stecken.
	local function tagCharacter(character: Model)
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.CollisionGroup = CHARACTER_GROUP
			end
		end
		character.DescendantAdded:Connect(function(descendant: Instance)
			if descendant:IsA("BasePart") then
				descendant.CollisionGroup = CHARACTER_GROUP
			end
		end)
	end
	local function hookPlayer(player: Player)
		if player.Character ~= nil then
			tagCharacter(player.Character)
		end
		player.CharacterAdded:Connect(tagCharacter)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		hookPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		multCache[player] = nil
		padCooldown[player] = nil
	end)

	--[[
		Zustand, der an EINEN Besitz gebunden ist, wird beim Freigeben des
		Plots mitgeloescht. Ohne das erbt der naechste Besitzer den
		Drop-Akkumulator des Vorgaengers (und bekaeme im ersten Tick
		gratis mehrere Erze), und die Cache-Tabellen wuechsen ueber die
		Serverlaufzeit mit jedem Spielerwechsel.
	]]
	PlotService.onAssign(function(state: PlotService.PlotState, player: Player)
		dropAccum[state.index] = {}
		holdProgress[state.index] = {}
		state.trove:add(function()
			dropAccum[state.index] = nil
			holdProgress[state.index] = nil
			multCache[player] = nil
			padCooldown[player] = nil
		end)
	end)

	TickScheduler.every("drop", Config.ECONOMY.DROP_TICK_HZ, onDropTick)
	TickScheduler.every("hold", Config.ECONOMY.DROP_TICK_HZ, onHoldTick)
	TickScheduler.every("sweep", Config.ECONOMY.SWEEP_TICK_HZ, onSweepTick)
end

return EconomyService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX19">
				<Properties>
					<string name="Name">LeaderboardService</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	LeaderboardService – globale Bestenliste auf einer Tafel in der Lobby.

	OrderedDataStore statt eigener Sortierung: nur der bietet serverseitig
	sortierte Seiten. Der Wert ist `totalEarned`, gedeckelt auf 2^53 bzw.
	den zulaessigen Integer-Bereich des OrderedDataStore - bei hohen
	Rebirths laeuft eine ungedeckelte Zahl sonst ueber und der Eintrag
	wird abgelehnt.

	Namen werden ueber Players:GetNameFromUserIdAsync aufgeloest und
	gecacht; der Aufruf ist ratenbegrenzt und darf nicht pro Aktualisierung
	fuer 50 Eintraege neu laufen.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Log = require(Shared.Log)

local DataService = require(script.Parent.DataService)
local WorldService = require(script.Parent.WorldService)

-- OrderedDataStore akzeptiert nur ganzzahlige Werte in diesem Bereich.
local MAX_ORDERED_VALUE = 9_000_000_000_000

local LeaderboardService = {}
LeaderboardService.name = "LeaderboardService"

local store: OrderedDataStore? = nil
local nameCache: { [number]: string } = {}

local function nameFor(userId: number): string
	local cached = nameCache[userId]
	if cached ~= nil then
		return cached
	end
	local ok, result = pcall(function(): string
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local name = if ok then result else ("Spieler " .. tostring(userId))
	nameCache[userId] = name
	return name
end

local function publish()
	local activeStore = store
	if activeStore == nil then
		return
	end
	DataService.forEach(function(player: Player, data)
		if not DataService.canSave(player) then
			return
		end
		local value = math.clamp(math.floor(data.totalEarned), 0, MAX_ORDERED_VALUE)
		local ok, err = pcall(function()
			activeStore:SetAsync(tostring(player.UserId), value)
		end)
		if not ok then
			Log.throttled("lb_publish", 60, 2, "Leaderboard",
				`Veroeffentlichen fehlgeschlagen: {tostring(err)}`)
		end
	end)
end

--[[
	Avatarbilder. GetUserThumbnailAsync yieldet und ist ratenbegrenzt,
	deshalb laeuft es nach dem Zeichnen der Tafel in einem eigenen Thread
	und nur fuer Spieler, deren Bild noch nicht bekannt ist.
]]
local avatarCache: { [number]: string } = {}

local function loadAvatar(rank: number, userId: number)
	local cached = avatarCache[userId]
	if cached ~= nil then
		WorldService.setLeaderboardAvatar(rank, cached)
		return
	end
	task.spawn(function()
		local ok, image = pcall(function(): string
			local content = Players:GetUserThumbnailAsync(
				userId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)
			return content
		end)
		if not ok then
			Log.throttled("avatar", 120, 2, "Leaderboard", "Avatarbild nicht ladbar")
			return
		end
		avatarCache[userId] = image
		WorldService.setLeaderboardAvatar(rank, image)
	end)
end

local function refresh()
	local activeStore = store
	if activeStore == nil then
		WorldService.setLeaderboardEmpty(true)
		return
	end
	local ok, pages = pcall(function(): DataStorePages?
		return activeStore:GetSortedAsync(false, Config.LEADERBOARD.TOP_N)
	end)
	if not ok or pages == nil then
		Log.throttled("lb_read", 120, 2, "Leaderboard", "Bestenliste konnte nicht gelesen werden")
		return
	end

	local entries: { WorldService.Entry } = {}
	for rank, entry in ipairs(pages:GetCurrentPage()) do
		local userId = tonumber(entry.key)
		if userId == nil then
			continue
		end
		local value = entry.value
		local amount = if typeof(value) == "number" then value else 0
		table.insert(entries, {
			rank = rank,
			userId = userId,
			name = nameFor(userId),
			amount = Format.abbreviate(amount),
		})
		if rank >= Config.LEADERBOARD.TOP_N then
			break
		end
	end

	WorldService.setLeaderboardRows(entries)
	WorldService.setLeaderboardEmpty(#entries == 0)
	for _, entry in ipairs(entries) do
		loadAvatar(entry.rank, entry.userId)
	end

	-- Der Namens-Cache waechst sonst ueber die Serverlaufzeit mit jedem
	-- neuen Spieler in der Bestenliste.
	local cachedNames = 0
	for _ in pairs(nameCache) do
		cachedNames += 1
	end
	if cachedNames > Config.LEADERBOARD.TOP_N * 10 then
		table.clear(nameCache)
		table.clear(avatarCache)
	end
end

function LeaderboardService.Init()
	local ok, result = pcall(function(): OrderedDataStore
		return DataStoreService:GetOrderedDataStore(Config.LEADERBOARD_STORE_NAME)
	end)
	store = if ok then result else nil
	if not ok then
		Log.warn("Leaderboard", "OrderedDataStore nicht verfuegbar - Tafel bleibt leer.")
	end
end

function LeaderboardService.Start()
	-- Eigene Threads statt TickScheduler: beide Aufgaben yielden auf
	-- Webaufrufe, und der Scheduler darf nie blockieren.
	task.spawn(function()
		while true do
			refresh()
			task.wait(Config.LEADERBOARD.REFRESH_SECONDS)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.LEADERBOARD.PUBLISH_SECONDS)
			publish()
		end
	end)
end

return LeaderboardService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX20">
				<Properties>
					<string name="Name">MonetizationService</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	MonetizationService – Gamepasses und Developer-Products.

	Wichtig fuer den Auslieferungszustand: alle Ids in Config sind 0.
	Ein Aufruf wie UserOwnsGamePassAsync(userId, 0) wirft eine Ausnahme und
	wuerde den Output fluten. Deshalb hat JEDER Marketplace-Aufruf hier eine
	Vorpruefung auf id ~= 0. So startet das unveraendert ausgelieferte Place
	fehlerfrei, und sobald echte Ids eingetragen sind, funktioniert alles
	ohne weitere Codeaenderung.

	Idempotenz bei Developer-Products: Roblox ruft ProcessReceipt so lange
	erneut auf, bis wir PurchaseGranted zurueckgeben - auch nach einem
	Serverneustart. Ohne Merken der PurchaseId bekaeme ein Spieler seine
	Gems mehrfach. Und umgekehrt: wir duerfen erst dann PurchaseGranted
	melden, wenn die Gutschrift auch WIRKLICH gespeichert ist, sonst ist das
	Geld weg und die Gems sind es auch.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Log = require(Shared.Log)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

local MonetizationService = {}
MonetizationService.name = "MonetizationService"

-- Besitzstand wird gecacht: UserOwnsGamePassAsync ist ein Webaufruf und
-- darf nicht bei jedem Erz erneut passieren.
local passCache: { [number]: { [number]: boolean } } = {}
-- Laufende Hintergrundabfragen, damit dieselbe Abfrage nicht pro Tick
-- erneut gestartet wird.
local pending: { [string]: boolean } = {}

--[[
	Besitzabfrage - GARANTIERT OHNE YIELD.

	Das ist der entscheidende Punkt: cashMultiplier() wird aus dem zentralen
	TickScheduler heraus aufgerufen (10x pro Sekunde, im Heartbeat). Ein
	blockierender UserOwnsGamePassAsync-Aufruf wuerde dort den kompletten
	Scheduler anhalten, bis der Webaufruf antwortet - bei 6 Plots waeren das
	sichtbare Aussetzer in der Erzproduktion.

	Deshalb: nur den Cache lesen. Ist der Eintrag unbekannt, wird EINMAL ein
	Hintergrund-Thread gestartet und solange false angenommen. Beim Join
	wird der Cache ohnehin vorgewaermt, sodass dieser Fall praktisch nur
	direkt nach einem Kauf auftritt und dann hoechstens fuer einen Tick gilt.
]]
local function refreshPass(userId: number, passId: number)
	if passId == 0 or pending[userId .. ":" .. passId] then
		return
	end
	pending[userId .. ":" .. passId] = true
	task.spawn(function()
		local ok, result = pcall(function(): boolean
			return MarketplaceService:UserOwnsGamePassAsync(userId, passId)
		end)
		pending[userId .. ":" .. passId] = nil
		if not ok then
			Log.throttled(`pass_{passId}`, 60, 2, "Monetization",
				`Gamepass-Abfrage fehlgeschlagen: {tostring(result)}`)
			-- Bei Fehler NICHT cachen: ein zahlender Spieler haenge sonst
			-- bis zum Serverneustart ohne seinen Vorteil fest.
			return
		end
		local perPlayer = passCache[userId]
		if perPlayer == nil then
			perPlayer = {}
			passCache[userId] = perPlayer
		end
		perPlayer[passId] = result == true
	end)
end

local function ownsPass(player: Player, passId: number): boolean
	if passId == 0 then
		return false   -- Platzhalter-Id: kein Aufruf, kein Fehler
	end
	local perPlayer = passCache[player.UserId]
	local cached = if perPlayer ~= nil then perPlayer[passId] else nil
	if cached ~= nil then
		return cached
	end
	refreshPass(player.UserId, passId)
	return false
end

function MonetizationService.owns2xCash(player: Player): boolean
	return ownsPass(player, Config.MONETIZATION.GAMEPASS_2X_CASH)
end

function MonetizationService.ownsVip(player: Player): boolean
	return ownsPass(player, Config.MONETIZATION.GAMEPASS_VIP)
end

-- Gesamter Kaufmultiplikator aus bezahlten Vorteilen.
function MonetizationService.cashMultiplier(player: Player): number
	local mult = 1
	if MonetizationService.owns2xCash(player) then
		mult *= Config.MONETIZATION.CASH_MULT_2X
	end
	if MonetizationService.ownsVip(player) then
		mult *= Config.MONETIZATION.VIP_CASH_MULT
	end
	return mult
end

local function productById(productId: number): Types.GemProductDef?
	for _, product in ipairs(Config.GEM_PRODUCTS) do
		if product.productId == productId and productId ~= 0 then
			return product
		end
	end
	return nil
end

--[[
	ProcessReceipt. Ablauf bewusst in dieser Reihenfolge:
	  1. Spieler noch da?           -> sonst NotProcessedYet (Roblox fragt spaeter erneut)
	  2. Schon verbucht?            -> PurchaseGranted (Doppelgutschrift verhindern)
	  3. Profil speicherbar?        -> sonst NotProcessedYet, NIEMALS gewaehren
	  4. Gutschreiben + merken
	  5. Erst danach PurchaseGranted
]]
local function processReceipt(info: { [string]: any }): Enum.ProductPurchaseDecision
	local userId = info.PlayerId :: number
	local purchaseKey = tostring(info.PurchaseId)
	local player = Players:GetPlayerByUserId(userId)
	if player == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = DataService.get(player)
	if data == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if data.receipts[purchaseKey] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	if not DataService.canSave(player) then
		-- Ohne Speichermoeglichkeit waere die Gutschrift beim naechsten
		-- Join weg, das Robux aber ausgegeben. Lieber spaeter erneut.
		Log.warn("Monetization", `Kauf von {player.Name} verschoben: Profil nicht speicherbar`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local product = productById(info.ProductId :: number)
	if product == nil then
		Log.warn("Monetization", `Unbekanntes Produkt {tostring(info.ProductId)}`)
		-- Unbekanntes Produkt niemals endlos wiederholen lassen.
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	data.gems += product.gems
	data.receipts[purchaseKey] = true
	DataService.markDirty(player)

	Remotes.event("Notify"):FireClient(player, `{product.gems} Gems gutgeschrieben!`, "success")
	Log.info("Monetization", `{player.Name} hat {product.label} gekauft`)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

--[[
	VIP-Tuer.

	Roblox kann eine Wand nicht "nur fuer manche Spieler" durchlaessig
	machen - CanCollide gilt serverseitig fuer alle. Der uebliche Trick
	(Client setzt CanCollide lokal auf false) verlagert die Entscheidung
	auf den Client und ist damit faelschbar.

	Deshalb hier serverseitig und autoritativ: wer die Tuer beruehrt und
	den Pass besitzt, wird auf die andere Seite gesetzt. Die Richtung wird
	aus der lokalen X-Position bestimmt, damit dieselbe Tuer auch wieder
	hinausfuehrt. Ein Spieler ohne Pass prallt schlicht ab und bekommt
	einen Hinweis.
]]
local function connectVipDoors()
	local lastPrompt: { [number]: number } = {}

	for _, state in ipairs(PlotService.all()) do
		local refs = state.refs
		refs.vipDoor.Touched:Connect(function(hit: BasePart)
			local character = hit.Parent
			if character == nil then
				return
			end
			local player = Players:GetPlayerFromCharacter(character)
			if player == nil then
				return
			end
			-- Tuer existiert nur, wenn die Lounge gebaut ist.
			if not refs.vipDoor.CanCollide then
				return
			end
			local root = character:FindFirstChild("HumanoidRootPart")
			if root == nil or not root:IsA("BasePart") then
				return
			end

			local now = os.clock()
			local previous = lastPrompt[player.UserId]
			if previous ~= nil and now - previous < 1.5 then
				return
			end
			lastPrompt[player.UserId] = now

			if not MonetizationService.ownsVip(player) then
				Remotes.event("Notify"):FireClient(
					player, "Die VIP-Lounge braucht den VIP-Pass.", "error")
				return
			end

			-- In Plot-lokale Koordinaten umrechnen, um die Seite zu bestimmen.
			local localPos = refs.origin:PointToObjectSpace(root.Position)
			local doorLocal = refs.origin:PointToObjectSpace(refs.vipDoor.Position)
			local inside = localPos.X > doorLocal.X
			local targetX = if inside then doorLocal.X - 6 else doorLocal.X + 8
			root.CFrame = refs.origin * CFrame.new(targetX, localPos.Y, localPos.Z)
		end)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		lastPrompt[player.UserId] = nil
	end)
end

function MonetizationService.Init()
	-- Nur EIN Handler im ganzen Spiel: Roblox erlaubt genau einen.
	MarketplaceService.ProcessReceipt = processReceipt
end

function MonetizationService.Start()
	-- Cache beim Join vorwaermen, damit der erste Erz-Tick bereits den
	-- richtigen Multiplikator sieht.
	local function prewarm(player: Player)
		refreshPass(player.UserId, Config.MONETIZATION.GAMEPASS_2X_CASH)
		refreshPass(player.UserId, Config.MONETIZATION.GAMEPASS_VIP)
	end
	Players.PlayerAdded:Connect(prewarm)
	for _, player in ipairs(Players:GetPlayers()) do
		prewarm(player)
	end

	connectVipDoors()

	Players.PlayerRemoving:Connect(function(player: Player)
		passCache[player.UserId] = nil
	end)

	-- Nach einem Gamepass-Kauf im laufenden Spiel den Cache verwerfen,
	-- damit der Vorteil sofort greift.
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player: Player, passId: number, wasPurchased: boolean)
			if not wasPurchased then
				return
			end
			local perPlayer = passCache[player.UserId]
			if perPlayer ~= nil then
				perPlayer[passId] = nil
			end
			refreshPass(player.UserId, passId)
			DataService.markDirty(player)
			Remotes.event("Notify"):FireClient(player, "Vielen Dank fuer den Kauf!", "success")
		end
	)
end

-- Vom Client angefragter Kaufdialog. Der Client kann PromptProductPurchase
-- auch selbst aufrufen; der Umweg ueber den Server sorgt dafuer, dass nur
-- Produkt-Ids aus der Config verwendet werden koennen.
function MonetizationService.promptGemProduct(player: Player, productKey: string)
	for _, product in ipairs(Config.GEM_PRODUCTS) do
		if product.id == productKey then
			if product.productId == 0 then
				Remotes.event("Notify"):FireClient(
					player, "Dieses Paket ist noch nicht eingerichtet.", "error")
				return
			end
			local ok, err = pcall(function()
				MarketplaceService:PromptProductPurchase(player, product.productId)
			end)
			if not ok then
				Log.warn("Monetization", `PromptProductPurchase fehlgeschlagen: {tostring(err)}`)
			end
			return
		end
	end
end

return MonetizationService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX21">
				<Properties>
					<string name="Name">PlotBuilder</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	PlotBuilder – Geometrie EINES Tycoon-Plots.

	Kennt keine Spieler, kein Geld und keine Kaufregeln; liefert nur
	benannte Referenzen. Farben, Materialien und Reflectance kommen
	vollstaendig aus Theme – im Weltbau steht genauso wenig ein
	Farbliteral wie in der Oberflaeche.

	Bauregeln, die den "Anfaenger-Baukasten"-Eindruck vermeiden:

	  * Gefaste Kanten. Jeder Sockel bekommt vier WedgeParts an der
	    Oberkante. Roblox hat kein Bevel-Werkzeug; vier Keile im
	    90-Grad-Raster sind die naechstbeste Umsetzung und kosten
	    vier Parts statt eines Meshes.
	  * Alle Positionen liegen auf ganzen Studs, alle Rotationen in
	    90-Grad-Schritten (Vielfache von 15).
	  * SmoothPlastic statt Plastic, Reflectance hoechstens 0.12 –
	    hoehere Werte lassen Roblox-Teile nass statt metallisch wirken.
	  * Neon ausschliesslich fuer Lichtakzente (Ring, Duese, Sammlerfeld),
	    nie fuer grosse Flaechen.

	Der Kaufknopf besteht aus vier Teilen: Sockel, Fase, Leuchtring
	(flacher Zylinder) und Trittplatte, darueber ein schwebendes Panel
	mit Name, Preis, Symbol und Fortschrittsring.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local C = Theme.Color
local M = Theme.Material

-- ==========================================================================
-- Layout (lokal zum Plot-Ursprung, alle Werte in ganzen Studs)
-- ==========================================================================

local L = {
	FLOOR_TOP = 1,

	BELT_Z = -45,
	BELT_Y_TOP = 6,
	BELT_MIN_X = -66,
	BELT_MAX_X = 66,
	BELT_WIDTH = 9,

	DROPPER_START_X = -62,
	DROPPER_STEP_X = 8,
	DROPPER_BODY_Y = 13,

	UPGRADER_START_X = 2,
	UPGRADER_STEP_X = 10,

	COLLECTOR_X = 60,

	BUTTON_ROW_Z = { 14, 36, 58 },
	BUTTON_PER_ROW = 9,
	BUTTON_STEP_X = 17,
	BUTTON_BASE = 9,
	BUTTON_TREAD = 7,

	CLAIM_Z = 75,
	REBIRTH_POS = Vector3.new(-66, 2, 66),
	VIP_ROOM_SIZE = 16,
	VIP_POS = Vector3.new(68, 8, 74),

	HALL_BACK_Z = -74,
	HALL_SIDE_X = 76,
	HALL_HEIGHT = 32,
	HALL_FRONT_Z = -8,
}

local DROPPER_ORDER = {
	"__base", "dropper_2", "dropper_3", "dropper_4",
	"dropper_5", "dropper_6", "dropper_7",
}
local UPGRADER_ORDER = {
	"upgrader_1", "upgrader_2", "upgrader_3", "upgrader_4", "upgrader_5",
}

-- Symbol je Upgrade-Art auf dem schwebenden Panel.
local function iconFor(kind: string): string
	if kind == "dropper" then
		return "drill"
	elseif kind == "upgrader" or kind == "collector" then
		return "furnace"
	elseif kind == "speed" or kind == "rate" then
		return "belt"
	end
	return "shop"
end

-- ==========================================================================
-- Typen
-- ==========================================================================

export type ButtonRefs = {
	def: Types.UpgradeDef,
	base: BasePart,
	tread: BasePart,
	ring: BasePart,
	bevel: { BasePart },
	billboard: BillboardGui,
	card: Frame,
	title: TextLabel,
	price: TextLabel,
	progress: Frame,
	stroke: UIStroke,
	homeCFrame: CFrame,
}

export type UpgraderRefs = { field: BasePart, frame: { BasePart } }

export type PlotRefs = {
	index: number,
	origin: CFrame,
	model: Model,
	ores: Folder,
	conveyors: { BasePart },
	conveyorBeam: Beam,
	dropSpawns: { [string]: CFrame },
	dropperBodies: { [string]: { BasePart } },
	upgraders: { [string]: UpgraderRefs },
	collector: BasePart,
	collectorSub: TextLabel,
	collectorBurst: ParticleEmitter,
	buttons: { [string]: ButtonRefs },
	claimPad: BasePart,
	claimTitle: TextLabel,
	claimSub: TextLabel,
	rebirthPad: BasePart,
	rebirthSub: TextLabel,
	hall: { BasePart },
	hallLights: { PointLight },
	vipDoor: BasePart,
	spawnCFrame: CFrame,
}

-- ==========================================================================
-- Bau-Hilfen
-- ==========================================================================

type PartOptions = {
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	transparency: number?,
	canCollide: boolean?,
	reflectance: number?,
	shape: Enum.PartType?,
	parent: Instance,
}

local function makePart(o: PartOptions): Part
	local p = Instance.new("Part")
	p.Name = o.name
	p.Size = o.size
	p.CFrame = o.cf
	p.Color = o.color
	p.Material = o.material or M.surface
	p.Transparency = o.transparency or Theme.Alpha.opaque
	p.Reflectance = o.reflectance or Theme.Reflectance.none
	p.CanCollide = if o.canCollide == nil then true else o.canCollide
	p.Shape = o.shape or Enum.PartType.Block
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = false
	p.Parent = o.parent
	return p
end

local function makeWedge(name: string, size: Vector3, cf: CFrame, color: Color3,
	material: Enum.Material, parent: Instance): WedgePart
	local w = Instance.new("WedgePart")
	w.Name = name
	w.Size = size
	w.CFrame = cf
	w.Color = color
	w.Material = material
	w.Anchored = true
	w.CanCollide = false
	w.CastShadow = false
	w.Parent = parent
	return w
end

--[[
	Vier Keile an der Oberkante eines quadratischen Sockels.
	Die Rotationen sind 0/90/180/270 Grad – Vielfache von 15, wie gefordert.
]]
local function bevelRing(center: CFrame, span: number, height: number,
	color: Color3, parent: Instance): { BasePart }
	local out: { BasePart } = {}
	local inset = span / 2 - height / 2
	for step = 0, 3 do
		-- 0, 90, 180, 270 Grad - alles Vielfache von 15.
		local yaw = math.rad(step * 90)
		local cf = center
			* CFrame.Angles(0, yaw, 0)
			* CFrame.new(0, height / 2, -inset)
			* CFrame.Angles(0, math.rad(180), 0)
		out[step + 1] = makeWedge("Bevel", Vector3.new(span, height, height),
			cf, color, M.metal, parent)
	end
	return out
end

--[[
	Schwebendes Panel im Stil der Oberflaeche: Karte mit Rand, Symbolfeld,
	Titel, Preis und einem Fortschrittsbalken als "Ring".

	Ein echter Kreisring waere in Roblox-GUI nur ueber ein Bild (mit
	Asset-Id) oder ein zerlegtes Viertelkreis-Konstrukt moeglich. Da hier
	keine Asset-Ids erfunden werden, ist es ein horizontaler Balken mit
	Pill-Radius – dieselbe Information, ohne Platzhalterbild.
]]
local function buyPanel(adornee: BasePart, def: Types.UpgradeDef)
	local bb = Instance.new("BillboardGui")
	bb.Name = "BuyPanel"
	bb.Size = UDim2.fromScale(Theme.Size.worldSignWidth, Theme.Size.worldSignWidth * 0.52)
	bb.StudsOffsetWorldSpace = Vector3.new(0, Theme.Size.worldSignOffset, 0)
	-- 60 Studs: ab da ist der Text ohnehin nicht mehr lesbar, und bei
	-- sechs Plots mit je 25 Panels ist das der teuerste Posten im Bild.
	bb.MaxDistance = Theme.Size.worldSignOffset * 10
	bb.LightInfluence = 0
	bb.Adornee = adornee
	bb.Parent = adornee

	local card = Theme.Card({
		name = "Card", parent = bb,
		size = UDim2.fromScale(1, 1),
		fill = C.bg1, radius = Theme.Radius.card,
		strokeColor = C.primary, zIndex = Theme.Layer.world, shadow = false,
	})
	Theme.padding(card, { all = Theme.Space.x8 })
	local stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke

	-- Symbolfeld links
	local iconField = Instance.new("Frame")
	iconField.Name = "IconField"
	iconField.Size = UDim2.fromScale(0.2, 0.62)
	iconField.Position = UDim2.fromScale(0, 0)
	iconField.BackgroundColor3 = C.primary
	iconField.BorderSizePixel = 0
	iconField.ZIndex = Theme.Layer.world + Theme.Depth.content
	iconField.Parent = card
	Theme.corner(iconField, Theme.Radius.chip)
	local glyph = Theme.label({
		name = "Glyph", parent = iconField, text = "", role = "display",
		size = Theme.TextSize.md, color = C.bg0,
		layoutSize = UDim2.fromScale(1, 1),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = Theme.Layer.world + Theme.Depth.raised, stroke = false,
	})
	glyph.Name = "Glyph_" .. iconFor(def.effect.kind)

	local title = Theme.label({
		name = "Title", parent = card, text = def.label, role = "heading",
		size = Theme.TextSize.md, color = C.textHigh,
		layoutSize = UDim2.fromScale(0.76, 0.34),
		position = UDim2.fromScale(0.24, 0),
		zIndex = Theme.Layer.world + Theme.Depth.content,
	})
	local price = Theme.label({
		name = "Price", parent = card,
		text = Format.abbreviate(def.price) .. " $", role = "numeric",
		size = Theme.TextSize.lg, color = C.success,
		layoutSize = UDim2.fromScale(0.76, 0.3),
		position = UDim2.fromScale(0.24, 0.32),
		zIndex = Theme.Layer.world + Theme.Depth.content,
	})

	-- Fortschritt beim Draufstehen
	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.fromScale(1, 0.14)
	track.Position = UDim2.fromScale(0, 0.86)
	track.BackgroundColor3 = C.bg0
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.ZIndex = Theme.Layer.world + Theme.Depth.content
	track.Parent = card
	Theme.corner(track, Theme.Radius.pill)

	local progress = Instance.new("Frame")
	progress.Name = "Progress"
	progress.Size = UDim2.fromScale(0, 1)
	progress.BackgroundColor3 = C.primary
	progress.BorderSizePixel = 0
	progress.ZIndex = Theme.Layer.world + Theme.Depth.raised
	progress.Parent = track
	Theme.corner(progress, Theme.Radius.pill)

	return card, title, price, progress, stroke, bb
end

local function makeSign(parent: BasePart, title: string, sub: string,
	accent: Color3, widthStuds: number, offsetY: number): (TextLabel, TextLabel)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Sign"
	bb.Size = UDim2.fromScale(widthStuds, widthStuds * 0.4)
	bb.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	bb.MaxDistance = Theme.Size.worldSignOffset * 32
	bb.LightInfluence = 0
	bb.Parent = parent

	local card = Theme.Card({
		name = "Card", parent = bb, size = UDim2.fromScale(1, 1),
		fill = C.bg1, radius = Theme.Radius.card, strokeColor = accent,
		zIndex = Theme.Layer.world, shadow = false,
	})
	Theme.padding(card, { all = Theme.Space.x8 })

	local titleLabel = Theme.label({
		name = "Title", parent = card, text = title, role = "display",
		size = Theme.TextSize.lg, color = accent,
		layoutSize = UDim2.fromScale(1, 0.5),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = Theme.Layer.world + Theme.Depth.content,
	})
	local subLabel = Theme.label({
		name = "Sub", parent = card, text = sub, role = "body",
		size = Theme.TextSize.sm, color = C.textMid,
		layoutSize = UDim2.fromScale(1, 0.42),
		position = UDim2.fromScale(0, 0.54),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = Theme.Layer.world + Theme.Depth.content, stroke = false,
	})
	return titleLabel, subLabel
end

-- ==========================================================================
-- Aufbau
-- ==========================================================================

local PlotBuilder = {}

function PlotBuilder.build(index: number, origin: CFrame, parent: Instance): PlotRefs
	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model.Parent = parent

	local build = Instance.new("Folder")
	build.Name = "Build"
	build.Parent = model

	local ores = Instance.new("Folder")
	ores.Name = "Ores"
	ores.Parent = model

	local function at(x: number, y: number, z: number): CFrame
		return origin * CFrame.new(x, y, z)
	end

	local size = Config.WORLD.PLOT_SIZE

	-- ---- Boden und Rand ------------------------------------------------
	makePart({
		name = "Floor", size = size, cf = at(0, 0, 0),
		color = C.bg1, material = M.concrete, parent = build,
	})
	local halfX, halfZ = size.X / 2, size.Z / 2
	for _, spec in ipairs({
		{ Vector3.new(size.X, 3, 2), Vector3.new(0, 1.5, -halfZ) },
		{ Vector3.new(size.X, 3, 2), Vector3.new(0, 1.5, halfZ) },
		{ Vector3.new(2, 3, size.Z), Vector3.new(-halfX, 1.5, 0) },
		{ Vector3.new(2, 3, size.Z), Vector3.new(halfX, 1.5, 0) },
	}) do
		makePart({
			name = "Kerb", size = spec[1],
			cf = at(spec[2].X, spec[2].Y, spec[2].Z),
			color = C.bg3, material = M.metal,
			reflectance = Theme.Reflectance.subtle, parent = build,
		})
	end

	-- ---- Foerderband ----------------------------------------------------
	local beltLength = L.BELT_MAX_X - L.BELT_MIN_X
	local beltCenterX = (L.BELT_MIN_X + L.BELT_MAX_X) / 2
	local belt = makePart({
		name = "Conveyor",
		size = Vector3.new(beltLength, 1, L.BELT_WIDTH),
		cf = at(beltCenterX, L.BELT_Y_TOP - 0.5, L.BELT_Z),
		color = C.bg0, material = M.brushed,
		reflectance = Theme.Reflectance.subtle, parent = build,
	})
	belt.AssemblyLinearVelocity = Vector3.new(Config.ECONOMY.CONVEYOR_BASE_SPEED, 0, 0)

	-- Laufrichtungs-Beam ueber dem Band: zeigt an, wohin die Erze wandern.
	local beamStart = Instance.new("Attachment")
	beamStart.Position = Vector3.new(-beltLength / 2, 0.6, 0)
	beamStart.Parent = belt
	local beamEnd = Instance.new("Attachment")
	beamEnd.Position = Vector3.new(beltLength / 2, 0.6, 0)
	beamEnd.Parent = belt
	local beam = Instance.new("Beam")
	beam.Name = "FlowBeam"
	beam.Attachment0 = beamStart
	beam.Attachment1 = beamEnd
	beam.Width0 = L.BELT_WIDTH * 0.7
	beam.Width1 = L.BELT_WIDTH * 0.7
	beam.FaceCamera = false
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Color = ColorSequence.new(C.primary)
	-- An den Enden ausblenden, damit der Streifen nicht abrupt abschneidet.
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.15, Theme.Alpha.ghost),
		NumberSequenceKeypoint.new(0.85, Theme.Alpha.ghost),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Parent = belt

	for x = L.BELT_MIN_X + 6, L.BELT_MAX_X - 6, 18 do
		makePart({
			name = "BeltLeg", size = Vector3.new(2, L.BELT_Y_TOP - 1 - L.FLOOR_TOP, L.BELT_WIDTH),
			cf = at(x, (L.FLOOR_TOP + L.BELT_Y_TOP - 1) / 2, L.BELT_Z),
			color = C.bg2, material = M.metal,
			reflectance = Theme.Reflectance.metal, parent = build,
		})
	end
	for _, dz in ipairs({ -(L.BELT_WIDTH / 2 + 0.5), L.BELT_WIDTH / 2 + 0.5 }) do
		makePart({
			name = "BeltRail", size = Vector3.new(beltLength, 2, 1),
			cf = at(beltCenterX, L.BELT_Y_TOP + 0.5, L.BELT_Z + dz),
			color = C.bg3, material = M.metal,
			reflectance = Theme.Reflectance.metal, parent = build,
		})
	end

	-- ---- Dropper ---------------------------------------------------------
	local dropSpawns: { [string]: CFrame } = {}
	local dropperBodies: { [string]: { BasePart } } = {}
	for i, id in ipairs(DROPPER_ORDER) do
		local x = L.DROPPER_START_X + (i - 1) * L.DROPPER_STEP_X
		local body = makePart({
			name = "Dropper_" .. id, size = Vector3.new(5, 6, 8),
			cf = at(x, L.DROPPER_BODY_Y, L.BELT_Z),
			color = C.bg2, material = M.metal,
			reflectance = Theme.Reflectance.metal, parent = build,
		})
		local cap = makePart({
			name = "Cap", size = Vector3.new(6, 1, 9),
			cf = at(x, L.DROPPER_BODY_Y + 3, L.BELT_Z),
			color = C.bg3, material = M.brushed, parent = build,
		})
		local nozzle = makePart({
			name = "Nozzle", size = Vector3.new(2.6, 1.4, 2.6),
			cf = at(x, L.DROPPER_BODY_Y - 3.6, L.BELT_Z),
			color = C.primary, material = M.neon,
			canCollide = false, parent = build,
		})
		dropperBodies[id] = { body, cap, nozzle }
		dropSpawns[id] = at(x, L.DROPPER_BODY_Y - 5.2, L.BELT_Z)
	end

	-- ---- Veredler ---------------------------------------------------------
	local upgraders: { [string]: UpgraderRefs } = {}
	for i, id in ipairs(UPGRADER_ORDER) do
		local x = L.UPGRADER_START_X + (i - 1) * L.UPGRADER_STEP_X
		local half = L.BELT_WIDTH / 2 + 1
		local frame: { BasePart } = {
			makePart({ name = "PillarA", size = Vector3.new(1.4, 9, 1.4),
				cf = at(x, L.BELT_Y_TOP + 4.5, L.BELT_Z - half),
				color = C.bg3, material = M.metal,
				reflectance = Theme.Reflectance.metal, parent = build }),
			makePart({ name = "PillarB", size = Vector3.new(1.4, 9, 1.4),
				cf = at(x, L.BELT_Y_TOP + 4.5, L.BELT_Z + half),
				color = C.bg3, material = M.metal,
				reflectance = Theme.Reflectance.metal, parent = build }),
			makePart({ name = "Beam", size = Vector3.new(1.4, 1.4, half * 2 + 1.4),
				cf = at(x, L.BELT_Y_TOP + 9, L.BELT_Z),
				color = C.bg3, material = M.metal, parent = build }),
			makePart({ name = "Lamp", size = Vector3.new(1, 0.6, half * 2 - 1),
				cf = at(x, L.BELT_Y_TOP + 8.2, L.BELT_Z),
				color = C.premium, material = M.neon,
				canCollide = false, parent = build }),
		}
		local field = makePart({
			name = "Field_" .. id, size = Vector3.new(1.2, 8, L.BELT_WIDTH),
			cf = at(x, L.BELT_Y_TOP + 4, L.BELT_Z),
			color = C.premium, material = M.force,
			transparency = Theme.Alpha.veil, canCollide = false, parent = build,
		})
		local def = Config.UPGRADES_BY_ID[id]
		makeSign(field, def.label, `x{def.effect.mult} Erzwert`, C.premium,
			Theme.Size.worldSignWidth * 0.8, Theme.Size.worldSignOffset)
		upgraders[id] = { field = field, frame = frame }
	end

	-- ---- Sammler ----------------------------------------------------------
	local collectorBase = makePart({
		name = "CollectorBase", size = Vector3.new(12, 10, 16),
		cf = at(L.COLLECTOR_X + 8, L.FLOOR_TOP + 5, L.BELT_Z),
		color = C.bg2, material = M.metal,
		reflectance = Theme.Reflectance.metal, parent = build,
	})
	bevelRing(at(L.COLLECTOR_X + 8, L.FLOOR_TOP + 10, L.BELT_Z), 12, 1, C.bg3, build)
	local collector = makePart({
		name = "Collector", size = Vector3.new(3, 10, L.BELT_WIDTH),
		cf = at(L.COLLECTOR_X - 1, L.BELT_Y_TOP + 4, L.BELT_Z),
		color = C.success, material = M.neon,
		transparency = Theme.Alpha.veil, canCollide = false, parent = build,
	})
	local _, collectorSub = makeSign(collectorBase, "SAMMLER", "0 $ gesamt",
		C.success, Theme.Size.worldSignWidth, Theme.Size.worldSignOffset + 2)

	-- Muenzfunken beim Einloesen. Rate bleibt klein (< 20), sonst kostet
	-- der Emitter bei sechs Plots spuerbar Fuellrate.
	local burstAttachment = Instance.new("Attachment")
	burstAttachment.Position = Vector3.new(0, 5, 0)
	burstAttachment.Parent = collectorBase
	local burst = Instance.new("ParticleEmitter")
	burst.Name = "Coins"
	burst.Texture = Theme.Asset.PARTICLE_SPARKLE
	burst.Color = ColorSequence.new(C.premium)
	burst.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.9),
		NumberSequenceKeypoint.new(1, 0),
	})
	burst.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, Theme.Alpha.veil),
		NumberSequenceKeypoint.new(1, 1),
	})
	burst.Lifetime = NumberRange.new(0.3, 0.6)
	burst.Speed = NumberRange.new(6, 11)
	burst.SpreadAngle = Vector2.new(30, 30)
	burst.Rate = 0
	burst.LightEmission = 1
	burst.Enabled = false
	burst.Parent = burstAttachment

	-- ---- Kaufknoepfe ------------------------------------------------------
	local buttons: { [string]: ButtonRefs } = {}
	for i, def in ipairs(Config.UPGRADES) do
		local row = math.min(#L.BUTTON_ROW_Z, math.floor((i - 1) / L.BUTTON_PER_ROW) + 1)
		local col = (i - 1) % L.BUTTON_PER_ROW
		local rowCount = math.min(L.BUTTON_PER_ROW, #Config.UPGRADES - (row - 1) * L.BUTTON_PER_ROW)
		local x = (col - (rowCount - 1) / 2) * L.BUTTON_STEP_X
		local z = L.BUTTON_ROW_Z[row]

		local base = makePart({
			name = "Buy_" .. def.id,
			size = Vector3.new(L.BUTTON_BASE, 1.2, L.BUTTON_BASE),
			cf = at(x, L.FLOOR_TOP + 0.6, z),
			color = C.bg2, material = M.metal,
			reflectance = Theme.Reflectance.metal, parent = build,
		})
		local bevel = bevelRing(at(x, L.FLOOR_TOP + 1.2, z), L.BUTTON_BASE, 0.8, C.bg3, build)

		-- Leuchtring: flacher Zylinder. Die Zylinderachse liegt in X,
		-- deshalb 90 Grad um Z drehen, damit die Scheibe waagerecht liegt.
		local ring = makePart({
			name = "Ring", size = Vector3.new(0.4, L.BUTTON_TREAD + 1.4, L.BUTTON_TREAD + 1.4),
			cf = at(x, L.FLOOR_TOP + 1.3, z) * CFrame.Angles(0, 0, math.rad(90)),
			color = C.primary, material = M.neon,
			canCollide = false, shape = Enum.PartType.Cylinder, parent = build,
		})
		local tread = makePart({
			name = "Tread", size = Vector3.new(L.BUTTON_TREAD, 0.5, L.BUTTON_TREAD),
			cf = at(x, L.FLOOR_TOP + 1.45, z),
			color = C.bg3, material = M.surface, parent = build,
		})

		local card, title, price, progress, stroke, billboard = buyPanel(tread, def)
		buttons[def.id] = {
			def = def, base = base, tread = tread, ring = ring, bevel = bevel,
			billboard = billboard, card = card, title = title, price = price,
			progress = progress, stroke = stroke,
			homeCFrame = base.CFrame,
		}
	end

	-- ---- Claim-Pad ---------------------------------------------------------
	local claimPad = makePart({
		name = "ClaimPad", size = Vector3.new(16, 2, 16),
		cf = at(0, L.FLOOR_TOP + 1, L.CLAIM_Z),
		color = C.premium, material = M.neon, parent = build,
	})
	local claimTitle, claimSub = makeSign(claimPad, `FREI #{index}`,
		"Wird beim Beitritt vergeben", C.premium,
		Theme.Size.worldSignWidth * 1.4, Theme.Size.worldSignOffset + 1)

	-- ---- Rebirth-Pad --------------------------------------------------------
	local rebirthPad = makePart({
		name = "RebirthPad", size = Vector3.new(12, 2, 12),
		cf = at(L.REBIRTH_POS.X, L.FLOOR_TOP + 1, L.REBIRTH_POS.Z),
		color = C.danger, material = M.neon, parent = build,
	})
	bevelRing(at(L.REBIRTH_POS.X, L.FLOOR_TOP + 2, L.REBIRTH_POS.Z), 12, 0.8, C.dangerDeep, build)
	local _, rebirthSub = makeSign(rebirthPad, "REBIRTH", "-", C.danger,
		Theme.Size.worldSignWidth * 1.2, Theme.Size.worldSignOffset)

	-- ---- Halle ---------------------------------------------------------------
	local hall: { BasePart } = {}
	local hallDepth = L.HALL_FRONT_Z - L.HALL_BACK_Z
	local hallMidZ = (L.HALL_FRONT_Z + L.HALL_BACK_Z) / 2
	table.insert(hall, makePart({
		name = "HallBack", size = Vector3.new(L.HALL_SIDE_X * 2, L.HALL_HEIGHT, 2),
		cf = at(0, L.FLOOR_TOP + L.HALL_HEIGHT / 2, L.HALL_BACK_Z),
		color = C.bg1, material = M.metal, parent = build,
	}))
	for _, sx in ipairs({ -L.HALL_SIDE_X, L.HALL_SIDE_X }) do
		table.insert(hall, makePart({
			name = "HallSide", size = Vector3.new(2, L.HALL_HEIGHT, hallDepth),
			cf = at(sx, L.FLOOR_TOP + L.HALL_HEIGHT / 2, hallMidZ),
			color = C.bg1, material = M.metal, parent = build,
		}))
	end
	table.insert(hall, makePart({
		name = "HallRoof", size = Vector3.new(L.HALL_SIDE_X * 2, 2, hallDepth),
		cf = at(0, L.FLOOR_TOP + L.HALL_HEIGHT, hallMidZ),
		color = C.bg0, material = M.metal,
		transparency = Theme.Alpha.glass, parent = build,
	}))

	local hallLights: { PointLight } = {}
	for _, lx in ipairs({ -40, 0, 40 }) do
		local fixture = makePart({
			name = "Lamp", size = Vector3.new(6, 1, 6),
			cf = at(lx, L.FLOOR_TOP + L.HALL_HEIGHT - 2, hallMidZ),
			color = C.premiumLight, material = M.neon,
			canCollide = false, parent = build,
		})
		local light = Instance.new("PointLight")
		light.Brightness = 3
		light.Range = 45
		light.Color = C.premiumLight
		-- Schatten nur beim mittleren Licht: drei schattenwerfende Lichter
		-- pro Plot mal sechs Plots kosten auf Mobilgeraeten zu viel.
		light.Shadows = lx == 0
		light.Enabled = false
		light.Parent = fixture
		table.insert(hallLights, light)
		table.insert(hall, fixture)
	end

	-- ---- VIP-Raum ---------------------------------------------------------------
	makePart({
		name = "VipFloor", size = Vector3.new(L.VIP_ROOM_SIZE, 2, L.VIP_ROOM_SIZE),
		cf = at(L.VIP_POS.X, L.FLOOR_TOP + 1, L.VIP_POS.Z),
		color = C.bg2, material = M.marble,
		reflectance = Theme.Reflectance.subtle, parent = build,
	})
	local vipDoor = makePart({
		name = "VipDoor", size = Vector3.new(2, 12, 12),
		cf = at(L.VIP_POS.X - L.VIP_ROOM_SIZE / 2, L.FLOOR_TOP + 6, L.VIP_POS.Z),
		color = C.premium, material = M.glass,
		transparency = Theme.Alpha.veil, parent = build,
	})
	makeSign(vipDoor, "VIP", "Nur mit VIP-Pass", C.premium,
		Theme.Size.worldSignWidth * 0.8, Theme.Size.worldSignOffset + 2)

	model.PrimaryPart = claimPad

	return {
		index = index, origin = origin, model = model, ores = ores,
		conveyors = { belt }, conveyorBeam = beam,
		dropSpawns = dropSpawns, dropperBodies = dropperBodies,
		upgraders = upgraders,
		collector = collector, collectorSub = collectorSub, collectorBurst = burst,
		buttons = buttons,
		claimPad = claimPad, claimTitle = claimTitle, claimSub = claimSub,
		rebirthPad = rebirthPad, rebirthSub = rebirthSub,
		hall = hall, hallLights = hallLights, vipDoor = vipDoor,
		spawnCFrame = at(0, L.FLOOR_TOP + 4, L.CLAIM_Z - 9),
	}
end

PlotBuilder.DROPPER_ORDER = DROPPER_ORDER
PlotBuilder.UPGRADER_ORDER = UPGRADER_ORDER
PlotBuilder.BUTTON_RADIUS = L.BUTTON_BASE

return PlotBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX22">
				<Properties>
					<string name="Name">PlotService</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	PlotService – Besitz, Zuweisung, Freigabe und Optik der Plots.

	Zustaendig fuer:
	  * 6 Plots beim Serverstart bauen
	  * beim Join automatisch einen freien Plot zuweisen
	  * beim Verlassen den Plot vollstaendig zuruecksetzen und wiederverwenden
	  * die Optik an den Kaufzustand anpassen (welcher Button leuchtet,
	    welcher Dropper steht da, ist die Halle zu)

	NICHT zustaendig fuer Geld, Erze oder Kaufregeln - das ist EconomyService.
	Die Trennung ist wichtig, weil der Reset beim Verlassen sonst an drei
	Stellen halb implementiert waere.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Log = require(Shared.Log)
local Theme = require(Shared.Theme)
local Trove = require(Shared.Trove)
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)
local PlotBuilder = require(script.Parent.PlotBuilder)

local C = Theme.Color

export type PlotState = {
	index: number,
	refs: PlotBuilder.PlotRefs,
	owner: Player?,
	trove: Trove.Trove,
	oreCount: number,
	conveyorSpeed: number,
}

local PlotService = {}
PlotService.name = "PlotService"

local TweenService = game:GetService("TweenService")

-- Wie tief ein gekaufter Knopf im Boden verschwindet.
local SINK_DEPTH = 4

local plots: { PlotState } = {}
--[[
	Haken, die bei der Zuweisung eines Plots laufen. Andere Dienste haengen
	sich hier ein, um plot- oder spielergebundenen Zustand anzulegen und
	ihn ueber state.trove wieder freizugeben. Ohne diesen Mechanismus
	wuerde beim Recyceln eines Plots der Zustand des Vorbesitzers
	weiterleben - z. B. der Drop-Akkumulator oder ein Beruehrungs-Cooldown.
]]
local assignHooks: { (state: PlotState, player: Player) -> () } = {}
local byPlayer: { [Player]: PlotState } = {}

-- ==========================================================================
-- Zugriff
-- ==========================================================================

function PlotService.onAssign(hook: (state: PlotState, player: Player) -> ())
	table.insert(assignHooks, hook)
end

function PlotService.all(): { PlotState }
	return plots
end

function PlotService.forPlayer(player: Player): PlotState?
	return byPlayer[player]
end

function PlotService.ownerOf(state: PlotState): Player?
	return state.owner
end

--[[
	Distanzpruefung fuer Kaeufe aus der UI heraus.
	Warum ueberhaupt: ohne sie koennte ein Exploiter aus der Lobby heraus
	den kompletten Baum leerkaufen, waehrend ein ehrlicher Spieler auf die
	Pads laufen muss. Der Radius ist grosszuegig (Plotgroesse), damit
	niemand faelschlich blockiert wird, nur weil er in der VIP-Ecke steht.
]]
function PlotService.isNearOwnPlot(player: Player): boolean
	local state = byPlayer[player]
	if state == nil then
		return false
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return false
	end
	local center = state.refs.origin.Position
	local delta = root.Position - center
	-- Nur horizontal messen: ein Spieler auf dem Hallendach ist nah genug.
	return Vector2.new(delta.X, delta.Z).Magnitude <= Config.WORLD.PURCHASE_RADIUS
end

-- ==========================================================================
-- Optik an den Kaufzustand anpassen
-- ==========================================================================

local function isAvailable(purchased: { [string]: boolean }, def: Types.UpgradeDef): boolean
	for _, requirement in ipairs(def.requires) do
		if not purchased[requirement] then
			return false
		end
	end
	return true
end

PlotService.isAvailable = isAvailable

--[[
	Setzt saemtliche sichtbaren Eigenschaften eines Plots neu.
	Bewusst idempotent und komplett: es gibt keine "Teil-Aktualisierung",
	weil genau dort die Fehler entstehen (Plot wird recycelt, ein Rest
	vom Vorbesitzer bleibt stehen).
]]
function PlotService.refresh(state: PlotState)
	local refs = state.refs
	local owner = state.owner
	local data = if owner ~= nil then DataService.get(owner) else nil
	local purchased: { [string]: boolean } = if data ~= nil then data.purchased else {}

	-- Claim-Pad
	if owner ~= nil then
		refs.claimTitle.Text = owner.DisplayName
		refs.claimTitle.TextColor3 = C.success
		refs.claimSub.Text = `Fabrik #{state.index}`
		refs.claimPad.Color = C.success
	else
		refs.claimTitle.Text = `FREI #{state.index}`
		refs.claimTitle.TextColor3 = C.premium
		refs.claimSub.Text = "Wird beim Beitritt vergeben"
		refs.claimPad.Color = C.premium
	end

	-- Dropper: der Startdropper steht, sobald der Plot vergeben ist.
	for id, parts in pairs(refs.dropperBodies) do
		local active = if id == "__base" then owner ~= nil else (purchased[id] == true)
		for _, part in ipairs(parts) do
			part.Transparency = if active then Theme.Alpha.opaque else Theme.Alpha.hidden
			part.CanCollide = active and part.Name ~= "Nozzle"
		end
	end

	-- Veredler
	for id, upgrader in pairs(refs.upgraders) do
		local active = purchased[id] == true
		upgrader.field.Transparency = if active then Theme.Alpha.veil else Theme.Alpha.hidden
		for _, part in ipairs(upgrader.frame) do
			part.Transparency = if active then Theme.Alpha.opaque else Theme.Alpha.hidden
			part.CanCollide = active and part.Name ~= "Lamp"
		end
	end

	-- Halle, Dach, Licht
	local wallsOn = purchased.walls == true
	local roofOn = purchased.roof == true
	for _, part in ipairs(refs.hall) do
		local visible = if part.Name == "HallRoof" or part.Name == "Lamp" then roofOn else wallsOn
		part.Transparency = if visible
			then (if part.Name == "HallRoof" then Theme.Alpha.glass else Theme.Alpha.opaque)
			else Theme.Alpha.hidden
		part.CanCollide = visible and part.Name ~= "Lamp"
	end
	for _, light in ipairs(refs.hallLights) do
		light.Enabled = purchased.lights == true
	end

	-- Bandstreifen nur sichtbar, solange der Plot vergeben ist.
	refs.conveyorBeam.Enabled = owner ~= nil

	-- VIP-Tuer
	local vipBuilt = purchased.vip_room == true
	refs.vipDoor.Transparency = if vipBuilt then Theme.Alpha.veil else Theme.Alpha.hidden
	refs.vipDoor.CanCollide = vipBuilt

	-- Kaufknoepfe: drei klar unterscheidbare Zustaende.
	local cash = if data ~= nil then data.cash else 0
	for id, button in pairs(refs.buttons) do
		local def = button.def
		if purchased[id] then
			-- Gekauft: Knopf versinkt im Boden und verschwindet.
			PlotService.sinkButton(button)
		elseif owner ~= nil and isAvailable(purchased, def) then
			local affordable = cash >= def.price
			PlotService.raiseButton(button)
			button.ring.Color = if affordable then C.primary else C.bg3
			button.ring.Material = if affordable then Theme.Material.neon else Theme.Material.surface
			button.tread.Transparency = if affordable
				then Theme.Alpha.opaque
				else Theme.Alpha.ghost
			button.base.Transparency = if affordable
				then Theme.Alpha.opaque
				else Theme.Alpha.ghost
			button.stroke.Color = if affordable then C.primary else C.bg3
			button.price.TextColor3 = if affordable then C.success else C.textLow
			button.title.TextColor3 = if affordable then C.textHigh else C.textMid
			button.price.Text = `{Format.abbreviate(def.price)} $`
			button.card.BackgroundTransparency = if affordable
				then Theme.Alpha.opaque
				else Theme.Alpha.glass
			button.billboard.Enabled = true
		else
			-- Voraussetzung fehlt: sichtbar, aber eindeutig gesperrt.
			PlotService.raiseButton(button)
			button.ring.Color = C.bg3
			button.ring.Material = Theme.Material.surface
			button.tread.Transparency = Theme.Alpha.ghost
			button.base.Transparency = Theme.Alpha.ghost
			button.stroke.Color = C.bg3
			button.title.TextColor3 = C.textLow
			button.price.TextColor3 = C.textLow
			button.price.Text = "Voraussetzung fehlt"
			button.card.BackgroundTransparency = Theme.Alpha.glass
			button.billboard.Enabled = owner ~= nil
		end
		button.progress.Size = UDim2.fromScale(0, 1)
	end

	-- Rebirth-Schild
	if data ~= nil then
		local cost = Config.rebirthCost(data.rebirths)
		refs.rebirthSub.Text =
			`Rebirth {data.rebirths + 1} - {Format.abbreviate(cost)} $`
	else
		refs.rebirthSub.Text = "-"
	end

	-- Sammler-Zaehler
	refs.collectorSub.Text = if data ~= nil
		then `{Format.abbreviate(data.totalEarned)} $ gesamt`
		else "0 $ gesamt"
end

--[[
	Gekaufter Knopf: versinkt im Boden statt einfach zu verschwinden.
	Der Tween laeuft auf dem Server, weil das Teil dort erzeugt wurde;
	Roblox repliziert die Positionsaenderung an alle Clients.
]]
function PlotService.sinkButton(button: PlotBuilder.ButtonRefs)
	-- Attribut statt Transparenz als Merker: refresh() kann mehrfach
	-- innerhalb der Animationsdauer laufen, und zwei parallele Tweens auf
	-- demselben Teil kaempfen gegeneinander.
	if button.base:GetAttribute("Sunk") == true then
		return
	end
	button.base:SetAttribute("Sunk", true)
	button.billboard.Enabled = false

	local info = Theme.tweenInfo(Theme.Duration.slow, "exit")
	local down = CFrame.new(0, -SINK_DEPTH, 0)
	for _, part in ipairs({ button.base, button.tread, button.ring }) do
		TweenService:Create(part, info, { CFrame = down * part.CFrame }):Play()
		part.CanCollide = false
	end
	for _, part in ipairs(button.bevel) do
		TweenService:Create(part, info, { Transparency = Theme.Alpha.hidden }):Play()
	end
	task.delay(Theme.Duration.slow, function()
		if button.base:GetAttribute("Sunk") ~= true then
			return   -- zwischenzeitlich wieder aufgetaucht (Rebirth)
		end
		button.base.Transparency = Theme.Alpha.hidden
		button.tread.Transparency = Theme.Alpha.hidden
		button.ring.Transparency = Theme.Alpha.hidden
	end)
end

-- Gegenstueck: setzt einen versenkten Knopf zurueck (Rebirth, Plotwechsel).
function PlotService.raiseButton(button: PlotBuilder.ButtonRefs)
	button.base:SetAttribute("Sunk", nil)
	button.base.CFrame = button.homeCFrame
	button.tread.CFrame = button.homeCFrame * CFrame.new(0, 0.85, 0)
	button.ring.CFrame = button.homeCFrame * CFrame.new(0, 0.7, 0)
		* CFrame.Angles(0, 0, math.rad(90))
	button.ring.Transparency = Theme.Alpha.opaque
	button.base.CanCollide = true
	button.tread.CanCollide = true
	for _, part in ipairs(button.bevel) do
		part.Transparency = Theme.Alpha.opaque
	end
end

-- Fortschrittsring beim Draufstehen (0 bis 1).
function PlotService.setButtonProgress(button: PlotBuilder.ButtonRefs, ratio: number)
	button.progress.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
end

function PlotService.refreshFor(player: Player)
	local state = byPlayer[player]
	if state ~= nil then
		PlotService.refresh(state)
	end
end

-- Bandgeschwindigkeit nach einem Band-Upgrade neu setzen.
function PlotService.applyConveyorSpeed(state: PlotState, speed: number)
	state.conveyorSpeed = speed
	for _, belt in ipairs(state.refs.conveyors) do
		belt.AssemblyLinearVelocity = Vector3.new(speed, 0, 0)
	end
end

-- ==========================================================================
-- Zuweisen und Freigeben
-- ==========================================================================

local function clearOres(state: PlotState)
	for _, ore in ipairs(state.refs.ores:GetChildren()) do
		ore:Destroy()
	end
	state.oreCount = 0
end

function PlotService.assign(player: Player): PlotState?
	if byPlayer[player] ~= nil then
		return byPlayer[player]
	end
	for _, state in ipairs(plots) do
		if state.owner == nil then
			state.owner = player
			byPlayer[player] = state
			clearOres(state)
			PlotService.applyConveyorSpeed(state, Config.ECONOMY.CONVEYOR_BASE_SPEED)
			PlotService.refresh(state)
			player:SetAttribute("PlotIndex", state.index)
			for _, hook in ipairs(assignHooks) do
				hook(state, player)
			end
			Log.info("PlotService", `{player.Name} -> Plot {state.index}`)
			return state
		end
	end
	Log.warn("PlotService", `Kein freier Plot fuer {player.Name}`)
	return nil
end

function PlotService.release(player: Player)
	local state = byPlayer[player]
	if state == nil then
		return
	end
	byPlayer[player] = nil
	state.owner = nil
	-- Alles, was waehrend des Besitzes verbunden wurde, faellt hier weg.
	state.trove:clean()
	clearOres(state)
	state.conveyorSpeed = Config.ECONOMY.CONVEYOR_BASE_SPEED
	PlotService.applyConveyorSpeed(state, state.conveyorSpeed)
	PlotService.refresh(state)
	player:SetAttribute("PlotIndex", nil)
	Log.info("PlotService", `Plot {state.index} freigegeben`)
end

-- Setzt den Plot auf den Startzustand zurueck, ohne den Besitzer zu wechseln
-- (wird beim Rebirth gebraucht).
function PlotService.resetKeepOwner(state: PlotState)
	clearOres(state)
	PlotService.applyConveyorSpeed(state, Config.ECONOMY.CONVEYOR_BASE_SPEED)
	PlotService.refresh(state)
end

function PlotService.teleportToPlot(player: Player)
	local state = byPlayer[player]
	if state == nil then
		return
	end
	local character = player.Character
	if character == nil then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root ~= nil and root:IsA("BasePart") then
		root.CFrame = state.refs.spawnCFrame
	end
end

-- ==========================================================================
-- Lifecycle
-- ==========================================================================

function PlotService.Init()
	local folder = Instance.new("Folder")
	folder.Name = "Plots"
	folder.Parent = workspace

	local world = Config.WORLD
	local columns = world.PLOT_COLUMNS
	local rows = math.ceil(world.PLOT_COUNT / columns)

	for index = 1, world.PLOT_COUNT do
		local col = (index - 1) % columns
		local row = math.floor((index - 1) / columns)
		local x = (col - (columns - 1) / 2) * world.PLOT_SPACING_X
		local z = (row - (rows - 1) / 2) * world.PLOT_SPACING_Z
		local origin = CFrame.new(x, 0, z)
		local refs = PlotBuilder.build(index, origin, folder)
		plots[index] = {
			index = index,
			refs = refs,
			owner = nil,
			trove = Trove.new(),
			oreCount = 0,
			conveyorSpeed = Config.ECONOMY.CONVEYOR_BASE_SPEED,
		}
		PlotService.refresh(plots[index])
	end
	Log.info("PlotService", `{world.PLOT_COUNT} Plots gebaut`)
end

function PlotService.Start()
	local function setup(player: Player)
		-- Erst das Profil abwarten: ohne Daten wuerde refresh() alle
		-- gekauften Upgrades als "nicht gekauft" zeichnen und der Spieler
		-- saehe fuer einen Moment einen leeren Plot.
		DataService.await(player, 20)
		if player.Parent == nil then
			return
		end
		PlotService.assign(player)
		if player.Character ~= nil then
			PlotService.teleportToPlot(player)
		end
	end

	Players.PlayerAdded:Connect(function(player: Player)
		task.spawn(setup, player)
		player.CharacterAdded:Connect(function()
			-- Kurz warten, bis der Charakter vollstaendig geladen ist,
			-- sonst laeuft das CFrame-Setzen gegen das Spawn-Verhalten.
			task.wait(0.35)
			PlotService.teleportToPlot(player)
		end)
	end)
	Players.PlayerRemoving:Connect(PlotService.release)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(setup, player)
	end
end

return PlotService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX23">
				<Properties>
					<string name="Name">ProgressionService</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProgressionService – alles, was den Spieler ueber die erste Stunde
	hinaus bindet: Quests/Erfolge, Tagesbelohnung und Codes.

	Zentrale Regel dieses Moduls: JEDE Zeitpruefung laeuft gegen os.time()
	auf dem SERVER. Der Client bekommt nur zu sehen, ob der Knopf
	druckbar ist. Wuerde man dem Client die Zeit glauben, waere die
	Tagesbelohnung mit einer Systemuhr-Aenderung beliebig oft abholbar -
	das ist der klassische Exploit bei genau diesem Feature.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Log = require(Shared.Log)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)

local ProgressionService = {}
ProgressionService.name = "ProgressionService"

local function notify(player: Player, text: string, kind: string)
	Remotes.event("Notify"):FireClient(player, text, kind)
end

local function questById(id: string): Types.QuestDef?
	for _, quest in ipairs(Config.QUESTS) do
		if quest.id == id then
			return quest
		end
	end
	return nil
end

-- ==========================================================================
-- Quest-Zaehler
-- ==========================================================================

--[[
	Erhoeht einen Fortschrittszaehler. Aufrufer sind EconomyService
	(Einnahmen, Kaeufe) und RebirthService. Der Zaehler ist absichtlich
	monoton steigend und wird beim Rebirth NICHT zurueckgesetzt - sonst
	waeren Langzeit-Erfolge nach jedem Rebirth wieder unerreichbar.
]]
function ProgressionService.addMetric(player: Player, metric: string, amount: number)
	local data = DataService.get(player)
	if data == nil or amount <= 0 then
		return
	end
	data.quests[metric] = (data.quests[metric] or 0) + amount
	DataService.markDirty(player)
end

function ProgressionService.setMetric(player: Player, metric: string, value: number)
	local data = DataService.get(player)
	if data == nil then
		return
	end
	if (data.quests[metric] or 0) < value then
		data.quests[metric] = value
		DataService.markDirty(player)
	end
end

function ProgressionService.claimQuest(player: Player, questId: string): (boolean, string)
	local data = DataService.get(player)
	if data == nil then
		return false, "Profil noch nicht geladen."
	end
	local quest = questById(questId)
	if quest == nil then
		return false, "Unbekannte Aufgabe."
	end
	if data.claimedQuests[questId] then
		return false, "Schon abgeholt."
	end
	local progress = data.quests[quest.metric] or 0
	if progress < quest.target then
		return false, `Noch nicht geschafft ({Format.abbreviate(progress)}/{Format.abbreviate(quest.target)}).`
	end
	data.claimedQuests[questId] = true
	data.gems += quest.rewardGems
	DataService.markDirty(player)
	Log.info("Progression", `{player.Name} hat Quest {questId} abgeholt`)
	return true, `+{quest.rewardGems} Gems fuer "{quest.label}"`
end

-- ==========================================================================
-- Tagesbelohnung
-- ==========================================================================

function ProgressionService.dailyReady(player: Player): boolean
	local data = DataService.get(player)
	if data == nil then
		return false
	end
	return os.time() - data.dailyLastClaim >= Config.DAILY.COOLDOWN
end

function ProgressionService.claimDaily(player: Player): (boolean, string)
	local data = DataService.get(player)
	if data == nil then
		return false, "Profil noch nicht geladen."
	end
	local now = os.time()
	local elapsed = now - data.dailyLastClaim
	if elapsed < Config.DAILY.COOLDOWN then
		local remaining = Config.DAILY.COOLDOWN - elapsed
		return false, `Naechste Belohnung in {Format.duration(remaining)}.`
	end

	-- Serie: laeuft weiter, wenn innerhalb von STREAK_RESET abgeholt wird.
	if data.dailyLastClaim > 0 and elapsed <= Config.DAILY.STREAK_RESET then
		data.dailyStreak = math.min(Config.DAILY.MAX_STREAK, data.dailyStreak + 1)
	else
		data.dailyStreak = 1
	end
	data.dailyLastClaim = now

	local cash = Config.DAILY.BASE_CASH + Config.DAILY.CASH_PER_STREAK * (data.dailyStreak - 1)
	data.cash += cash
	local message = `Tag {data.dailyStreak}: +{Format.abbreviate(cash)} $`
	if data.dailyStreak >= Config.DAILY.MAX_STREAK then
		data.gems += Config.DAILY.GEMS_AT_MAX
		message ..= ` und +{Config.DAILY.GEMS_AT_MAX} Gems`
	end
	DataService.markDirty(player)
	return true, message
end

-- ==========================================================================
-- Codes
-- ==========================================================================

function ProgressionService.redeemCode(player: Player, rawCode: string): (boolean, string)
	local data = DataService.get(player)
	if data == nil then
		return false, "Profil noch nicht geladen."
	end
	-- Normalisieren: Spieler tippen Codes mit Leerzeichen und in Grossbuchstaben.
	local code = string.lower((string.gsub(rawCode, "%s", "")))
	if #code == 0 then
		return false, "Bitte einen Code eingeben."
	end
	local reward = Config.CODES[code]
	if reward == nil then
		return false, "Dieser Code ist ungueltig."
	end
	if data.redeemedCodes[code] then
		return false, "Code bereits eingeloest."
	end

	data.redeemedCodes[code] = true
	local parts: { string } = {}
	if reward.cash ~= nil then
		data.cash += reward.cash
		table.insert(parts, `{Format.abbreviate(reward.cash)} $`)
	end
	if reward.gems ~= nil then
		data.gems += reward.gems
		table.insert(parts, `{reward.gems} Gems`)
	end
	DataService.markDirty(player)
	Log.info("Progression", `{player.Name} hat Code '{code}' eingeloest`)
	return true, "Eingeloest: " .. table.concat(parts, " und ")
end

-- ==========================================================================
-- Lifecycle
-- ==========================================================================

function ProgressionService.Init()
	-- Keine Instanzen noetig; der Dienst arbeitet nur auf Profildaten.
end

function ProgressionService.Start()
	-- Spielzeit zaehlen. Laeuft absichtlich als eigener Thread mit grober
	-- Aufloesung statt im Scheduler: eine Sekunde Genauigkeit reicht voellig
	-- und belastet den Tick nicht.
	task.spawn(function()
		while true do
			task.wait(10)
			DataService.forEach(function(player: Player, data: Types.ProfileData)
				data.playtime += 10
				data.quests.playtime = data.playtime
			end)
		end
	end)
	Log.info("Progression", `{#Config.QUESTS} Quests, {#Config.GEM_PRODUCTS} Gem-Pakete aktiv`)
end

-- Benachrichtigung nach aussen sichtbar machen (RebirthService nutzt sie).
ProgressionService.notify = notify

return ProgressionService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX24">
				<Properties>
					<string name="Name">RebirthService</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RebirthService – Prestige-Schleife.

	Der Spieler tauscht seinen gesamten Fortschritt (Cash + alle gekauften
	Upgrades) gegen einen dauerhaften Einkommensmultiplikator und Gems.

	Was NICHT zurueckgesetzt wird und warum:
	  * Gems          – Hartwaehrung; ein Reset waere faktisch Enteignung.
	  * totalEarned   – Lebenszeit-Statistik, treibt das Leaderboard.
	  * Quests/Codes  – Langzeitziele muessen Rebirths ueberleben, sonst
	                    sind "verdiene 1 Mio" und "5 Rebirths" unerreichbar.
	  * Tagesserie    – haengt an Kalendertagen, nicht am Fortschritt.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Log = require(Shared.Log)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local ProgressionService = require(script.Parent.ProgressionService)

local RebirthService = {}
RebirthService.name = "RebirthService"

function RebirthService.cost(player: Player): number
	local data = DataService.get(player)
	if data == nil then
		return Config.REBIRTH.BASE_COST
	end
	return Config.rebirthCost(data.rebirths)
end

--[[
	Fuehrt einen Rebirth aus. Rueckgabe (ok, Meldung).
	Alle Pruefungen serverseitig - der Client schickt nur die Absicht.
]]
function RebirthService.perform(player: Player): (boolean, string)
	local data = DataService.get(player)
	if data == nil then
		return false, "Profil noch nicht geladen."
	end
	local state = PlotService.forPlayer(player)
	if state == nil then
		return false, "Du hast noch keine Fabrik."
	end

	local cost = Config.rebirthCost(data.rebirths)
	if data.cash < cost then
		return false, `Du brauchst {Format.abbreviate(cost)} $ fuer den naechsten Rebirth.`
	end

	data.rebirths += 1
	data.cash = Config.ECONOMY.START_CASH
	data.gems += Config.REBIRTH.GEMS_PER
	-- Kompletter Neuaufbau der Fabrik: Tabelle ersetzen statt Felder zu
	-- loeschen, damit garantiert kein Eintrag uebrigbleibt.
	data.purchased = {}
	DataService.markDirty(player)

	ProgressionService.setMetric(player, "rebirths", data.rebirths)
	EconomyService.invalidate(player)
	PlotService.resetKeepOwner(state)
	PlotService.refresh(state)

	Remotes.event("PlaySfx"):FireClient(player, "rebirth")
	Log.info("Rebirth", `{player.Name} -> Rebirth {data.rebirths}`)

	local mult = Config.rebirthMultiplier(data.rebirths)
	return true, `Rebirth {data.rebirths}! Einkommen jetzt x{string.format("%.2f", mult)}`
end

function RebirthService.Init()
	-- Die Rebirth-Pads baut PlotBuilder; hier gibt es nichts anzulegen.
end

function RebirthService.Start()
	-- Rebirth-Pad auf jedem Plot verbinden. Einmalig beim Start, nicht
	-- bei jedem Besitzerwechsel - das Pad gehoert zum Plot, nicht zum Spieler.
	-- Cooldown je Plot, nicht je Spieler: eine spielergeschluesselte Tabelle
	-- in dieser Closure wuerde ueber die gesamte Serverlaufzeit wachsen,
	-- weil sie beim Verlassen niemand leert. Pro Plot gibt es ohnehin nur
	-- einen Besitzer, der das Pad ausloesen kann.
	local lastTouch: { [number]: number } = {}
	PlotService.onAssign(function(state: PlotService.PlotState)
		lastTouch[state.index] = 0
	end)

	for _, state in ipairs(PlotService.all()) do
		state.refs.rebirthPad.Touched:Connect(function(hit: BasePart)
			local owner = state.owner
			if owner == nil then
				return
			end
			local character = hit.Parent
			if character == nil or owner.Character ~= character then
				return
			end
			local now = os.clock()
			local previous = lastTouch[state.index]
			if previous ~= nil and now - previous > 0 and now - previous < 3 then
				return
			end
			lastTouch[state.index] = now
			local ok, message = RebirthService.perform(owner)
			Remotes.event("Notify"):FireClient(owner, message, if ok then "success" else "error")
		end)
	end
end

return RebirthService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX25">
				<Properties>
					<string name="Name">RemoteGuard</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RemoteGuard – die Tuersteher-Schicht vor jedem eingehenden Remote.

	Grundsatz des Projekts: der Client sendet ausschliesslich ABSICHTEN
	("ich will Upgrade X kaufen"). Er sendet nie Betraege, nie Ergebnisse,
	nie Zustaende. Alles, was hier ankommt, gilt als potenziell gefaelscht.

	Jeder Handler laeuft durch drei Pruefungen, bevor er die Fachlogik sieht:
	  1. Rate-Limit  – schuetzt den Server vor Remote-Spam in Schleifen.
	  2. Typpruefung – ein Exploiter kann statt eines Strings eine Tabelle,
	                   eine Instanz oder nil senden; ungeprueft fliegt die
	                   Fachlogik dann mit einem Laufzeitfehler auseinander.
	  3. pcall       – ein Fehler in der Fachlogik darf weder den Remote-
	                   Thread killen noch den Output fluten.

	Distanz- und Besitzpruefungen gehoeren NICHT hierher, sondern in die
	jeweilige Fachlogik, weil nur die weiss, was "nah genug" bedeutet.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Log = require(Shared.Log)
local RateLimiter = require(Shared.RateLimiter)
local Remotes = require(Shared.Remotes)

local RemoteGuard = {}
RemoteGuard.name = "RemoteGuard"

-- Validator: bekommt die Rohargumente, gibt die geprueften zurueck oder nil.
export type Validator = (...any) -> ...any

-- Haeufigster Fall: genau ein String mit Laengenbegrenzung.
function RemoteGuard.stringArg(maxLength: number): Validator
	return function(value: any): ...any
		if typeof(value) ~= "string" then
			return nil
		end
		if #value == 0 or #value > maxLength then
			return nil
		end
		return value
	end
end

-- Kein Argument erwartet. Alles, was trotzdem kommt, wird verworfen.
function RemoteGuard.noArgs(): Validator
	return function(): ...any
		return true
	end
end

local function limitFor(name: string): number
	local limit = (Config.RATE_LIMITS :: { [string]: number })[name]
	-- Unbekannte Remotes bekommen absichtlich ein sehr enges Budget,
	-- damit ein vergessener Eintrag nicht zur offenen Tuer wird.
	return limit or 1
end

--[[
	Bindet einen Handler an ein RemoteEvent (Client -> Server, ohne Rueckgabe).
]]
function RemoteGuard.bindEvent(name: string, validator: Validator, handler: (player: Player, ...any) -> ())
	local remote = Remotes.event(name)
	local limit = limitFor(name)
	remote.OnServerEvent:Connect(function(player: Player, ...: any)
		if not RateLimiter.consume(player.UserId, name, limit) then
			Log.throttled(`rl_{name}_{player.UserId}`, 10, 2, "RemoteGuard",
				`Rate-Limit fuer {player.Name} auf {name}`)
			return
		end
		local checked = table.pack(validator(...))
		if checked.n == 0 or checked[1] == nil then
			Log.throttled(`bad_{name}_{player.UserId}`, 10, 2, "RemoteGuard",
				`Ungueltige Argumente von {player.Name} auf {name}`)
			return
		end
		local ok, err = pcall(function(): string?
			handler(player, table.unpack(checked, 1, checked.n))
			return nil
		end)
		if not ok then
			Log.throttled(`err_{name}`, 5, 3, "RemoteGuard",
				`Handler '{name}' fehlgeschlagen: {tostring(err)}`)
		end
	end)
end

--[[
	Bindet einen Handler an eine RemoteFunction. Der Rueckgabewert ist immer
	(ok: boolean, message: string) - die UI zeigt die Nachricht direkt an.
	Bei Rate-Limit oder Fehler wird bewusst eine neutrale Meldung geliefert,
	statt intern Auskunft zu geben.
]]
function RemoteGuard.bindFunction(
	name: string,
	validator: Validator,
	handler: (player: Player, ...any) -> (boolean, string)
)
	local remote = Remotes.fn(name)
	local limit = limitFor(name)
	remote.OnServerInvoke = function(player: Player, ...: any): (boolean, string)
		if not RateLimiter.consume(player.UserId, name, limit) then
			return false, "Zu schnell - bitte kurz warten."
		end
		local checked = table.pack(validator(...))
		if checked.n == 0 or checked[1] == nil then
			return false, "Ungueltige Eingabe."
		end
		local ok, a, b = pcall(handler, player, table.unpack(checked, 1, checked.n))
		if not ok then
			Log.throttled(`err_{name}`, 5, 3, "RemoteGuard",
				`Handler '{name}' fehlgeschlagen: {tostring(a)}`)
			return false, "Da ist etwas schiefgelaufen."
		end
		return (a :: boolean), (b :: string)
	end
end

return RemoteGuard
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX26">
				<Properties>
					<string name="Name">StateService</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	StateService – die einzige Stelle, an der Serverzustand zum Client geht.

	Warum gebuendelt statt "jeder Dienst feuert selbst":
	  * Ein Kauf aendert Cash, den gekauften Satz, die verfuegbaren Buttons,
	    das Einkommen und moeglicherweise einen Quest-Zaehler. Fuenf
	    Einzelnachrichten pro Kauf waeren Netzwerklast ohne Nutzen.
	  * Ohne zentrale Stelle wuerde frueher oder spaeter ein Dienst etwas
	    schicken, das der Client nicht wissen darf.

	Ablauf: Dienste setzen ueber DataService.markDirty() nur ein Flag.
	Dieser Dienst prueft es mit STATE_PUSH_HZ und schickt dann genau einen
	vollstaendigen Schnappschuss. Dadurch gibt es keinen Abhaengigkeits-
	zyklus - kein Dienst braucht eine Referenz auf StateService.

	Hier haengen ausserdem alle eingehenden Remotes, damit man in EINER
	Datei sieht, was der Client ueberhaupt ausloesen kann.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Log = require(Shared.Log)
local RateLimiter = require(Shared.RateLimiter)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local MonetizationService = require(script.Parent.MonetizationService)
local PlotService = require(script.Parent.PlotService)
local ProgressionService = require(script.Parent.ProgressionService)
local RebirthService = require(script.Parent.RebirthService)
local RemoteGuard = require(script.Parent.RemoteGuard)
local TickScheduler = require(script.Parent.TickScheduler)

local StateService = {}
StateService.name = "StateService"

-- ==========================================================================
-- leaderstats (die eingebaute Roblox-Rangliste oben rechts)
-- ==========================================================================

local function ensureLeaderstats(player: Player): (IntValue, IntValue)
	local existing = player:FindFirstChild("leaderstats")
	if existing ~= nil then
		local cash = existing:FindFirstChild("Cash")
		local rebirths = existing:FindFirstChild("Rebirths")
		if cash ~= nil and cash:IsA("IntValue") and rebirths ~= nil and rebirths:IsA("IntValue") then
			return cash, rebirths
		end
		existing:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = folder

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder

	folder.Parent = player
	return cash, rebirths
end

-- ==========================================================================
-- Schnappschuss
-- ==========================================================================

local function snapshot(player: Player, data: Types.ProfileData): Types.ClientState
	local available: { [string]: boolean } = {}
	for _, def in ipairs(Config.UPGRADES) do
		if not data.purchased[def.id] and PlotService.isAvailable(data.purchased, def) then
			available[def.id] = true
		end
	end

	local state = PlotService.forPlayer(player)

	return {
		cash = data.cash,
		gems = data.gems,
		rebirths = data.rebirths,
		totalEarned = data.totalEarned,
		incomePerSecond = EconomyService.incomePerSecond(player),
		purchased = data.purchased,
		available = available,
		plotIndex = if state ~= nil then state.index else nil,
		rebirthCost = Config.rebirthCost(data.rebirths),
		rebirthMultiplier = Config.rebirthMultiplier(data.rebirths),
		nextRebirthMultiplier = Config.rebirthMultiplier(data.rebirths + 1),
		dailyReady = ProgressionService.dailyReady(player),
		dailyStreak = data.dailyStreak,
		quests = data.quests,
		claimedQuests = data.claimedQuests,
		owns2xCash = MonetizationService.owns2xCash(player),
		ownsVip = MonetizationService.ownsVip(player),
	}
end

local function push(player: Player)
	local data = DataService.get(player)
	if data == nil then
		return
	end
	local cash, rebirths = ensureLeaderstats(player)
	cash.Value = math.clamp(math.floor(data.cash), -2147483648, 2147483647)
	rebirths.Value = data.rebirths
	Remotes.event("StateChanged"):FireClient(player, snapshot(player, data))
end

function StateService.pushNow(player: Player)
	push(player)
end

-- ==========================================================================
-- Eingehende Remotes
-- ==========================================================================

local function bindRemotes()
	RemoteGuard.bindEvent("RequestPurchase", RemoteGuard.stringArg(64),
		function(player: Player, upgradeId: any)
			local ok, message = EconomyService.purchase(player, upgradeId :: string)
			Remotes.event("Notify"):FireClient(player, message, if ok then "success" else "error")
		end)

	RemoteGuard.bindEvent("RequestRebirth", RemoteGuard.noArgs(),
		function(player: Player)
			local ok, message = RebirthService.perform(player)
			Remotes.event("Notify"):FireClient(player, message, if ok then "success" else "error")
		end)

	RemoteGuard.bindEvent("PromptGemProduct", RemoteGuard.stringArg(32),
		function(player: Player, productKey: any)
			MonetizationService.promptGemProduct(player, productKey :: string)
		end)

	RemoteGuard.bindFunction("RedeemCode", RemoteGuard.stringArg(32),
		function(player: Player, code: any): (boolean, string)
			return ProgressionService.redeemCode(player, code :: string)
		end)

	RemoteGuard.bindFunction("ClaimDaily", RemoteGuard.noArgs(),
		function(player: Player): (boolean, string)
			return ProgressionService.claimDaily(player)
		end)

	RemoteGuard.bindFunction("ClaimQuest", RemoteGuard.stringArg(64),
		function(player: Player, questId: any): (boolean, string)
			return ProgressionService.claimQuest(player, questId :: string)
		end)
end

-- ==========================================================================
-- Lifecycle
-- ==========================================================================

function StateService.Init()
	-- Remotes existieren bereits (Bootstrap ruft Remotes.initServer auf),
	-- gebunden wird erst in Start().
end

function StateService.Start()
	bindRemotes()

	Players.PlayerAdded:Connect(function(player: Player)
		task.spawn(function()
			-- Auf das Profil warten, sonst wuerde der erste Schnappschuss
			-- Nullwerte enthalten und die UI kurz "0 $" zeigen, obwohl
			-- der Spieler Millionen hat.
			if DataService.await(player, 25) ~= nil then
				push(player)
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		RateLimiter.clear(player.UserId)
	end)

	-- Regelmaessig, aber nur bei Aenderung senden.
	TickScheduler.every("statepush", Config.ECONOMY.STATE_PUSH_HZ, function()
		for _, player in ipairs(Players:GetPlayers()) do
			if DataService.consumeDirty(player) then
				push(player)
			end
		end
	end)

	-- Zusaetzlich alle 5 s ein Vollabgleich. Faengt den Fall ab, dass eine
	-- Aenderung ohne markDirty passiert ist, und haelt Einkommen und
	-- Tagesbelohnungs-Countdown in der UI aktuell.
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in ipairs(Players:GetPlayers()) do
				push(player)
			end
		end
	end)

	Log.info("StateService", "Remotes gebunden, Replikation laeuft")
end

return StateService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX27">
				<Properties>
					<string name="Name">TickScheduler</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	TickScheduler – der EINZIGE Heartbeat des Servers.

	Warum das wichtig ist: 6 Plots x 7 Droppern x eigener Verbindung waeren
	42 Heartbeat-Handler, die 60-mal pro Sekunde feuern. Das kostet auf einem
	Mittelklasse-Android messbar Frames, weil jeder Handler einen eigenen
	Luau-Kontextwechsel ausloest. Stattdessen laeuft hier genau eine
	Heartbeat-Verbindung, die alle Aufgaben in festen Frequenzen
	batchweise abarbeitet.

	Fehlerpolitik: eine geworfene Aufgabe darf den Scheduler nicht killen und
	den Output nicht fluten. Deshalb pcall + gedrosseltes Log + Abschaltung
	nach zu vielen Fehlern in Folge.
]]

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Log = require(Shared.Log)

type Task = {
	name: string,
	period: number,
	accum: number,
	fn: (dt: number) -> (),
	failures: number,
	disabled: boolean,
}

local MAX_CONSECUTIVE_FAILURES = 10

local TickScheduler = {}
TickScheduler.name = "TickScheduler"

local tasks: { Task } = {}
local connection: RBXScriptConnection? = nil

--[[
	Registriert eine Aufgabe mit fester Frequenz.
	hz = Aufrufe pro Sekunde. Die Aufgabe bekommt die tatsaechlich
	vergangene Zeit als Argument, nicht die Soll-Periode - so bleibt die
	Oekonomie auch bei Serverlast korrekt (kein Einkommensverlust bei Lag).
]]
function TickScheduler.every(name: string, hz: number, fn: (dt: number) -> ())
	assert(hz > 0, "hz muss > 0 sein")
	table.insert(tasks, {
		name = name,
		period = 1 / hz,
		accum = 0,
		fn = fn,
		failures = 0,
		disabled = false,
	})
	Log.debug("TickScheduler", `Aufgabe registriert: {name} @ {hz} Hz`)
end

function TickScheduler.Init()
	-- Nichts zu verdrahten: Aufgaben registrieren sich selbst ueber every().
end

function TickScheduler.Start()
	assert(connection == nil, "TickScheduler laeuft bereits")
	connection = RunService.Heartbeat:Connect(function(dt: number)
		-- Die Schleifenvariable heisst bewusst NICHT 'task': sie wuerde
		-- sonst die globale task-Bibliothek beschatten, und ein spaeter
		-- eingefuegtes task.spawn in diesem Block wuerde stillschweigend
		-- auf die Aufgabentabelle zugreifen.
		for _, entry in ipairs(tasks) do
			if entry.disabled then
				continue
			end
			entry.accum += dt
			if entry.accum < entry.period then
				continue
			end
			local elapsed = entry.accum
			entry.accum = 0

			local ok, err = pcall(function(): string?
				entry.fn(elapsed)
				return nil
			end)
			if ok then
				entry.failures = 0
			else
				entry.failures += 1
				Log.throttled(
					"tick_" .. entry.name, 5, 3, "TickScheduler",
					`Aufgabe '{entry.name}' fehlgeschlagen ({entry.failures}x): {tostring(err)}`
				)
				if entry.failures >= MAX_CONSECUTIVE_FAILURES then
					entry.disabled = true
					Log.error("TickScheduler",
						`Aufgabe '{entry.name}' nach {MAX_CONSECUTIVE_FAILURES} Fehlern abgeschaltet`)
				end
			end
		end
	end)
	Log.info("TickScheduler", `gestartet mit {#tasks} Aufgaben`)
end

function TickScheduler.Stop()
	if connection ~= nil then
		connection:Disconnect()
		connection = nil
	end
end

return TickScheduler
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX28">
				<Properties>
					<string name="Name">WorldService</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	WorldService – Lobby, Beleuchtung, Ambiente und die Bestenlisten-Tafel.

	Die Welt wird per Code gebaut statt im Place gespeichert. Grund:
	die Geometrie ist vollstaendig aus Config ableitbar, und eine im XML
	eingefrorene Lobby waere bei jeder Layoutaenderung ein Merge-Konflikt.
	Ausserdem bleibt das Place-File dadurch klein und uebersichtlich.
]]

local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Log = require(Shared.Log)
local Theme = require(Shared.Theme)

local C = Theme.Color
local M = Theme.Material

local WorldService = {}
WorldService.name = "WorldService"


local function part(name: string, size: Vector3, cf: CFrame, color: Color3,
	material: Enum.Material, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Reflectance = Theme.Reflectance.none
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = false
	p.Parent = parent
	return p
end

-- ==========================================================================
-- Beleuchtung
-- ==========================================================================

local function setupLighting()
	--[[
		Zurueckhaltend dosiert: das Bild soll lesbar bleiben und nicht wie
		ein Instagram-Filter wirken. Die Zahlen sind aufeinander abgestimmt -
		ein hoeherer Bloom braucht eine hoehere Threshold, sonst glueht auch
		die Textur; eine hoehere Saturation macht das Indigo der Oberflaeche
		giftig.
	]]
	Lighting.Ambient = C.bg1
	Lighting.OutdoorAmbient = C.bg3
	Lighting.Brightness = 2
	Lighting.ClockTime = 15.5          -- weiches Seitenlicht statt Mittagssonne
	Lighting.GeographicLatitude = 22
	Lighting.ExposureCompensation = 0.2
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 3500

	if Lighting:FindFirstChildOfClass("Atmosphere") == nil then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.3
		atmosphere.Offset = 0.1
		atmosphere.Haze = 1.2
		atmosphere.Glare = 0.12
		atmosphere.Color = C.textMid
		atmosphere.Decay = C.bg3
		atmosphere.Parent = Lighting
	end

	if Lighting:FindFirstChildOfClass("ColorCorrectionEffect") == nil then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "WorldGrade"
		cc.Brightness = 0.01
		cc.Contrast = 0.05
		cc.Saturation = 0.08
		cc.TintColor = C.textHigh
		cc.Parent = Lighting
	end

	if Lighting:FindFirstChildOfClass("BloomEffect") == nil then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.4
		bloom.Size = 20
		bloom.Threshold = 1.1
		bloom.Parent = Lighting
	end

	if Lighting:FindFirstChildOfClass("SunRaysEffect") == nil then
		local rays = Instance.new("SunRaysEffect")
		-- Sehr subtil: hoehere Werte legen einen Schleier ueber die Plots.
		rays.Intensity = 0.05
		rays.Spread = 0.6
		rays.Parent = Lighting
	end
end

-- ==========================================================================
-- Ambiente-Sound
-- ==========================================================================

local function setupAmbience()
	local id = Config.SOUNDS.AMBIENCE
	if id == "" then
		-- Bewusst still: es werden keine Asset-Ids erfunden. Sobald in
		-- Config eine echte Id steht, laeuft der Loop automatisch.
		Log.info("World", "Keine Ambience-Id gesetzt - Hintergrundton bleibt aus.")
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Ambience"
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = 0.25
	sound.Parent = SoundService
	sound:Play()
end

-- ==========================================================================
-- Lobby
-- ==========================================================================

local function buildLobby(parent: Folder)
	local world = Config.WORLD
	local center = world.LOBBY_CENTER

	part("LobbyFloor", world.LOBBY_SIZE,
		CFrame.new(center), C.bg2, M.concrete, parent)

	-- Grosse Grundflaeche, damit man zwischen Lobby und Plots laufen kann.
	part("Ground", Vector3.new(1600, 8, 1200),
		CFrame.new(0, -4, 0), C.bg1, M.rock, parent)

	local spawnPad = Instance.new("SpawnLocation")
	spawnPad.Name = "LobbySpawn"
	spawnPad.Size = Vector3.new(18, 1, 18)
	spawnPad.CFrame = CFrame.new(center + Vector3.new(0, 1.5, 0))
	spawnPad.Color = C.premium
	spawnPad.Material = M.neon
	spawnPad.Anchored = true
	spawnPad.Duration = 0
	spawnPad.Parent = parent

	-- Titel-Schild ueber dem Spawn
	local pylon = part("TitlePylon", Vector3.new(2, 14, 2),
		CFrame.new(center + Vector3.new(0, 8, -38)), C.bg2, M.metal, parent)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(40, 11)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 10, 0)
	billboard.MaxDistance = Theme.Size.worldSignOffset * 100
	billboard.LightInfluence = 0
	billboard.Parent = pylon

	local titleCard = Theme.Card({
		name = "Card", parent = billboard, size = UDim2.fromScale(1, 1),
		fill = C.bg1, radius = Theme.Radius.panel, strokeColor = C.premium,
		zIndex = Theme.Layer.world, shadow = false,
	})
	Theme.padding(titleCard, { all = Theme.Space.x12 })
	Theme.label({
		name = "Title", parent = titleCard, text = string.upper(Config.GAME_NAME),
		role = "display", size = Theme.TextSize.display, color = C.premium,
		layoutSize = UDim2.fromScale(1, 0.56),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = Theme.Layer.world + Theme.Depth.content,
	})
	Theme.label({
		name = "Sub", parent = titleCard,
		text = "Deine Fabrik wartet - lauf einfach los", role = "body",
		size = Theme.TextSize.lg, color = C.textMid,
		layoutSize = UDim2.fromScale(1, 0.36),
		position = UDim2.fromScale(0, 0.6),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = Theme.Layer.world + Theme.Depth.content, stroke = false,
	})
end

-- ==========================================================================
-- Bestenlisten-Tafel
-- ==========================================================================

export type Entry = { rank: number, userId: number, name: string, amount: string }

type RowRefs = {
	frame: Frame,
	medal: Frame,
	rankLabel: TextLabel,
	avatar: ImageLabel,
	nameLabel: TextLabel,
	amountLabel: TextLabel,
}

local rows: { RowRefs } = {}

-- Rang 1 bis 3 bekommen Medaillenfarben, alle aus der Warm-Familie.
local function medalColor(rank: number): Color3
	if rank == 1 then
		return C.premium
	elseif rank == 2 then
		return C.textMid
	elseif rank == 3 then
		return C.premiumDeep
	end
	return C.bg3
end

local function buildLeaderboard(parent: Folder)
	local center = Config.WORLD.LOBBY_CENTER
	local board = part("LeaderboardBoard", Vector3.new(1, 42, 30),
		CFrame.new(center + Vector3.new(-56, 21, 0)), C.bg0, M.surface, parent)

	local surface = Instance.new("SurfaceGui")
	surface.Name = "Board"
	surface.Face = Enum.NormalId.Right
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 28
	surface.LightInfluence = 0
	surface.MaxDistance = Theme.Size.worldSignOffset * 44
	surface.Parent = board

	local background = Theme.Card({
		name = "Bg", parent = surface, size = UDim2.fromScale(1, 1),
		fill = C.bg1, radius = Theme.Radius.panel, strokeColor = C.premiumDeep,
		zIndex = Theme.Layer.world, shadow = false,
	})
	Theme.padding(background, { all = Theme.Space.x16 })

	Theme.label({
		name = "Heading", parent = background,
		text = "TOP " .. tostring(Config.LEADERBOARD.TOP_N), role = "display",
		size = Theme.TextSize.xxl, color = C.premium,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x48),
		zIndex = Theme.Layer.world + Theme.Depth.content,
	})
	Theme.label({
		name = "Sub", parent = background, text = "Gesamtverdienst", role = "body",
		size = Theme.TextSize.md, color = C.textLow,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x24),
		position = UDim2.fromOffset(0, Theme.Space.x48),
		zIndex = Theme.Layer.world + Theme.Depth.content, stroke = false,
	})

	local list = Instance.new("ScrollingFrame")
	list.Name = "Rows"
	list.Size = UDim2.new(1, 0, 1, -(Theme.Space.x48 + Theme.Space.x32))
	list.Position = UDim2.fromOffset(0, Theme.Space.x48 + Theme.Space.x24)
	list.BackgroundTransparency = Theme.Alpha.hidden
	list.BorderSizePixel = 0
	list.ScrollBarThickness = Theme.Size.scrollBar
	list.ScrollBarImageColor3 = C.premiumDeep
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ZIndex = Theme.Layer.world + Theme.Depth.content
	list.Parent = background
	Theme.list({ parent = list, gap = Theme.Space.x4 })

	for rank = 1, Config.LEADERBOARD.TOP_N do
		-- Abwechselnd getoente Zeilen: ohne das verschwimmt eine
		-- 50-Zeilen-Liste zu einer Flaeche.
		local tinted = rank % 2 == 1
		local row = Instance.new("Frame")
		row.Name = "Row" .. rank
		row.Size = UDim2.new(1, -Theme.Space.x8, 0, Theme.Size.rowHeight)
		row.BackgroundColor3 = if tinted then C.bg2 else C.bg1
		row.BackgroundTransparency = if tinted then Theme.Alpha.opaque else Theme.Alpha.glass
		row.BorderSizePixel = 0
		row.LayoutOrder = rank
		row.Visible = false
		row.ZIndex = Theme.Layer.world + Theme.Depth.content
		row.Parent = list
		Theme.corner(row, Theme.Radius.control)
		Theme.padding(row, { left = Theme.Space.x8, right = Theme.Space.x12 })

		local medal = Instance.new("Frame")
		medal.Name = "Medal"
		medal.Size = UDim2.fromOffset(Theme.Space.x32, Theme.Space.x32)
		medal.Position = UDim2.fromScale(0, 0.5)
		medal.AnchorPoint = Vector2.new(0, 0.5)
		medal.BackgroundColor3 = medalColor(rank)
		medal.BorderSizePixel = 0
		medal.ZIndex = Theme.Layer.world + Theme.Depth.raised
		medal.Parent = row
		Theme.corner(medal, Theme.Radius.pill)

		local rankLabel = Theme.label({
			name = "Rank", parent = medal, text = tostring(rank), role = "numeric",
			size = Theme.TextSize.sm,
			color = if rank <= 3 then C.bg0 else C.textMid,
			layoutSize = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Center,
			zIndex = Theme.Layer.world + Theme.Depth.overlay, stroke = false,
		})

		local avatar = Instance.new("ImageLabel")
		avatar.Name = "Avatar"
		avatar.Size = UDim2.fromOffset(Theme.Space.x32, Theme.Space.x32)
		avatar.Position = UDim2.new(0, Theme.Space.x48, 0.5, 0)
		avatar.AnchorPoint = Vector2.new(0, 0.5)
		avatar.BackgroundColor3 = C.bg3
		avatar.BorderSizePixel = 0
		avatar.ZIndex = Theme.Layer.world + Theme.Depth.raised
		avatar.Parent = row
		Theme.corner(avatar, Theme.Radius.pill)

		local nameLabel = Theme.label({
			name = "Name", parent = row, text = "", role = "heading",
			size = Theme.TextSize.md, color = C.textHigh,
			layoutSize = UDim2.new(1, -(Theme.Space.x48 * 3), 1, 0),
			position = UDim2.fromOffset(Theme.Space.x48 + Theme.Space.x48, 0),
			zIndex = Theme.Layer.world + Theme.Depth.raised,
		})
		local amountLabel = Theme.label({
			name = "Amount", parent = row, text = "", role = "numeric",
			size = Theme.TextSize.md, color = C.success,
			layoutSize = UDim2.new(0, Theme.Size.pillWidth * 0.7, 1, 0),
			position = UDim2.new(1, 0, 0, 0),
			anchor = Vector2.new(1, 0),
			xAlign = Enum.TextXAlignment.Right,
			zIndex = Theme.Layer.world + Theme.Depth.raised,
		})

		rows[rank] = {
			frame = row, medal = medal, rankLabel = rankLabel,
			avatar = avatar, nameLabel = nameLabel, amountLabel = amountLabel,
		}
	end

	local emptyLabel = Theme.label({
		name = "Empty", parent = background,
		text = "Noch keine Eintraege - sei der Erste", role = "body",
		size = Theme.TextSize.lg, color = C.textLow,
		layoutSize = UDim2.fromScale(1, 0.4),
		position = UDim2.fromScale(0, 0.4),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = Theme.Layer.world + Theme.Depth.overlay, stroke = false,
	})
	emptyLabel.Name = "Empty"
end

-- Wird von LeaderboardService aufgerufen.
function WorldService.setLeaderboardRows(entries: { Entry })
	for rank, row in ipairs(rows) do
		local entry: Entry? = entries[rank]
		if entry == nil then
			row.frame.Visible = false
			continue
		end
		row.frame.Visible = true
		row.nameLabel.Text = entry.name
		row.amountLabel.Text = entry.amount .. " $"
		row.rankLabel.Text = tostring(entry.rank)
	end
end

-- Avatarbild nachtragen. Getrennt von setLeaderboardRows, weil die
-- Thumbnail-Abfrage yieldet und die Tafel nicht darauf warten soll.
function WorldService.setLeaderboardAvatar(rank: number, image: string)
	local row = rows[rank]
	if row ~= nil then
		row.avatar.Image = image
	end
end

function WorldService.setLeaderboardEmpty(empty: boolean)
	for _, row in ipairs(rows) do
		if empty then
			row.frame.Visible = false
		end
	end
end

-- ==========================================================================
-- Lifecycle
-- ==========================================================================

function WorldService.Init()
	setupLighting()

	local folder = Instance.new("Folder")
	folder.Name = "World"
	folder.Parent = workspace

	buildLobby(folder)
	buildLeaderboard(folder)
	Log.info("World", "Lobby und Beleuchtung aufgebaut")
end

function WorldService.Start()
	setupAmbience()
end

return WorldService
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX66">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX65">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX64">
				<Properties>
					<string name="Name">Client</string>
				</Properties>
				<Item class="LocalScript" referent="RBX31">
					<Properties>
						<string name="Name">Bootstrap</string>
						<bool name="Disabled">false</bool>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Bootstrap (Client) – baut die Oberflaeche und verteilt Servernachrichten.

	Aufbau der ScreenGui:
	  TycoonUI (ScreenGui, IgnoreGuiInset = false, ResetOnSpawn = false,
	            ZIndexBehavior = Sibling)
	   +- Root (Vollbild, traegt die globale UIScale)
	       +- HUD       Band 100
	       +- Panels    Band 200
	       +- Modal     Band 300 (Backdrop)
	       +- Toasts    Band 400
	       +- Tooltip   Band 500

	IgnoreGuiInset ist bewusst FALSE: dadurch beginnt die Oberflaeche
	unterhalb der Roblox-Topbar, und nichts Klickbares kann darunter
	geraten. Der zusaetzliche Sicherheitsabstand aus Theme.Safe kommt
	obendrauf.

	Der Client haelt keinen eigenen fortgeschriebenen Spielzustand - er
	zeigt den letzten Serverschnappschuss. Zwei Wahrheiten waeren die
	sichere Quelle fuer "UI zeigt genug Geld, Kauf wird trotzdem abgelehnt".
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Log = require(Shared.Log)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local Client = script.Parent
local Effects = require(Client.Effects)
local SoundController = require(Client.SoundController)
local Layers = require(Client.UI.Layers)
local Responsive = require(Client.UI.Responsive)
local Modal = require(Client.UI.Components.Modal)
local Toast = require(Client.UI.Components.Toast)
local Tooltip = require(Client.UI.Components.Tooltip)
local CodesScreen = require(Client.Screens.CodesScreen)
local GemsScreen = require(Client.Screens.GemsScreen)
local Hud = require(Client.Screens.Hud)
local QuestsScreen = require(Client.Screens.QuestsScreen)
local RebirthScreen = require(Client.Screens.RebirthScreen)
local SettingsScreen = require(Client.Screens.SettingsScreen)
local ShopScreen = require(Client.Screens.ShopScreen)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ==========================================================================
-- Geruest
-- ==========================================================================

local gui = Instance.new("ScreenGui")
gui.Name = "TycoonUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = Layers.base("tooltip")
gui.Parent = playerGui

local root = Instance.new("Frame")
root.Name = "Root"
root.Size = UDim2.fromScale(1, 1)
root.BackgroundTransparency = Theme.Alpha.hidden
root.ZIndex = Layers.base("world")
root.Parent = gui

SoundController.init()
Modal.build(root)
Tooltip.build(root)
Effects.build(root)
Toast.build(root, Theme.Safe.top)

local hud = Hud.create(gui, root)
local shop = ShopScreen.create(gui, root)
local rebirth = RebirthScreen.create(gui, root)
local quests = QuestsScreen.create(gui, root)
local codes = CodesScreen.create(gui, root)
local gems = GemsScreen.create(gui, root)
local settings = SettingsScreen.create(gui, root)

-- ==========================================================================
-- Panel-Verwaltung
-- ==========================================================================

type Screen = {
	toggle: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
	update: (state: Types.ClientState) -> (),
}

local screens: { [string]: Screen } = {
	shop = shop,
	rebirth = rebirth,
	quest = quests,
	code = codes,
	upgrade = gems,
	settings = settings,
}

-- Immer nur ein Panel offen: zwei uebereinander sind auf dem Handy nicht
-- mehr bedienbar, und der Backdrop-Zaehler bliebe unuebersichtlich.
local function closeAllExcept(keep: string?)
	for key, screen in pairs(screens) do
		if key ~= keep and screen.isOpen() then
			screen.close()
		end
		hud.setActive(key :: Hud.ButtonKey, key == keep and screen.isOpen())
	end
end

Hud.onButton = function(key: Hud.ButtonKey)
	SoundController.play("click")
	local screen: Screen? = screens[key]
	if screen == nil then
		return
	end
	local willOpen = not screen.isOpen()
	closeAllExcept(if willOpen then key else nil)
	screen.toggle()
	hud.setActive(key, screen.isOpen())
end

Modal.onBackdropClicked = function()
	closeAllExcept(nil)
end

-- ==========================================================================
-- Ausrichtung
-- ==========================================================================

Responsive.attach(gui, root, function(viewport: Responsive.Viewport)
	hud.layout(viewport)
	Toast.setInset(viewport.topInset)
end)

-- ==========================================================================
-- Nachrichten vom Server
-- ==========================================================================

-- Merkt sich den zuletzt abgeschickten Kauf. Der Server antwortet mit
-- einer Notify-Nachricht ohne Id; damit der richtige Slot pulsiert oder
-- ruettelt, wird die Id hier zwischengespeichert.
local lastPurchaseId: string? = nil
local lastCash: number? = nil

ShopScreen.onRequest = function(upgradeId: string)
	lastPurchaseId = upgradeId
end

Remotes.event("StateChanged").OnClientEvent:Connect(function(raw: any)
	-- Der Server ist die einzige Quelle; die Typpruefung faengt nur ein
	-- kaputtes Nachrichtenformat ab, damit daraus kein UI-Fehler wird.
	if typeof(raw) ~= "table" then
		return
	end
	local state = raw :: Types.ClientState
	-- Sammel-Ton am steigenden Guthaben statt an einem Remote pro Erz.
	if lastCash ~= nil and state.cash > lastCash then
		SoundController.play("collect")
	end
	lastCash = state.cash
	hud.update(state)
	for _, screen in pairs(screens) do
		screen.update(state)
	end
end)

Remotes.event("Notify").OnClientEvent:Connect(function(text: any, kind: any)
	if typeof(text) ~= "string" then
		return
	end
	local toastKind: Toast.Kind = if kind == "success" then "success"
		elseif kind == "error" then "error"
		else "info"
	Toast.show(text, toastKind)

	if toastKind == "error" then
		SoundController.play("error")
		-- Zahl blinkt rot statt eines zweiten Popups.
		hud.flashCash()
		if lastPurchaseId ~= nil then
			shop.onPurchaseResult(lastPurchaseId, false)
		end
	elseif toastKind == "success" and lastPurchaseId ~= nil then
		shop.onPurchaseResult(lastPurchaseId, true)
	end
	lastPurchaseId = nil
end)

Remotes.event("PlaySfx").OnClientEvent:Connect(function(key: any)
	if typeof(key) ~= "string" then
		return
	end
	SoundController.play(key)
	if key == "rebirth" then
		Effects.rebirthFlash()
	end
end)

-- ==========================================================================
-- Aufraeumen
-- ==========================================================================

--[[
	Wird beim Verlassen des Spiels aufgerufen. Wichtig fuer den Leak-Test:
	jede Komponente raeumt ihre Tweens und Verbindungen selbst auf, dieser
	Aufruf stoesst die Kette nur an.
]]
local function teardown()
	for _, screen in pairs(screens) do
		screen.close()
	end
	hud.destroy()
	shop.destroy()
	rebirth.destroy()
	quests.destroy()
	codes.destroy()
	gems.destroy()
	settings.destroy()
	Toast.destroy()
	Tooltip.destroy()
	Modal.destroy()
	Effects.destroy()
	gui:Destroy()
end

player.AncestryChanged:Connect(function()
	if player.Parent == nil then
		teardown()
	end
end)

Log.info("Client", "Oberflaeche bereit")
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX32">
					<Properties>
						<string name="Name">Effects</string>
						<bool name="Disabled">false</bool>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Effects – clientseitige Inszenierung fuer grosse Momente.

	Rebirth: kurzer Vollbild-Blitz, dann Kamera-Shake.

	Zum Shake: die Kamera wird NICHT direkt gesetzt, sondern ueber
	`CameraOffset` des Humanoids versetzt. Ein direkt gesetztes
	Camera.CFrame wird vom Standard-Kameraskript im naechsten Frame wieder
	ueberschrieben - der Shake waere unsichtbar oder wuerde flackern.
	CameraOffset addiert der Standard-Kamera einen Versatz und ueberlebt
	deren Update. Das ist der sauberste Weg ohne eigenes Kameraskript.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local Client = script.Parent
local Layers = require(Client.UI.Layers)
local Motion = require(Client.UI.Motion)

local Effects = {}

local flash: Frame? = nil
local scope = Motion.scope()
local shaking = false

local SHAKE_SECONDS = 0.4

function Effects.build(root: GuiObject)
	if flash ~= nil then
		return
	end
	local overlay = Instance.new("Frame")
	overlay.Name = "Flash"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Theme.Color.textHigh
	overlay.BackgroundTransparency = Theme.Alpha.hidden
	overlay.BorderSizePixel = 0
	overlay.Visible = false
	-- Ueber allem ausser dem Tooltip: der Blitz soll die ganze
	-- Oberflaeche ueberstrahlen, aber nichts blockieren.
	overlay.ZIndex = Layers.at("tooltip", Theme.Depth.behind)
	overlay.Active = false
	overlay.Parent = root
	flash = overlay
end

local function humanoid(): Humanoid?
	local character = Players.LocalPlayer.Character
	if character == nil then
		return nil
	end
	local found = character:FindFirstChildOfClass("Humanoid")
	return found
end

--[[
	Kamera-Shake ueber Humanoid.CameraOffset.
	Die Amplitude faellt linear ab, damit der Effekt ausklingt statt
	abrupt zu enden. Am Ende wird der Versatz exakt auf null gesetzt -
	ein Restversatz bliebe sonst dauerhaft stehen.
]]
function Effects.shakeCamera(seconds: number?)
	if Theme.reduceMotion or shaking then
		return
	end
	local target = humanoid()
	if target == nil then
		return
	end
	shaking = true
	local duration = seconds or SHAKE_SECONDS
	task.spawn(function()
		local elapsed = 0
		local amplitude = Theme.Space.x4 / Theme.Space.x8
		local connection: RBXScriptConnection
		connection = RunService.RenderStepped:Connect(function(delta: number)
			elapsed += delta
			local living = humanoid()
			if living == nil or elapsed >= duration then
				connection:Disconnect()
				if living ~= nil then
					living.CameraOffset = Vector3.zero
				end
				shaking = false
				return
			end
			local decay = 1 - elapsed / duration
			local strength = amplitude * decay
			living.CameraOffset = Vector3.new(
				(math.random() - 0.5) * strength * 2,
				(math.random() - 0.5) * strength * 2,
				0
			)
		end)
	end)
end

function Effects.rebirthFlash()
	local overlay = flash
	if overlay == nil then
		return
	end
	if Theme.reduceMotion then
		Effects.shakeCamera()
		return
	end
	overlay.Visible = true
	overlay.BackgroundTransparency = Theme.Alpha.veil
	local fade = scope:to(overlay, { BackgroundTransparency = Theme.Alpha.hidden },
		Theme.Duration.slow, "exit")
	fade.Completed:Once(function()
		overlay.Visible = false
	end)
	Effects.shakeCamera()
end

function Effects.destroy()
	scope:destroy()
	if flash ~= nil then
		flash:Destroy()
		flash = nil
	end
	local target = humanoid()
	if target ~= nil then
		target.CameraOffset = Vector3.zero
	end
end

return Effects
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX33">
					<Properties>
						<string name="Name">SoundController</string>
						<bool name="Disabled">false</bool>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	SoundController – Klang als Teil des Gefuehls.

	Alles laeuft lokal: ein serverseitig abgespielter Kaufklick waere fuer
	alle sechs Spieler hoerbar.

	Zur Tonhoehen-Variation beim Sammeln: bei Dauerfeuer (bis zu acht Erze
	pro Sekunde) ist ein exakt identischer Ton nach zwanzig Sekunden
	unertraeglich. Eine zufaellige Abweichung von 0.95 bis 1.05 im
	PlaybackSpeed reicht, damit das Ohr es als Textur statt als Wiederholung
	hoert. Zusaetzlich gibt es eine Mindestpause, damit sich die Toene
	nicht zu Rauschen aufsummieren.

	Alle SoundIds sind Platzhalter. Ohne Id wird KEIN Sound-Objekt angelegt -
	ein Sound mit leerer SoundId erzeugt beim Abspielen eine Warnung.
]]

local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)

local SoundController = {}

type Entry = { sound: Sound, pitchVary: boolean, minGap: number, lastPlay: number }

local entries: { [string]: Entry } = {}
local ambience: Sound? = nil
local sfxEnabled = true
local ambienceEnabled = true

local function register(key: string, assetId: string, volume: number,
	pitchVary: boolean, minGap: number)
	if assetId == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Sfx_" .. key
	sound.SoundId = assetId
	sound.Volume = volume
	sound.Parent = SoundService
	entries[key] = { sound = sound, pitchVary = pitchVary, minGap = minGap, lastPlay = 0 }
end

function SoundController.setEnabled(value: boolean)
	sfxEnabled = value
end

function SoundController.setAmbienceEnabled(value: boolean)
	ambienceEnabled = value
	local loop = ambience
	if loop == nil then
		return
	end
	if value then
		loop:Play()
	else
		loop:Stop()
	end
end

function SoundController.play(key: string)
	if not sfxEnabled then
		return
	end
	local entry: Entry? = entries[key]
	if entry == nil then
		return
	end
	local now = os.clock()
	if now - entry.lastPlay < entry.minGap then
		return
	end
	entry.lastPlay = now
	if entry.pitchVary then
		-- 0.95 bis 1.05
		entry.sound.PlaybackSpeed = 1 + (math.random() - 0.5) / Theme.Space.x8
	end
	entry.sound:Play()
end

function SoundController.init()
	-- Klick trocken und kurz, Fehler dumpf, Kauf hell.
	register("click", Config.SOUNDS.CLICK, 0.35, false, 0)
	register("hover", Config.SOUNDS.HOVER, 0.12, false, 0)
	register("purchase", Config.SOUNDS.PURCHASE, 0.5, false, 0)
	register("error", Config.SOUNDS.ERROR, 0.4, false, 0)
	register("rebirth", Config.SOUNDS.REBIRTH, 0.6, false, 0)
	-- Sammeln: Tonhoehe variiert, Mindestpause gegen Rauschen.
	register("collect", Config.SOUNDS.COLLECT, 0.22, true, 0.06)

	if Config.SOUNDS.AMBIENCE ~= "" then
		local loop = Instance.new("Sound")
		loop.Name = "Ambience"
		loop.SoundId = Config.SOUNDS.AMBIENCE
		loop.Looped = true
		loop.Volume = 0.2
		loop.Parent = SoundService
		ambience = loop
		if ambienceEnabled then
			loop:Play()
		end
	end
end

return SoundController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="Folder" referent="RBX41">
					<Properties>
						<string name="Name">Screens</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX34">
						<Properties>
							<string name="Name">CodesScreen</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CodesScreen – Codes einloesen und Tagesbelohnung abholen.

	Zum Eingabefeld: der Fokus-Ring ist ein UIStroke, der beim Fokussieren
	auf primary wechselt und beim Verlassen zurueck auf bg3. Rueckmeldung
	steht INLINE unter dem Feld (gruen oder rot), nicht als Popup - ein
	Popup verdeckt genau das Feld, in dem man gerade tippt.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local Client = script.Parent.Parent
local Layers = require(Client.UI.Layers)
local Motion = require(Client.UI.Motion)
local Button = require(Client.UI.Components.Button)
local Panel = require(Client.UI.Components.Panel)

local CodesScreen = {}

export type Handle = {
	destroy: (() -> ()),
	update: (state: Types.ClientState) -> (),
	toggle: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
}

function CodesScreen.create(gui: ScreenGui, root: GuiObject): Handle
	local scope = Motion.scope()
	local panelZ = Layers.at("panel", Theme.Depth.content)

	local panel = Panel.create({
		parent = root, gui = gui, name = "Codes",
		title = "CODES", subtitle = "Belohnungen einloesen",
		accent = Theme.Color.premium,
	})
	local body = panel.body
	Theme.list({ parent = body, gap = Theme.Space.x12 })

	-- ---- Eingabefeld ----------------------------------------------------
	local field = Theme.Card({
		name = "Field", parent = body,
		size = UDim2.new(1, 0, 0, Theme.Size.controlHeight + Theme.Space.x8),
		fill = Theme.Color.bg0, radius = Theme.Radius.control,
		zIndex = panelZ + Theme.Depth.content, shadow = false, gradient = false,
	})
	field.LayoutOrder = 1
	local focusRing = field:FindFirstChildOfClass("UIStroke")
	Theme.padding(field, { left = Theme.Space.x16, right = Theme.Space.x16 })

	local box = Instance.new("TextBox")
	box.Name = "Input"
	box.Size = UDim2.fromScale(1, 1)
	box.BackgroundTransparency = Theme.Alpha.hidden
	box.BorderSizePixel = 0
	box.PlaceholderText = "Code eintippen"
	box.PlaceholderColor3 = Theme.Color.textLow
	box.Text = ""
	box.TextColor3 = Theme.Color.textHigh
	box.Font = Theme.Font.heading
	box.TextSize = Theme.TextSize.lg
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.ClearTextOnFocus = false
	box.ZIndex = panelZ + Theme.Depth.raised
	box.Parent = field

	-- ---- Inline-Rueckmeldung -------------------------------------------------
	local feedback = Theme.label({
		name = "Feedback", parent = body, text = "", role = "body",
		size = Theme.TextSize.sm, color = Theme.Color.textLow,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x24),
		wrapped = true, zIndex = panelZ + Theme.Depth.content, stroke = false,
	})
	feedback.LayoutOrder = 2

	local function say(text: string, ok: boolean?)
		feedback.Text = text
		feedback.TextColor3 = if ok == nil then Theme.Color.textLow
			elseif ok then Theme.Color.success
			else Theme.Color.danger
		feedback.TextTransparency = Theme.Alpha.hidden
		scope:to(feedback, { TextTransparency = Theme.Alpha.opaque },
			Theme.Duration.fast, "enter")
	end

	if focusRing ~= nil then
		local ring = focusRing
		scope:track(box.Focused:Connect(function()
			scope:to(ring, { Color = Theme.Color.primary, Thickness = Theme.Stroke.thin },
				Theme.Duration.fast, "enter")
		end))
		scope:track(box.FocusLost:Connect(function()
			scope:to(ring, { Color = Theme.Color.bg3, Thickness = Theme.Stroke.hair },
				Theme.Duration.fast, "exit")
		end))
	end

	local submit: Button.Handle
	local function redeem()
		local text = box.Text
		if #text == 0 then
			say("Bitte zuerst einen Code eintippen.", false)
			submit.shake()
			return
		end
		box.Text = ""
		submit.setState("loading")
		task.spawn(function()
			local ok, success, message = pcall(function(): (boolean, string)
				return Remotes.fn("RedeemCode"):InvokeServer(text)
			end)
			submit.setState("idle")
			if not ok then
				say("Server nicht erreichbar.", false)
				return
			end
			say(message, success)
			if not success then
				submit.shake()
			end
		end)
	end

	submit = Button.create({
		parent = body, text = "EINLOESEN", variant = "premium", icon = "code",
		size = UDim2.new(1, 0, 0, Theme.Size.controlHeight),
		zIndex = panelZ + Theme.Depth.content, layoutOrder = 3,
		onActivated = redeem,
	})
	scope:track(box.FocusLost:Connect(function(enterPressed: boolean)
		if enterPressed then
			redeem()
		end
	end))

	Theme.divider(body, 4)

	-- ---- Tagesbelohnung -------------------------------------------------------
	local dailyTitle = Theme.label({
		parent = body, text = "TAGESBELOHNUNG", role = "heading",
		size = Theme.TextSize.md, color = Theme.Color.textHigh,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x24),
		zIndex = panelZ + Theme.Depth.content, layoutOrder = 5,
	})
	dailyTitle.LayoutOrder = 5

	local dailyText = Theme.label({
		parent = body, text = "", role = "body",
		size = Theme.TextSize.sm, color = Theme.Color.textMid,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x48),
		wrapped = true, yAlign = Enum.TextYAlignment.Top,
		zIndex = panelZ + Theme.Depth.content, layoutOrder = 6, stroke = false,
	})

	local claim: Button.Handle
	claim = Button.create({
		parent = body, text = "ABHOLEN", variant = "success", icon = "cash",
		size = UDim2.new(1, 0, 0, Theme.Size.controlHeight),
		zIndex = panelZ + Theme.Depth.content, layoutOrder = 7,
		onActivated = function()
			claim.setState("loading")
			task.spawn(function()
				local ok, success, message = pcall(function(): (boolean, string)
					return Remotes.fn("ClaimDaily"):InvokeServer()
				end)
				claim.setState("idle")
				if not ok then
					say("Server nicht erreichbar.", false)
					return
				end
				say(message, success)
				if not success then
					claim.shake()
				end
			end)
		end,
	})

	local function update(state: Types.ClientState)
		local streak = math.min(state.dailyStreak, Config.DAILY.MAX_STREAK - 1)
		local next_ = Config.DAILY.BASE_CASH + Config.DAILY.CASH_PER_STREAK * streak
		dailyText.Text = string.format(
			"Serie: Tag %d von %d. Naechste Belohnung %s $. "
				.. "Am Tag %d kommen %d Gems dazu.",
			state.dailyStreak, Config.DAILY.MAX_STREAK,
			Format.abbreviate(next_), Config.DAILY.MAX_STREAK, Config.DAILY.GEMS_AT_MAX)
		if state.dailyReady then
			claim.setState("idle")
			claim.setText("ABHOLEN")
		else
			claim.setState("disabled")
			claim.setText("HEUTE SCHON ABGEHOLT")
		end
	end

	return {
		update = update,
		toggle = panel.toggle,
		close = panel.close,
		isOpen = panel.isOpen,
		destroy = function()
			submit.destroy()
			claim.destroy()
			scope:destroy()
			panel.destroy()
		end,
	}
end

return CodesScreen
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX35">
						<Properties>
							<string name="Name">GemsScreen</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	GemsScreen – Gem-Pakete und Gamepasses.

	Gold ist hier - und nur hier - die Leitfarbe. Das ist die Regel aus
	dem Design-System: premium markiert Monetarisierung und wird nirgends
	dekorativ verwendet, damit Spieler die Farbe eindeutig lesen.

	Pakete ohne eingetragene Produkt-Id zeigen "BALD" und sind deaktiviert,
	statt einen Kaufdialog zu oeffnen, der sofort fehlschlaegt.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local Client = script.Parent.Parent
local Icon = require(Client.UI.Icon)
local Layers = require(Client.UI.Layers)
local Button = require(Client.UI.Components.Button)
local Panel = require(Client.UI.Components.Panel)

local GemsScreen = {}

export type Handle = {
	destroy: (() -> ()),
	update: (state: Types.ClientState) -> (),
	toggle: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
}

function GemsScreen.create(gui: ScreenGui, root: GuiObject): Handle
	local panelZ = Layers.at("panel", Theme.Depth.content)

	local panel = Panel.create({
		parent = root, gui = gui, name = "Gems",
		title = "GEM-PAKETE", subtitle = "Hartwaehrung und Vorteile",
		accent = Theme.Color.premium, scrolling = true,
	})
	Theme.list({ parent = panel.body, gap = Theme.Space.x8 })

	local buttons: { Button.Handle } = {}

	for index, product in ipairs(Config.GEM_PRODUCTS) do
		local card = Theme.Card({
			name = product.id, parent = panel.body,
			size = UDim2.new(1, -Theme.Space.x8, 0, Theme.Size.rowHeight + Theme.Space.x8),
			fill = Theme.Color.bg2, radius = Theme.Radius.card,
			strokeColor = Theme.Color.premiumDeep,
			zIndex = panelZ + Theme.Depth.content, shadow = false,
		})
		card.LayoutOrder = index
		Theme.padding(card, { all = Theme.Space.x12 })

		local badge = Instance.new("Frame")
		badge.Size = UDim2.fromOffset(Theme.Size.pillIcon + Theme.Space.x8,
			Theme.Size.pillIcon + Theme.Space.x8)
		badge.Position = UDim2.fromScale(0, 0.5)
		badge.AnchorPoint = Vector2.new(0, 0.5)
		badge.BackgroundColor3 = Theme.Color.gem
		badge.BorderSizePixel = 0
		badge.ZIndex = panelZ + Theme.Depth.raised
		badge.Parent = card
		Theme.corner(badge, Theme.Radius.pill)
		Icon.create({
			name = "gem", parent = badge, size = Theme.Size.iconInner,
			color = Theme.Color.bg0, zIndex = panelZ + Theme.Depth.overlay,
			anchor = Vector2.new(0.5, 0.5), position = UDim2.fromScale(0.5, 0.5),
		})

		Theme.label({
			parent = card, text = product.label, role = "heading",
			size = Theme.TextSize.md, color = Theme.Color.textHigh,
			layoutSize = UDim2.new(1, -(Theme.Size.pillWidth + Theme.Space.x32), 1, 0),
			position = UDim2.fromOffset(Theme.Size.pillIcon + Theme.Space.x24, 0),
			zIndex = panelZ + Theme.Depth.raised,
		})

		local available = product.productId ~= 0
		local productKey = product.id
		local buy = Button.create({
			parent = card,
			text = if available then "KAUFEN" else "BALD",
			variant = "premium", icon = if available then "plus" else "lock",
			size = UDim2.fromOffset(Theme.Size.pillWidth / 2, Theme.Size.controlHeight),
			position = UDim2.new(1, 0, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			zIndex = panelZ + Theme.Depth.raised,
			textSize = Theme.TextSize.sm,
			onActivated = function()
				Remotes.event("PromptGemProduct"):FireServer(productKey)
			end,
		})
		if not available then
			buy.setState("disabled")
		end
		table.insert(buttons, buy)
	end

	Theme.divider(panel.body, #Config.GEM_PRODUCTS + 1)

	-- Besitzstand der Gamepasses, rein informativ.
	local passInfo = Theme.label({
		parent = panel.body, text = "", role = "body",
		size = Theme.TextSize.sm, color = Theme.Color.textMid,
		layoutSize = UDim2.new(1, 0, 0, Theme.Size.rowHeight),
		wrapped = true, yAlign = Enum.TextYAlignment.Top,
		zIndex = panelZ, stroke = false,
	})
	passInfo.LayoutOrder = #Config.GEM_PRODUCTS + 2

	local function update(state: Types.ClientState)
		local lines: { string } = {}
		table.insert(lines, if state.owns2xCash
			then "2x Cash: aktiv"
			else "2x Cash: nicht im Besitz")
		table.insert(lines, if state.ownsVip
			then "VIP-Pass: aktiv, die Lounge steht offen"
			else "VIP-Pass: nicht im Besitz")
		passInfo.Text = table.concat(lines, "\n")
	end

	return {
		update = update,
		toggle = panel.toggle,
		close = panel.close,
		isOpen = panel.isOpen,
		destroy = function()
			for _, button in ipairs(buttons) do
				button.destroy()
			end
			panel.destroy()
		end,
	}
end

return GemsScreen
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX36">
						<Properties>
							<string name="Name">Hud</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Hud – die dauerhaft sichtbare Ebene.

	Aufteilung (siehe Wireframe in docs/UI.md):
	  oben links   Waehrungs-Pills, senkrecht gestapelt
	  rechts       senkrechte Leiste aus IconButtons
	  unten mitte  kontextueller Hinweisbalken

	Sicherheitsabstaende: die Pills beginnen unterhalb der Roblox-Topbar
	(GuiService liefert die echte Hoehe), die Leiste haelt den Randabstand
	ein, und der Hinweisbalken liegt ueber dem Bereich, in dem auf dem
	Handy Sprungknopf und Bewegungsstick sitzen. Nichts Klickbares liegt
	unter Topbar oder Mobilsteuerung - das ist der Zweck von
	Theme.Safe und Responsive.read().
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local Client = script.Parent.Parent
local Icon = require(Client.UI.Icon)
local Layers = require(Client.UI.Layers)
local Motion = require(Client.UI.Motion)
local Responsive = require(Client.UI.Responsive)
local CurrencyPill = require(Client.UI.Components.CurrencyPill)
local IconButton = require(Client.UI.Components.IconButton)

local Hud = {}

export type ButtonKey = "shop" | "upgrade" | "rebirth" | "quest" | "code" | "settings"

type NavSpec = { key: ButtonKey, icon: Icon.Name, tooltip: string, accent: Color3 }

-- Die Literale werden explizit auf die Union-Typen gecastet: in einem
-- Tabellenliteral weitet Luau sie sonst zu `string`, und der Aufruf von
-- Hud.onButton(key) passt dann nicht mehr auf ButtonKey.
local NAV: { NavSpec } = {
	{ key = "shop" :: ButtonKey, icon = "shop" :: Icon.Name,
	  tooltip = "Fabrik-Upgrades", accent = Theme.Color.primary },
	{ key = "upgrade" :: ButtonKey, icon = "upgrade" :: Icon.Name,
	  tooltip = "Gem-Pakete", accent = Theme.Color.gem },
	{ key = "rebirth" :: ButtonKey, icon = "rebirth" :: Icon.Name,
	  tooltip = "Rebirth", accent = Theme.Color.danger },
	{ key = "quest" :: ButtonKey, icon = "quest" :: Icon.Name,
	  tooltip = "Aufgaben", accent = Theme.Color.success },
	{ key = "code" :: ButtonKey, icon = "code" :: Icon.Name,
	  tooltip = "Codes und Tagesbelohnung", accent = Theme.Color.premium },
	{ key = "settings" :: ButtonKey, icon = "settings" :: Icon.Name,
	  tooltip = "Optionen", accent = Theme.Color.textMid },
}

export type Handle = {
	destroy: (() -> ()),
	update: (state: Types.ClientState) -> (),
	setActive: (key: ButtonKey, active: boolean) -> (),
	flashCash: () -> (),
	layout: (viewport: Responsive.Viewport) -> (),
}

Hud.onButton = function(_key: ButtonKey) end

function Hud.create(gui: ScreenGui, root: GuiObject): Handle
	local scope = Motion.scope()
	local hudZ = Layers.at("hud", Theme.Depth.base)

	-- ---- Waehrungen oben links ------------------------------------------
	local stack = Instance.new("Frame")
	stack.Name = "Currencies"
	stack.Size = UDim2.fromOffset(Theme.Size.pillWidth, Theme.Size.pillHeight * 3)
	stack.AnchorPoint = Vector2.new(0, 0)
	stack.BackgroundTransparency = Theme.Alpha.hidden
	stack.ZIndex = hudZ
	stack.Parent = root
	Theme.list({ parent = stack, gap = Theme.Space.x8 })

	local cashPill = CurrencyPill.create({
		parent = stack, icon = "cash", caption = "GUTHABEN",
		accent = Theme.Color.success, zIndex = hudZ + Theme.Depth.content, layoutOrder = 1,
	})
	local gemPill = CurrencyPill.create({
		parent = stack, icon = "gem", caption = "GEMS",
		accent = Theme.Color.gem, zIndex = hudZ + Theme.Depth.content, layoutOrder = 2,
	})
	local rebirthPill = CurrencyPill.create({
		parent = stack, icon = "rebirth", caption = "REBIRTH",
		accent = Theme.Color.danger, zIndex = hudZ + Theme.Depth.content, layoutOrder = 3,
	})

	-- Einkommen als schmale Zeile unter den Pills
	local incomeChip = Theme.Card({
		name = "Income", parent = stack,
		size = UDim2.fromOffset(Theme.Size.pillWidth, Theme.Space.x32),
		fill = Theme.Color.bg1, radius = Theme.Radius.pill,
		zIndex = hudZ + Theme.Depth.content, shadow = false,
	})
	incomeChip.LayoutOrder = 4
	local incomeLabel = Theme.label({
		parent = incomeChip, text = "0 $/s", role = "numeric",
		size = Theme.TextSize.sm, color = Theme.Color.textMid,
		layoutSize = UDim2.new(1, -Theme.Space.x24, 1, 0),
		position = UDim2.fromOffset(Theme.Space.x12, 0),
		zIndex = hudZ + Theme.Depth.raised, stroke = false,
	})

	-- ---- Navigationsleiste rechts -----------------------------------------
	local nav = Instance.new("Frame")
	nav.Name = "Nav"
	nav.AnchorPoint = Vector2.new(1, 0.5)
	nav.BackgroundTransparency = Theme.Alpha.hidden
	nav.ZIndex = hudZ
	nav.Parent = root
	Theme.list({
		parent = nav, gap = Theme.Space.x8,
		hAlign = Enum.HorizontalAlignment.Right,
	})

	-- Intern mit String-Schluesseln: ein Index mit Stringliteral weitet
	-- sonst zu string und passt nicht auf den Union-Schluesseltyp.
	local buttons: { [string]: IconButton.Handle } = {}
	for index, spec in ipairs(NAV) do
		-- Annotiert, damit der Union-Typ beim Zuweisen nicht zu string weitet.
		local key: ButtonKey = spec.key
		buttons[key] = IconButton.create({
			parent = nav, icon = spec.icon, tooltip = spec.tooltip,
			accent = spec.accent, zIndex = hudZ + Theme.Depth.content,
			layoutOrder = index,
			onActivated = function()
				Hud.onButton(key)
			end,
		})
	end

	-- ---- Hinweisbalken unten -----------------------------------------------
	local hint = Theme.Card({
		name = "Hint", parent = root,
		size = UDim2.fromOffset(Theme.Size.hintWidth, Theme.Size.hintHeight),
		anchor = Vector2.new(0.5, 1),
		fill = Theme.Color.bg2, radius = Theme.Radius.pill,
		strokeColor = Theme.Color.primary,
		zIndex = hudZ + Theme.Depth.content,
		visible = false,
	})
	Theme.padding(hint, { left = Theme.Space.x16, right = Theme.Space.x16 })
	local hintIcon = Icon.create({
		name = "upgrade", parent = hint, size = Theme.Size.iconSm,
		color = Theme.Color.primary, zIndex = hudZ + Theme.Depth.raised,
		anchor = Vector2.new(0, 0.5), position = UDim2.fromScale(0, 0.5),
	})
	local hintLabel = Theme.label({
		parent = hint, text = "", role = "heading",
		size = Theme.TextSize.sm, color = Theme.Color.textHigh,
		layoutSize = UDim2.new(1, -Theme.Space.x32, 1, 0),
		position = UDim2.fromOffset(Theme.Space.x32, 0),
		zIndex = hudZ + Theme.Depth.raised,
	})
	local hintVisible = false
	local hintScale = Instance.new("UIScale")
	hintScale.Parent = hint

	local function setHint(text: string?)
		local wanted = text ~= nil
		if wanted and text ~= nil then
			hintLabel.Text = text
		end
		if wanted == hintVisible then
			return
		end
		hintVisible = wanted
		if wanted then
			hint.Visible = true
			hint.BackgroundTransparency = Theme.Alpha.hidden
			hintScale.Scale = Theme.Scale.panelEnter
			scope:to(hint, { BackgroundTransparency = Theme.Alpha.opaque },
				Theme.Duration.slow, "enter")
			scope:to(hintScale, { Scale = Theme.Scale.rest }, Theme.Duration.slow, "pop")
		else
			-- Ausblenden, nicht einfach verstecken.
			local fade = scope:to(hint, { BackgroundTransparency = Theme.Alpha.hidden },
				Theme.Duration.slow, "exit")
			fade.Completed:Once(function()
				if not hintVisible then
					hint.Visible = false
				end
			end)
		end
	end

	-- ---- Platzierung mit Sicherheitsabstaenden --------------------------------
	local function layout(viewport: Responsive.Viewport)
		-- Die Positionen sind in UNSKALIERTEN Pixeln angegeben; die globale
		-- UIScale sitzt auf `root` und verkleinert sie mit. Deshalb wird
		-- der Sicherheitsabstand durch die Skalierung geteilt, sonst
		-- schrumpft er auf kleinen Geraeten mit.
		local factor = viewport.scale
		local edge = Theme.Safe.edge / factor
		local top = viewport.topInset / factor
		local bottom = viewport.bottomInset / factor

		stack.Position = UDim2.fromOffset(edge, top + Theme.Space.x8)
		nav.Position = UDim2.new(1, -edge, 0.5, 0)
		nav.Size = UDim2.fromOffset(
			Responsive.minTouchSize(),
			(#NAV) * (Responsive.minTouchSize() + Theme.Space.x8))
		hint.Position = UDim2.new(0.5, 0, 1, -(bottom + Theme.Space.x8))

		-- Im Hochformat sind die Pills schmaler, sonst nehmen sie die
		-- halbe Bildschirmbreite ein.
		local narrow = viewport.portrait or viewport.compact
		local pillWidth = if narrow
			then Theme.Size.pillWidth - Theme.Space.x48
			else Theme.Size.pillWidth
		stack.Size = UDim2.fromOffset(pillWidth, Theme.Size.pillHeight * 3)
		for _, pill in ipairs({ cashPill, gemPill, rebirthPill }) do
			pill.instance.Size = UDim2.fromOffset(pillWidth, Theme.Size.pillHeight)
		end
		incomeChip.Size = UDim2.fromOffset(pillWidth, Theme.Space.x32)
		hint.Size = UDim2.fromOffset(
			math.min(Theme.Size.hintWidth, viewport.width / factor - edge * 2),
			Theme.Size.hintHeight)
	end

	-- ---- Aktualisierung ---------------------------------------------------------
	local function update(state: Types.ClientState)
		cashPill.setValue(state.cash)
		gemPill.setValue(state.gems)
		rebirthPill.setValue(state.rebirths)
		incomeLabel.Text = Format.abbreviate(state.incomePerSecond) .. " $/s"

		-- Badges: abholbare Inhalte melden sich selbst.
		local claimable = 0
		for _, quest in ipairs(Config.QUESTS) do
			local progress = state.quests[quest.metric] or 0
			if progress >= quest.target and not state.claimedQuests[quest.id] then
				claimable += 1
			end
		end
		local questButton = buttons["quest"]
		local codeButton = buttons["code"]
		local rebirthButton = buttons["rebirth"]
		if questButton == nil or codeButton == nil or rebirthButton == nil then
			return
		end
		questButton.setBadge(claimable > 0, claimable)
		codeButton.setBadge(state.dailyReady, nil)
		rebirthButton.setBadge(state.cash >= state.rebirthCost, nil)

		-- Kontexthinweis: zeigt genau den naechsten sinnvollen Schritt.
		local bought = 0
		for _ in pairs(state.purchased) do
			bought += 1
		end
		if bought == 0 then
			setHint("Lauf auf ein blaues Feld und kauf deinen ersten Bohrer")
		elseif state.cash >= state.rebirthCost then
			setHint("Du kannst rebirthen - dauerhaft mehr Einkommen")
		else
			setHint(nil)
		end
	end

	return {
		update = update,
		layout = layout,
		setActive = function(key: ButtonKey, active: boolean)
			local handle: IconButton.Handle? = buttons[key]
			if handle ~= nil then
				handle.setActive(active)
			end
		end,
		flashCash = cashPill.flashError,
		destroy = function()
			for _, handle in pairs(buttons) do
				handle.destroy()
			end
			cashPill.destroy()
			gemPill.destroy()
			rebirthPill.destroy()
			scope:destroy()
			stack:Destroy()
			nav:Destroy()
			hint:Destroy()
			hintIcon:Destroy()
		end,
	}
end

return Hud
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX37">
						<Properties>
							<string name="Name">QuestsScreen</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	QuestsScreen – Aufgabenliste mit Fortschrittsbalken.

	Jede Zeile ist eine Card mit Titel, Balken, Zahlen und Abhol-Knopf.
	Der Knopf hat drei Zustaende, die sich nicht nur farblich, sondern
	auch im Text unterscheiden: gesperrt / abholbar / erledigt.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local Client = script.Parent.Parent
local Layers = require(Client.UI.Layers)
local Button = require(Client.UI.Components.Button)
local Panel = require(Client.UI.Components.Panel)
local ProgressBar = require(Client.UI.Components.ProgressBar)

local QuestsScreen = {}

export type Handle = {
	destroy: (() -> ()),
	update: (state: Types.ClientState) -> (),
	toggle: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
}

type Row = {
	def: Types.QuestDef,
	bar: ProgressBar.Handle,
	amount: TextLabel,
	button: Button.Handle,
}

function QuestsScreen.create(gui: ScreenGui, root: GuiObject): Handle
	local panelZ = Layers.at("panel", Theme.Depth.content)

	local panel = Panel.create({
		parent = root, gui = gui, name = "Quests",
		title = "AUFGABEN", subtitle = "Belohnungen in Gems",
		accent = Theme.Color.success, scrolling = true,
	})
	Theme.list({ parent = panel.body, gap = Theme.Space.x8 })

	local rows: { Row } = {}

	for index, def in ipairs(Config.QUESTS) do
		local card = Theme.Card({
			name = def.id, parent = panel.body,
			size = UDim2.new(1, -Theme.Space.x8, 0, Theme.Size.rowHeight + Theme.Space.x16),
			fill = Theme.Color.bg2, radius = Theme.Radius.card,
			zIndex = panelZ + Theme.Depth.content, shadow = false,
		})
		card.LayoutOrder = index
		Theme.padding(card, { all = Theme.Space.x12 })

		Theme.label({
			parent = card, text = def.label, role = "heading",
			size = Theme.TextSize.sm, color = Theme.Color.textHigh,
			layoutSize = UDim2.new(1, -Theme.Size.pillWidth / 2, 0, Theme.Space.x24),
			zIndex = panelZ + Theme.Depth.raised,
		})

		local amount = Theme.label({
			parent = card, text = "0 / 0", role = "numeric",
			size = Theme.TextSize.xs, color = Theme.Color.textLow,
			layoutSize = UDim2.new(1, -Theme.Size.pillWidth / 2, 0, Theme.Space.x16),
			position = UDim2.fromOffset(0, Theme.Space.x24),
			xAlign = Enum.TextXAlignment.Right,
			zIndex = panelZ + Theme.Depth.raised, stroke = false,
		})

		local bar = ProgressBar.create({
			parent = card, zIndex = panelZ + Theme.Depth.raised,
			color = Theme.Color.success,
			size = UDim2.new(1, -Theme.Size.pillWidth / 2, 0, Theme.Size.barHeight),
		})
		bar.instance.Position = UDim2.fromOffset(0, Theme.Space.x48)

		local questId = def.id
		local button: Button.Handle
		button = Button.create({
			parent = card, text = "+" .. tostring(def.rewardGems),
			variant = "secondary", icon = "gem",
			size = UDim2.fromOffset(Theme.Size.pillWidth / 2 - Theme.Space.x8,
				Theme.Size.controlHeight),
			position = UDim2.new(1, 0, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			zIndex = panelZ + Theme.Depth.raised,
			textSize = Theme.TextSize.sm,
			onActivated = function()
				button.setState("loading")
				task.spawn(function()
					-- Alle drei Rueckgaben aufnehmen: pcall liefert
					-- (erfolg, ok, meldung); nur zwei zu binden bringt die
					-- Typzuordnung durcheinander.
					local called, success, _message = pcall(function(): (boolean, string)
						return Remotes.fn("ClaimQuest"):InvokeServer(questId)
					end)
					button.setState("idle")
					if called and not success then
						button.shake()
					end
				end)
			end,
		})

		table.insert(rows, { def = def, bar = bar, amount = amount, button = button })
	end

	-- Kleiner Hinweis am Ende der Liste.
	Theme.label({
		parent = panel.body, role = "body",
		text = "Aufgaben bleiben ueber Rebirths hinweg bestehen.",
		size = Theme.TextSize.xs, color = Theme.Color.textLow,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x32),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = panelZ, layoutOrder = #Config.QUESTS + 1, stroke = false,
	})

	local function update(state: Types.ClientState)
		local ready = 0
		for _, row in ipairs(rows) do
			local progress = state.quests[row.def.metric] or 0
			local claimed = state.claimedQuests[row.def.id] == true
			local ratio = progress / row.def.target
			row.bar.set(ratio, if claimed then Theme.Color.textLow else Theme.Color.success)
			row.amount.Text = string.format("%s / %s",
				Format.abbreviate(progress), Format.abbreviate(row.def.target))

			if claimed then
				row.button.setVariant("secondary")
				row.button.setState("disabled")
				row.button.setText("ERLEDIGT")
			elseif ratio >= 1 then
				ready += 1
				row.button.setVariant("success")
				row.button.setState("idle")
				row.button.setText("+" .. tostring(row.def.rewardGems))
			else
				row.button.setVariant("secondary")
				row.button.setState("disabled")
				row.button.setText("+" .. tostring(row.def.rewardGems))
			end
		end
		panel.setSubtitle(
			if ready > 0 then `{ready} abholbar` else "Belohnungen in Gems")
	end

	return {
		update = update,
		toggle = panel.toggle,
		close = panel.close,
		isOpen = panel.isOpen,
		destroy = function()
			for _, row in ipairs(rows) do
				row.bar.destroy()
				row.button.destroy()
			end
			panel.destroy()
		end,
	}
end

return QuestsScreen
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX38">
						<Properties>
							<string name="Name">RebirthScreen</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RebirthScreen – der dramatischste Bildschirm im Spiel.

	Gestaltung mit Absicht:
	  * dunklerer Grund als alle anderen Panels (bg0 statt bg1)
	  * die Rebirth-Zahl gross in Display-Groesse
	  * Vorher/Nachher der Multiplikatoren nebeneinander mit Pfeil dazwischen
	  * Warnblock in danger-Farbe mit Rand, nicht nur roter Text
	  * ZWEISTUFIGE Bestaetigung: der erste Druck aendert den Knopf in
	    "WIRKLICH? ERNEUT DRUECKEN" und startet einen Countdown; erst der
	    zweite Druck sendet. Nach 4 Sekunden ohne zweiten Druck faellt der
	    Knopf zurueck. Ein Reset des gesamten Fortschritts darf nicht mit
	    einem versehentlichen Klick passieren.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local Client = script.Parent.Parent
local Icon = require(Client.UI.Icon)
local Layers = require(Client.UI.Layers)
local Motion = require(Client.UI.Motion)
local Button = require(Client.UI.Components.Button)
local Panel = require(Client.UI.Components.Panel)
local ProgressBar = require(Client.UI.Components.ProgressBar)

local RebirthScreen = {}

export type Handle = {
	destroy: (() -> ()),
	update: (state: Types.ClientState) -> (),
	toggle: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
}

local CONFIRM_WINDOW = 4

function RebirthScreen.create(gui: ScreenGui, root: GuiObject): Handle
	local scope = Motion.scope()
	local panelZ = Layers.at("panel", Theme.Depth.content)
	local armed = false
	local armToken = 0

	local panel = Panel.create({
		parent = root, gui = gui, name = "Rebirth",
		title = "REBIRTH", subtitle = "Alles zurueck - dafuer dauerhaft mehr",
		accent = Theme.Color.danger,
	})
	-- Dunkler als die uebrigen Panels: markiert den Ernst der Sache.
	panel.instance.BackgroundColor3 = Theme.Color.bg0

	local body = panel.body
	Theme.list({ parent = body, gap = Theme.Space.x12 })

	-- ---- Grosse Zahl -----------------------------------------------------
	local headline = Instance.new("Frame")
	headline.Name = "Headline"
	headline.Size = UDim2.new(1, 0, 0, Theme.Space.x48 + Theme.Space.x16)
	headline.BackgroundTransparency = Theme.Alpha.hidden
	headline.LayoutOrder = 1
	headline.ZIndex = panelZ
	headline.Parent = body
	Theme.list({
		parent = headline, gap = Theme.Space.x12,
		direction = Enum.FillDirection.Horizontal,
		hAlign = Enum.HorizontalAlignment.Center,
		vAlign = Enum.VerticalAlignment.Center,
	})
	local rebirthGlyph = Icon.create({
		name = "rebirth", parent = headline, size = Theme.Size.pillIcon,
		color = Theme.Color.danger, zIndex = panelZ + Theme.Depth.content,
		layoutOrder = 1,
	})
	rebirthGlyph.LayoutOrder = 1
	local bigNumber = Theme.label({
		name = "Number", parent = headline, text = "0", role = "display",
		size = Theme.TextSize.display, color = Theme.Color.textHigh,
		layoutSize = UDim2.fromOffset(Theme.Size.pillWidth, Theme.Space.x48 + Theme.Space.x16),
		xAlign = Enum.TextXAlignment.Left,
		zIndex = panelZ + Theme.Depth.content, layoutOrder = 2,
	})

	-- ---- Vorher / Nachher --------------------------------------------------
	local compare = Instance.new("Frame")
	compare.Name = "Compare"
	compare.Size = UDim2.new(1, 0, 0, Theme.Size.rowHeight)
	compare.BackgroundTransparency = Theme.Alpha.hidden
	compare.LayoutOrder = 2
	compare.ZIndex = panelZ
	compare.Parent = body
	Theme.list({
		parent = compare, gap = Theme.Space.x16,
		direction = Enum.FillDirection.Horizontal,
		hAlign = Enum.HorizontalAlignment.Center,
		vAlign = Enum.VerticalAlignment.Center,
	})

	local function multCard(caption: string, order: number, color: Color3): TextLabel
		local card = Theme.Card({
			name = caption, parent = compare,
			size = UDim2.fromOffset(Theme.Size.pillWidth * 0.8, Theme.Size.rowHeight),
			fill = Theme.Color.bg2, radius = Theme.Radius.card,
			zIndex = panelZ + Theme.Depth.content, shadow = false,
		})
		card.LayoutOrder = order
		Theme.label({
			parent = card, text = caption, role = "body",
			size = Theme.TextSize.xs, color = Theme.Color.textLow,
			layoutSize = UDim2.new(1, 0, 0, Theme.Space.x16),
			position = UDim2.fromOffset(0, Theme.Space.x8),
			xAlign = Enum.TextXAlignment.Center,
			zIndex = panelZ + Theme.Depth.raised, stroke = false,
		})
		return Theme.label({
			parent = card, text = "x1.00", role = "numeric",
			size = Theme.TextSize.lg, color = color,
			layoutSize = UDim2.new(1, 0, 0, Theme.Space.x24),
			position = UDim2.fromOffset(0, Theme.Space.x24),
			xAlign = Enum.TextXAlignment.Center,
			zIndex = panelZ + Theme.Depth.raised,
		})
	end

	local beforeValue = multCard("JETZT", 1, Theme.Color.textMid)
	local arrow = Theme.label({
		parent = compare, text = "->", role = "display",
		size = Theme.TextSize.lg, color = Theme.Color.danger,
		layoutSize = UDim2.fromOffset(Theme.Space.x32, Theme.Size.rowHeight),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = panelZ + Theme.Depth.content, layoutOrder = 2,
	})
	arrow.LayoutOrder = 2
	local afterValue = multCard("DANACH", 3, Theme.Color.success)

	-- ---- Fortschritt zur naechsten Schwelle ---------------------------------
	local progressRow = Instance.new("Frame")
	progressRow.Size = UDim2.new(1, 0, 0, Theme.Space.x32)
	progressRow.BackgroundTransparency = Theme.Alpha.hidden
	progressRow.LayoutOrder = 3
	progressRow.ZIndex = panelZ
	progressRow.Parent = body
	local progressLabel = Theme.label({
		parent = progressRow, text = "", role = "body",
		size = Theme.TextSize.xs, color = Theme.Color.textMid,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x16),
		zIndex = panelZ + Theme.Depth.content, stroke = false,
	})
	local progress = ProgressBar.create({
		parent = progressRow, zIndex = panelZ + Theme.Depth.content,
		color = Theme.Color.danger,
		size = UDim2.new(1, 0, 0, Theme.Size.barHeight),
	})
	progress.instance.Position = UDim2.fromOffset(0, Theme.Space.x16 + Theme.Space.x4)

	-- ---- Warnung -----------------------------------------------------------
	local warning = Theme.Card({
		name = "Warning", parent = body,
		size = UDim2.new(1, 0, 0, Theme.Size.rowHeight + Theme.Space.x16),
		fill = Theme.Color.dangerDeep, radius = Theme.Radius.card,
		strokeColor = Theme.Color.danger,
		zIndex = panelZ + Theme.Depth.content, shadow = false, gradient = false,
	})
	warning.LayoutOrder = 4
	Theme.padding(warning, { all = Theme.Space.x12 })
	Theme.label({
		parent = warning, role = "body",
		text = "Guthaben und alle " .. tostring(#Config.UPGRADES)
			.. " Upgrades werden geloescht. Gems, Aufgaben und Rebirth-Zahl bleiben.",
		size = Theme.TextSize.sm, color = Theme.Color.textHigh,
		layoutSize = UDim2.fromScale(1, 1), wrapped = true,
		yAlign = Enum.TextYAlignment.Top,
		zIndex = panelZ + Theme.Depth.raised,
	})

	-- ---- Zweistufige Bestaetigung -----------------------------------------------
	local confirm: Button.Handle
	local function disarm()
		if not armed then
			return
		end
		armed = false
		confirm.setVariant("danger")
		confirm.setText("REBIRTH STARTEN")
	end

	confirm = Button.create({
		parent = body, text = "REBIRTH STARTEN", variant = "danger",
		icon = "rebirth",
		size = UDim2.new(1, 0, 0, Theme.Size.controlHeight + Theme.Space.x8),
		zIndex = panelZ + Theme.Depth.content,
		layoutOrder = 5,
		onActivated = function()
			if not armed then
				armed = true
				armToken += 1
				local token = armToken
				confirm.setText("WIRKLICH? NOCHMAL DRUECKEN")
				confirm.setVariant("premium")
				-- Fenster laeuft ab: danach ist der Knopf wieder harmlos.
				task.delay(CONFIRM_WINDOW, function()
					if armToken == token then
						disarm()
					end
				end)
				return
			end
			armToken += 1
			disarm()
			Remotes.event("RequestRebirth"):FireServer()
		end,
	})

	local function update(state: Types.ClientState)
		bigNumber.Text = tostring(state.rebirths)
		beforeValue.Text = string.format("x%.2f", state.rebirthMultiplier)
		afterValue.Text = string.format("x%.2f", state.nextRebirthMultiplier)

		local ratio = if state.rebirthCost > 0 then state.cash / state.rebirthCost else 0
		progress.set(math.clamp(ratio, 0, 1))
		progressLabel.Text = string.format("%s / %s $",
			Format.abbreviate(state.cash), Format.abbreviate(state.rebirthCost))

		local affordable = state.cash >= state.rebirthCost
		if not affordable then
			disarm()
			confirm.setState("disabled")
			confirm.setText("NOCH ZU WENIG GELD")
		elseif not armed then
			confirm.setState("idle")
			confirm.setText("REBIRTH STARTEN")
		end
	end

	return {
		update = update,
		toggle = function()
			disarm()
			panel.toggle()
		end,
		close = function()
			disarm()
			panel.close()
		end,
		isOpen = panel.isOpen,
		destroy = function()
			confirm.destroy()
			progress.destroy()
			scope:destroy()
			panel.destroy()
		end,
	}
end

return RebirthScreen
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX39">
						<Properties>
							<string name="Name">SettingsScreen</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	SettingsScreen – Optionen in Gruppen mit Trennlinien.

	Keine nackte Liste: jede Gruppe hat eine Ueberschrift in textLow, die
	Eintraege stehen darunter, dazwischen eine 1-px-Trennlinie in bg3 mit
	40 % Transparenz.

	"Reduzierte Bewegung" setzt Theme.reduceMotion. Weil jede Dauer im
	Spiel durch Theme.duration() laeuft, wirkt der Schalter sofort auf
	alles - ohne einen zweiten Codepfad und ohne Layoutaenderung.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local Client = script.Parent.Parent
local Layers = require(Client.UI.Layers)
local Panel = require(Client.UI.Components.Panel)
local SegmentedControl = require(Client.UI.Components.SegmentedControl)
local SoundController = require(Client.SoundController)

local SettingsScreen = {}

export type Handle = {
	destroy: (() -> ()),
	update: (state: Types.ClientState) -> (),
	toggle: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
}

local ON_OFF: { SegmentedControl.Option } = {
	{ id = "on", label = "An" },
	{ id = "off", label = "Aus" },
}

function SettingsScreen.create(gui: ScreenGui, root: GuiObject): Handle
	local panelZ = Layers.at("panel", Theme.Depth.content)

	local panel = Panel.create({
		parent = root, gui = gui, name = "Settings",
		title = "OPTIONEN", subtitle = "Ton und Darstellung",
		accent = Theme.Color.textMid, scrolling = true,
	})
	Theme.list({ parent = panel.body, gap = Theme.Space.x8 })

	local order = 0
	local controls: { SegmentedControl.Handle } = {}

	local function groupTitle(text: string)
		order += 1
		local label = Theme.label({
			parent = panel.body, text = text, role = "heading",
			size = Theme.TextSize.xs, color = Theme.Color.textLow,
			layoutSize = UDim2.new(1, 0, 0, Theme.Space.x24),
			zIndex = panelZ, stroke = false,
		})
		label.LayoutOrder = order
	end

	local function row(label: string, hint: string,
		initial: string, onChange: (id: string) -> ())
		order += 1
		local card = Theme.Card({
			name = label, parent = panel.body,
			size = UDim2.new(1, -Theme.Space.x8, 0, Theme.Size.rowHeight + Theme.Space.x16),
			fill = Theme.Color.bg2, radius = Theme.Radius.card,
			zIndex = panelZ + Theme.Depth.content, shadow = false,
		})
		card.LayoutOrder = order
		Theme.padding(card, { all = Theme.Space.x12 })

		Theme.label({
			parent = card, text = label, role = "heading",
			size = Theme.TextSize.sm, color = Theme.Color.textHigh,
			layoutSize = UDim2.new(1, -Theme.Size.pillWidth, 0, Theme.Space.x24),
			zIndex = panelZ + Theme.Depth.raised,
		})
		Theme.label({
			parent = card, text = hint, role = "body",
			size = Theme.TextSize.xs, color = Theme.Color.textLow,
			layoutSize = UDim2.new(1, -Theme.Size.pillWidth, 0, Theme.Space.x24),
			position = UDim2.fromOffset(0, Theme.Space.x24),
			wrapped = true, yAlign = Enum.TextYAlignment.Top,
			zIndex = panelZ + Theme.Depth.raised, stroke = false,
		})

		local holder = Instance.new("Frame")
		holder.Size = UDim2.fromOffset(Theme.Size.pillWidth * 0.8, Theme.Size.controlHeight)
		holder.Position = UDim2.new(1, 0, 0.5, 0)
		holder.AnchorPoint = Vector2.new(1, 0.5)
		holder.BackgroundTransparency = Theme.Alpha.hidden
		holder.ZIndex = panelZ + Theme.Depth.raised
		holder.Parent = card

		local control = SegmentedControl.create(holder, ON_OFF,
			panelZ + Theme.Depth.raised, onChange)
		control.select(initial, false)
		table.insert(controls, control)
	end

	local function divider()
		order += 1
		Theme.divider(panel.body, order)
	end

	groupTitle("TON")
	row("Soundeffekte", "Klick, Kauf und Sammeln", "on", function(id: string)
		SoundController.setEnabled(id == "on")
	end)
	row("Hintergrundmusik", "Ambiente der Mine", "on", function(id: string)
		SoundController.setAmbienceEnabled(id == "on")
	end)

	divider()

	groupTitle("DARSTELLUNG")
	row("Reduzierte Bewegung", "Blendet alle Animationen aus. Das Layout "
		.. "bleibt gleich, nur die Uebergaenge entfallen.", "off",
		function(id: string)
			Theme.reduceMotion = id == "on"
		end)

	divider()

	groupTitle("UEBER")
	order += 1
	local about = Theme.label({
		parent = panel.body, role = "body",
		text = "Bergbau-Imperium. Farben, Abstaende, Schriftgroessen und "
			.. "Bewegungsdauern stammen vollstaendig aus Theme.luau; die "
			.. "Preiskurve aus tools/balance_sim.py.",
		size = Theme.TextSize.xs, color = Theme.Color.textLow,
		layoutSize = UDim2.new(1, 0, 0, Theme.Size.rowHeight),
		wrapped = true, yAlign = Enum.TextYAlignment.Top,
		zIndex = panelZ, stroke = false,
	})
	about.LayoutOrder = order

	return {
		update = function(_state: Types.ClientState) end,
		toggle = panel.toggle,
		close = panel.close,
		isOpen = panel.isOpen,
		destroy = function()
			for _, control in ipairs(controls) do
				control.destroy()
			end
			panel.destroy()
		end,
	}
end

return SettingsScreen
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX40">
						<Properties>
							<string name="Name">ShopScreen</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ShopScreen – Upgrade-Panel mit Reiterspalte und Raster aus ItemSlots.

	Aufbau:
	  Panel
	   +- Body
	       +- Tabs (links, senkrecht)
	       +- ScrollingFrame (rechts, UIGridLayout)
	           +- ItemSlot je Upgrade
	       +- EmptyState (nur sichtbar, wenn ein Reiter leer ist)

	Die Slots werden EINMAL gebaut und danach nur ein- bzw. ausgeblendet
	und aktualisiert. Sie bei jedem Zustands-Push neu zu erzeugen hiesse,
	25 ViewportFrames pro Sekunde wegzuwerfen - das ist der teuerste
	Fehler, den man in dieser UI machen kann.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme)
local Types = require(Shared.Types)

local Client = script.Parent.Parent
local Layers = require(Client.UI.Layers)
local Preview = require(Client.UI.Preview)
local EmptyState = require(Client.UI.Components.EmptyState)
local ItemSlot = require(Client.UI.Components.ItemSlot)
local Panel = require(Client.UI.Components.Panel)
local Tabs = require(Client.UI.Components.Tabs)

local ShopScreen = {}

-- Wird vom Bootstrap gesetzt: meldet, welcher Kauf gerade abgeschickt
-- wurde, damit die Serverantwort dem richtigen Slot zugeordnet wird.
ShopScreen.onRequest = function(_upgradeId: string) end

export type Handle = {
	destroy: (() -> ()),
	update: (state: Types.ClientState) -> (),
	toggle: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
	onPurchaseResult: (upgradeId: string, success: boolean) -> (),
}

local TABS: { Tabs.Item } = {
	{ id = "all", label = "Alle" },
	{ id = "dropper", label = "Bohrer" },
	{ id = "upgrader", label = "Oefen" },
	{ id = "boost", label = "Tempo" },
	{ id = "build", label = "Gebaeude" },
}

-- Ordnet eine Upgrade-Art einem Reiter und einem Vorschaumodell zu.
local function categoryOf(kind: string): (string, Preview.Kind)
	if kind == "dropper" then
		return "dropper", "dropper" :: Preview.Kind
	elseif kind == "upgrader" then
		return "upgrader", "upgrader" :: Preview.Kind
	elseif kind == "collector" then
		return "upgrader", "collector" :: Preview.Kind
	elseif kind == "rate" then
		return "boost", "rate" :: Preview.Kind
	elseif kind == "speed" then
		return "boost", "speed" :: Preview.Kind
	end
	return "build", "cosmetic" :: Preview.Kind
end

function ShopScreen.create(gui: ScreenGui, root: GuiObject): Handle
	local panelZ = Layers.at("panel", Theme.Depth.content)

	local panel = Panel.create({
		parent = root, gui = gui, name = "Shop",
		title = "FABRIK-UPGRADES",
		subtitle = "0 von " .. tostring(#Config.UPGRADES) .. " gekauft",
		accent = Theme.Color.primary,
	})

	local tabs: Tabs.Handle
	local slots: { [string]: ItemSlot.Handle } = {}
	local categories: { [string]: string } = {}
	local empty: EmptyState.Handle

	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid"
	grid.Size = UDim2.new(1, -(Theme.Size.tabWidth + Theme.Space.x16), 1, 0)
	grid.Position = UDim2.fromOffset(Theme.Size.tabWidth + Theme.Space.x16, 0)
	grid.BackgroundTransparency = Theme.Alpha.hidden
	grid.BorderSizePixel = 0
	grid.ScrollBarThickness = Theme.Size.scrollBar
	grid.ScrollBarImageColor3 = Theme.Color.primary
	grid.ScrollBarImageTransparency = Theme.Alpha.veil
	grid.CanvasSize = UDim2.new()
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.ScrollingDirection = Enum.ScrollingDirection.Y
	grid.ElasticBehavior = Enum.ElasticBehavior.Never
	grid.ZIndex = panelZ
	grid.Parent = panel.body

	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(Theme.Size.slotWidth, Theme.Size.slotHeight)
	layout.CellPadding = UDim2.fromOffset(Theme.Space.x12, Theme.Space.x12)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	layout.Parent = grid
	Theme.padding(grid, { right = Theme.Space.x12 })

	local function applyFilter()
		local selected = tabs.selected()
		local visible = 0
		for id, slot in pairs(slots) do
			local show = selected == "all" or categories[id] == selected
			slot.instance.Visible = show
			if show then
				visible += 1
			end
		end
		empty.setVisible(visible == 0)
	end

	tabs = Tabs.create(panel.body, TABS, panelZ, function()
		applyFilter()
	end)

	empty = EmptyState.create(grid, "lock", "Nichts in dieser Gruppe",
		"Kauf zuerst ein paar Upgrades aus den anderen Reitern.",
		panelZ + Theme.Depth.overlay)

	for index, def in ipairs(Config.UPGRADES) do
		-- Annotiert: der Union-Rueckgabetyp weitet beim Destrukturieren sonst.
		local category: string, previewKind: Preview.Kind = categoryOf(def.effect.kind)
		categories[def.id] = category
		local upgradeId = def.id
		slots[def.id] = ItemSlot.create({
			parent = grid, id = def.id, rank = def.rank,
			title = def.label, description = def.desc, price = def.price,
			kind = previewKind, zIndex = panelZ + Theme.Depth.content,
			layoutOrder = index,
			onBuy = function()
				ShopScreen.onRequest(upgradeId)
				Remotes.event("RequestPurchase"):FireServer(upgradeId)
			end,
		})
	end
	applyFilter()

	local function update(state: Types.ClientState)
		local bought = 0
		for _, def in ipairs(Config.UPGRADES) do
			local slot = slots[def.id]
			if slot == nil then
				continue
			end
			if state.purchased[def.id] then
				bought += 1
				slot.setState("owned")
			elseif state.available[def.id] then
				slot.setState(
					if state.cash >= def.price then "buyable" else "tooExpensive")
			else
				-- Konkret sagen, was fehlt: "gesperrt" allein frustriert.
				local missing: { string } = {}
				for _, requirement in ipairs(def.requires) do
					if not state.purchased[requirement] then
						local other = Config.UPGRADES_BY_ID[requirement]
						table.insert(missing, if other ~= nil then other.label else requirement)
					end
				end
				slot.setState("locked", "Zuerst: " .. table.concat(missing, ", "))
			end
		end
		panel.setSubtitle(`{bought} von {#Config.UPGRADES} gekauft`)
	end

	return {
		update = update,
		toggle = panel.toggle,
		close = panel.close,
		isOpen = panel.isOpen,

		-- Rueckmeldung vom Server: Erfolg pulsiert gruen, Fehler ruettelt.
		onPurchaseResult = function(upgradeId: string, success: boolean)
			local slot = slots[upgradeId]
			if slot == nil then
				return
			end
			if success then
				slot.celebrate()
			else
				slot.reject()
			end
		end,

		destroy = function()
			for _, slot in pairs(slots) do
				slot.destroy()
			end
			empty.destroy()
			tabs.destroy()
			panel.destroy()
		end,
	}
end

return ShopScreen
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Folder" referent="RBX63">
					<Properties>
						<string name="Name">UI</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX42">
						<Properties>
							<string name="Name">Icon</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Icon – Symbole ohne Emojis und ohne erfundene Asset-Ids.

	Zwei Betriebsarten, gesteuert ueber Theme.Icon:
	  * Steht dort eine Asset-Id, wird ein ImageLabel gebaut.
	  * Steht dort "" (Auslieferungszustand), zeichnet dieses Modul den
	    Glyph aus einfachen Frames - Kreise, Ringe, gedrehte Quadrate,
	    Balken. Das sieht absichtlich wie ein Icon-Set aus und nicht wie
	    ein fehlendes Bild, und es kommt ohne Upload aus.

	Der Wechsel kostet keine Codeaenderung: dieselbe Funktion, gleiche
	Groesse, gleiche Farbe.

	Die Glyphen halten sich an vier Grundformen, damit das Set einheitlich
	wirkt: Kreis, Ring, Raute, Balken. Mehr braucht keines der Symbole.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local Icon = {}

export type Name =
	"cash" | "gem" | "rebirth" | "shop" | "upgrade" | "quest" | "code"
	| "settings" | "lock" | "check" | "close" | "plus"
	| "drill" | "furnace" | "belt" | "scale"

-- ==========================================================================
-- Grundformen
-- ==========================================================================

type Ctx = { parent: Frame, color: Color3, zIndex: number }

local function shape(ctx: Ctx, sizeScale: Vector2, posScale: Vector2,
	radius: number, rotation: number?, transparency: number?): Frame
	local piece = Instance.new("Frame")
	piece.Size = UDim2.fromScale(sizeScale.X, sizeScale.Y)
	piece.Position = UDim2.fromScale(posScale.X, posScale.Y)
	piece.AnchorPoint = Vector2.new(0.5, 0.5)
	piece.BackgroundColor3 = ctx.color
	piece.BackgroundTransparency = transparency or Theme.Alpha.opaque
	piece.BorderSizePixel = 0
	piece.Rotation = rotation or 0
	piece.ZIndex = ctx.zIndex
	piece.Parent = ctx.parent
	Theme.corner(piece, radius)
	return piece
end

local function circle(ctx: Ctx, diameter: number, at: Vector2): Frame
	return shape(ctx, Vector2.new(diameter, diameter), at, Theme.Radius.pill)
end

-- Ring: Kreis plus ausgestanzte Mitte in Hintergrundfarbe.
local function ring(ctx: Ctx, outer: number, inner: number, at: Vector2)
	circle(ctx, outer, at)
	local hole = circle(ctx, inner, at)
	hole.BackgroundColor3 = Theme.Color.bg1
	hole.ZIndex = ctx.zIndex + Theme.Depth.content
	return hole
end

local function bar(ctx: Ctx, w: number, h: number, at: Vector2, rotation: number?): Frame
	return shape(ctx, Vector2.new(w, h), at, Theme.Radius.chip, rotation)
end

local function diamond(ctx: Ctx, size: number, at: Vector2): Frame
	return shape(ctx, Vector2.new(size, size), at, Theme.Radius.chip, 45)
end

-- ==========================================================================
-- Glyphen
-- ==========================================================================

local MID = Vector2.new(0.5, 0.5)

local GLYPHS: { [string]: (Ctx) -> () } = {
	-- Muenze: Ring mit gefuellter Mitte und Kerbe
	cash = function(ctx)
		circle(ctx, 0.92, MID)
		local inner = circle(ctx, 0.62, MID)
		inner.BackgroundColor3 = Theme.Color.bg1
		inner.ZIndex = ctx.zIndex + Theme.Depth.content
		local mark = bar(ctx, 0.14, 0.44, MID)
		mark.ZIndex = ctx.zIndex + Theme.Depth.raised
	end,

	-- Edelstein: grosse Raute mit heller Facette
	gem = function(ctx)
		diamond(ctx, 0.72, MID)
		local facet = diamond(ctx, 0.3, Vector2.new(0.4, 0.4))
		facet.BackgroundColor3 = Theme.Color.textHigh
		facet.BackgroundTransparency = Theme.Alpha.veil
		facet.ZIndex = ctx.zIndex + Theme.Depth.content
	end,

	-- Kreisender Pfeil: Ring mit Luecke plus Spitze
	rebirth = function(ctx)
		ring(ctx, 0.92, 0.56, MID)
		local gap = bar(ctx, 0.34, 0.34, Vector2.new(0.78, 0.26))
		gap.BackgroundColor3 = Theme.Color.bg1
		gap.ZIndex = ctx.zIndex + Theme.Depth.raised
		local tip = diamond(ctx, 0.3, Vector2.new(0.76, 0.2))
		tip.ZIndex = ctx.zIndex + Theme.Depth.overlay
	end,

	-- Einkaufstasche: Koerper plus Henkel
	shop = function(ctx)
		shape(ctx, Vector2.new(0.78, 0.6), Vector2.new(0.5, 0.64), Theme.Radius.chip)
		ring(ctx, 0.46, 0.3, Vector2.new(0.5, 0.3))
		local cut = shape(ctx, Vector2.new(0.5, 0.26), Vector2.new(0.5, 0.46), Theme.Radius.chip)
		cut.BackgroundColor3 = Theme.Color.bg1
		cut.ZIndex = ctx.zIndex + Theme.Depth.content
	end,

	-- Pfeil nach oben im Ring
	upgrade = function(ctx)
		ring(ctx, 0.96, 0.7, MID)
		local stem = bar(ctx, 0.12, 0.4, Vector2.new(0.5, 0.54))
		stem.ZIndex = ctx.zIndex + Theme.Depth.raised
		local a = bar(ctx, 0.1, 0.3, Vector2.new(0.4, 0.4), 45)
		a.ZIndex = ctx.zIndex + Theme.Depth.raised
		local b = bar(ctx, 0.1, 0.3, Vector2.new(0.6, 0.4), -45)
		b.ZIndex = ctx.zIndex + Theme.Depth.raised
	end,

	-- Aufgabenliste: drei Zeilen, eine abgehakt
	quest = function(ctx)
		for index = 0, 2 do
			bar(ctx, 0.52, 0.1, Vector2.new(0.58, 0.24 + index * 0.26))
			local dot = circle(ctx, 0.16, Vector2.new(0.2, 0.24 + index * 0.26))
			dot.BackgroundTransparency = if index == 0
				then Theme.Alpha.opaque
				else Theme.Alpha.veil
		end
	end,

	-- Geschenk: Kasten plus Band
	code = function(ctx)
		shape(ctx, Vector2.new(0.86, 0.6), Vector2.new(0.5, 0.64), Theme.Radius.chip)
		shape(ctx, Vector2.new(0.94, 0.2), Vector2.new(0.5, 0.32), Theme.Radius.chip)
		local ribbon = bar(ctx, 0.14, 0.86, MID)
		ribbon.BackgroundColor3 = Theme.Color.bg1
		ribbon.ZIndex = ctx.zIndex + Theme.Depth.content
	end,

	-- Zahnrad: Ring plus vier Zaehne
	settings = function(ctx)
		for index = 0, 3 do
			bar(ctx, 0.2, 0.96, MID, index * 45)
		end
		ring(ctx, 0.72, 0.34, MID)
	end,

	-- Vorhaengeschloss
	lock = function(ctx)
		ring(ctx, 0.56, 0.32, Vector2.new(0.5, 0.32))
		local cut = shape(ctx, Vector2.new(0.6, 0.24), Vector2.new(0.5, 0.48), Theme.Radius.chip)
		cut.BackgroundColor3 = Theme.Color.bg1
		cut.ZIndex = ctx.zIndex + Theme.Depth.content
		local body = shape(ctx, Vector2.new(0.82, 0.5), Vector2.new(0.5, 0.7), Theme.Radius.chip)
		body.ZIndex = ctx.zIndex + Theme.Depth.raised
	end,

	check = function(ctx)
		bar(ctx, 0.12, 0.42, Vector2.new(0.34, 0.6), 45)
		bar(ctx, 0.12, 0.76, Vector2.new(0.6, 0.46), -45)
	end,

	close = function(ctx)
		bar(ctx, 0.14, 0.86, MID, 45)
		bar(ctx, 0.14, 0.86, MID, -45)
	end,

	plus = function(ctx)
		bar(ctx, 0.16, 0.8, MID)
		bar(ctx, 0.8, 0.16, MID)
	end,

	-- Bohrer: Schaft plus Spitze
	drill = function(ctx)
		shape(ctx, Vector2.new(0.36, 0.5), Vector2.new(0.5, 0.3), Theme.Radius.chip)
		diamond(ctx, 0.42, Vector2.new(0.5, 0.72))
		bar(ctx, 0.62, 0.12, Vector2.new(0.5, 0.16))
	end,

	-- Schmelzofen: Korpus plus gluehende Oeffnung
	furnace = function(ctx)
		shape(ctx, Vector2.new(0.82, 0.74), Vector2.new(0.5, 0.58), Theme.Radius.chip)
		local mouth = shape(ctx, Vector2.new(0.42, 0.3), Vector2.new(0.5, 0.66), Theme.Radius.chip)
		mouth.BackgroundColor3 = Theme.Color.bg1
		mouth.ZIndex = ctx.zIndex + Theme.Depth.content
		bar(ctx, 0.5, 0.12, Vector2.new(0.5, 0.14))
	end,

	-- Foerderband: Laufflaeche plus zwei Rollen
	belt = function(ctx)
		shape(ctx, Vector2.new(0.94, 0.26), MID, Theme.Radius.pill)
		local left = circle(ctx, 0.3, Vector2.new(0.22, 0.5))
		left.BackgroundColor3 = Theme.Color.bg1
		left.ZIndex = ctx.zIndex + Theme.Depth.content
		local right = circle(ctx, 0.3, Vector2.new(0.78, 0.5))
		right.BackgroundColor3 = Theme.Color.bg1
		right.ZIndex = ctx.zIndex + Theme.Depth.content
	end,

	-- Waage: Balken, Saeule, zwei Schalen
	scale = function(ctx)
		bar(ctx, 0.9, 0.12, Vector2.new(0.5, 0.3))
		bar(ctx, 0.12, 0.62, Vector2.new(0.5, 0.58))
		bar(ctx, 0.56, 0.12, Vector2.new(0.5, 0.88))
		circle(ctx, 0.22, Vector2.new(0.16, 0.48))
		circle(ctx, 0.22, Vector2.new(0.84, 0.48))
	end,
}

-- ==========================================================================
-- Oeffentlich
-- ==========================================================================

export type IconProps = {
	name: Name,
	parent: Instance?,
	size: number,
	color: Color3,
	zIndex: number,
	layoutOrder: number?,
	anchor: Vector2?,
	position: UDim2?,
}

function Icon.create(props: IconProps): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Icon_" .. props.name
	holder.Size = UDim2.fromOffset(props.size, props.size)
	holder.Position = props.position or UDim2.fromScale(0, 0)
	holder.AnchorPoint = props.anchor or Vector2.zero
	holder.BackgroundTransparency = Theme.Alpha.hidden
	holder.ZIndex = props.zIndex
	holder.LayoutOrder = props.layoutOrder or 0
	holder.Parent = props.parent

	local assetId = (Theme.Icon :: { [string]: string })[props.name]
	if assetId ~= nil and assetId ~= "" then
		local image = Instance.new("ImageLabel")
		image.Size = UDim2.fromScale(1, 1)
		image.BackgroundTransparency = Theme.Alpha.hidden
		image.Image = assetId
		image.ImageColor3 = props.color
		image.ZIndex = props.zIndex
		image.Parent = holder
		return holder
	end

	local draw = GLYPHS[props.name]
	if draw ~= nil then
		draw({ parent = holder, color = props.color, zIndex = props.zIndex })
	end
	return holder
end

-- Faerbt einen bereits gezeichneten Glyph um (z. B. bei Zustandswechsel).
function Icon.recolor(holder: Frame, color: Color3)
	for _, child in ipairs(holder:GetDescendants()) do
		if child:IsA("ImageLabel") then
			child.ImageColor3 = color
		elseif child:IsA("Frame") and child.BackgroundColor3 ~= Theme.Color.bg1 then
			child.BackgroundColor3 = color
		end
	end
end

return Icon
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX43">
						<Properties>
							<string name="Name">Layers</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Layers – feste ZIndex-Baender.

	Ohne zentrale Vergabe landet frueher oder spaeter ein Tooltip hinter
	einem Panel oder ein Toast hinter dem Modal-Overlay, und jemand
	"repariert" das mit ZIndex = 9999. Die Baender aus Theme.Layer sind
	100 breit; innerhalb eines Bandes vergibt Theme.Depth die Feinstufen.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local Layers = {}

export type Band = "world" | "hud" | "panel" | "modal" | "toast" | "tooltip"

function Layers.base(band: Band): number
	return (Theme.Layer :: { [string]: number })[band]
end

-- Ebene innerhalb eines Bandes: Layers.at("panel", Theme.Depth.content)
function Layers.at(band: Band, depth: number): number
	return Layers.base(band) + depth
end

return Layers
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX44">
						<Properties>
							<string name="Name">Motion</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Motion – jede Bewegung im Spiel laeuft hier durch.

	Zwei Gruende fuer eine eigene Schicht statt direkter TweenService-Aufrufe:

	  1. Aufraeumen. Ein Tween haelt eine Referenz auf seine Instanz. Wird
	     ein Panel zerstoert, waehrend ein Tween laeuft, laeuft der Tween
	     weiter und schreibt auf ein totes Objekt. Ueber `Scope` gehoert
	     jeder Tween zu einem Besitzer und wird mit ihm abgebrochen.
	  2. Reduzierte Bewegung. Theme.duration() gibt bei aktivem
	     "Reduce Motion" 0 zurueck. Ein Tween mit Dauer 0 setzt den Zielwert
	     sofort - das Layout bleibt identisch, nur die Interpolation faellt
	     weg. Es gibt deshalb keinen zweiten Codepfad dafuer.
]]

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local Motion = {}

export type Scope = {
	_tweens: { Tween },
	_connections: { RBXScriptConnection },
	_dead: boolean,

	to: (self: Scope, target: Instance, goal: { [string]: any },
	     seconds: number, easing: string?) -> Tween,
	track: (self: Scope, connection: RBXScriptConnection) -> RBXScriptConnection,
	cancel: (self: Scope) -> (),
	destroy: (self: Scope) -> (),
}

local ScopeImpl = {}
ScopeImpl.__index = ScopeImpl

function Motion.scope(): Scope
	return (setmetatable(
		{ _tweens = {}, _connections = {}, _dead = false },
		ScopeImpl
	) :: any) :: Scope
end

function ScopeImpl.to(self: Scope, target: Instance, goal: { [string]: any },
	seconds: number, easing: string?): Tween
	local tween = TweenService:Create(target, Theme.tweenInfo(seconds, easing), goal)
	if self._dead then
		-- Nach dem Aufraeumen darf nichts mehr starten, sonst haengt ein
		-- Tween an einem Panel, das gerade geschlossen wurde.
		return tween
	end
	table.insert(self._tweens, tween)
	-- Beendete Tweens aus der Liste nehmen, sonst waechst sie bei einem
	-- oft geoeffneten Panel unbegrenzt.
	tween.Completed:Once(function()
		local index = table.find(self._tweens, tween)
		if index ~= nil then
			table.remove(self._tweens, index)
		end
	end)
	tween:Play()
	return tween
end

function ScopeImpl.track(self: Scope, connection: RBXScriptConnection): RBXScriptConnection
	table.insert(self._connections, connection)
	return connection
end

function ScopeImpl.cancel(self: Scope)
	for _, tween in ipairs(self._tweens) do
		tween:Cancel()
		tween:Destroy()
	end
	table.clear(self._tweens)
end

function ScopeImpl.destroy(self: Scope)
	self._dead = true
	self:cancel()
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
end

-- Anzahl laufender Tweens - fuer den Leak-Test.
function Motion.liveCount(scope: Scope): number
	return #scope._tweens
end

return Motion
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX45">
						<Properties>
							<string name="Name">Preview</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Preview – echte 3D-Vorschau im ViewportFrame.

	Warum kein flaches Icon: ein Shop-Eintrag, der das Objekt zeigt, das
	man kauft, verkauft sich besser als ein Symbol. Ein ViewportFrame
	rendert ein Modell mit eigener Kamera, unabhaengig von der Weltkamera.

	Die Modelle werden HIER aus Parts gebaut, nicht aus Assets geladen -
	dadurch braucht die Vorschau keine hochgeladene Mesh-Id und passt
	farblich automatisch zum Theme.

	Beleuchtung im ViewportFrame: es gibt keine Lights darin. Steuerbar
	sind nur LightColor und Ambient des ViewportFrame selbst. Neon-Teile
	leuchten dort NICHT wie in der Welt - deshalb wird der Glanz ueber
	hell eingefaerbte Teile gemacht, nicht ueber Material.Neon.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent
local Motion = require(UI.Motion)

local Preview = {}

export type Kind = "dropper" | "upgrader" | "collector" | "rate" | "speed" | "cosmetic"

export type Handle = {
	instance: ViewportFrame,
	destroy: (() -> ()),
	setTint: (color: Color3) -> (),
}

local function block(parent: Instance, size: Vector3, offset: Vector3,
	color: Color3, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = CFrame.new(offset)
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function wedge(parent: Instance, size: Vector3, cframe: CFrame,
	color: Color3, material: Enum.Material): WedgePart
	local part = Instance.new("WedgePart")
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.Parent = parent
	return part
end

--[[
	Ein kleines Modell je Upgrade-Art. Alle sind so gebaut, dass sie in
	einen Wuerfel von etwa 4 Studs passen - dann braucht die Kamera keine
	Fallunterscheidung.
]]
local function buildModel(kind: Kind, accent: Color3): Model
	local model = Instance.new("Model")
	local steel = Theme.Color.bg3
	local dark = Theme.Color.bg1

	if kind == "dropper" then
		block(model, Vector3.new(2.2, 1.8, 2.2), Vector3.new(0, 0.9, 0), steel, Theme.Material.metal)
		block(model, Vector3.new(1, 0.8, 1), Vector3.new(0, -0.2, 0), accent, Theme.Material.surface)
		block(model, Vector3.new(2.6, 0.3, 2.6), Vector3.new(0, 1.95, 0), dark, Theme.Material.brushed)
		-- Gefaste Oberkante statt Kloetzchen-Look
		wedge(model, Vector3.new(2.2, 0.5, 0.6),
			CFrame.new(0, 2.3, -0.8), accent, Theme.Material.surface)
	elseif kind == "upgrader" then
		block(model, Vector3.new(0.4, 2.6, 0.4), Vector3.new(-1.1, 1.3, 0), steel, Theme.Material.metal)
		block(model, Vector3.new(0.4, 2.6, 0.4), Vector3.new(1.1, 1.3, 0), steel, Theme.Material.metal)
		block(model, Vector3.new(2.6, 0.4, 0.4), Vector3.new(0, 2.6, 0), steel, Theme.Material.metal)
		local field = block(model, Vector3.new(1.9, 2.2, 0.15), Vector3.new(0, 1.3, 0),
			accent, Theme.Material.surface)
		field.Transparency = Theme.Alpha.veil
	elseif kind == "collector" then
		block(model, Vector3.new(2.6, 1.6, 2), Vector3.new(0, 0.8, 0), steel, Theme.Material.metal)
		block(model, Vector3.new(1.4, 0.35, 1.4), Vector3.new(0, 1.75, 0), accent, Theme.Material.surface)
		block(model, Vector3.new(0.35, 1.2, 0.35), Vector3.new(0, 2.3, 0), steel, Theme.Material.metal)
		block(model, Vector3.new(1.8, 0.25, 0.25), Vector3.new(0, 2.9, 0), accent, Theme.Material.surface)
	elseif kind == "rate" then
		block(model, Vector3.new(1.6, 1.6, 1.6), Vector3.new(0, 0.9, 0), steel, Theme.Material.metal)
		for index = 0, 2 do
			wedge(model, Vector3.new(0.3, 0.8, 0.8),
				CFrame.new(-0.9 + index * 0.9, 2.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
				accent, Theme.Material.surface)
		end
	elseif kind == "speed" then
		block(model, Vector3.new(3.4, 0.3, 1.5), Vector3.new(0, 1, 0), dark, Theme.Material.brushed)
		block(model, Vector3.new(0.5, 0.5, 1.7), Vector3.new(-1.6, 1, 0), steel, Theme.Material.metal)
		block(model, Vector3.new(0.5, 0.5, 1.7), Vector3.new(1.6, 1, 0), steel, Theme.Material.metal)
		block(model, Vector3.new(0.6, 0.6, 0.6), Vector3.new(-0.4, 1.4, 0), accent, Theme.Material.surface)
		block(model, Vector3.new(0.6, 0.6, 0.6), Vector3.new(0.8, 1.4, 0), accent, Theme.Material.surface)
	else -- cosmetic
		block(model, Vector3.new(2.8, 0.3, 2.8), Vector3.new(0, 0.15, 0), dark, Theme.Material.concrete)
		block(model, Vector3.new(2.8, 1.8, 0.25), Vector3.new(0, 1.05, -1.3), steel, Theme.Material.metal)
		block(model, Vector3.new(0.25, 1.8, 2.6), Vector3.new(-1.3, 1.05, 0), steel, Theme.Material.metal)
		wedge(model, Vector3.new(2.8, 0.9, 2.8),
			CFrame.new(0, 2.4, 0), accent, Theme.Material.surface)
	end

	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("BasePart") then
			model.PrimaryPart = child
			break
		end
	end
	return model
end

export type Props = {
	parent: Instance,
	kind: Kind,
	accent: Color3,
	size: UDim2,
	zIndex: number,
	spin: boolean?,
}

function Preview.create(props: Props): Handle
	local scope = Motion.scope()

	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "Preview"
	viewport.Size = props.size
	viewport.BackgroundColor3 = Theme.Color.bg0
	viewport.BackgroundTransparency = Theme.Alpha.opaque
	viewport.BorderSizePixel = 0
	viewport.ZIndex = props.zIndex
	-- Ambient und LightColor sind die einzigen Lichtregler eines
	-- ViewportFrame; echte Light-Instanzen wirken darin nicht.
	viewport.Ambient = Theme.Color.bg3
	viewport.LightColor = Theme.Color.textHigh
	viewport.LightDirection = Vector3.new(-1, -1.4, -0.8)
	viewport.Parent = props.parent
	Theme.corner(viewport, Theme.Radius.control)

	local world = Instance.new("WorldModel")
	world.Parent = viewport

	local model = buildModel(props.kind, props.accent)
	model.Parent = world

	local camera = Instance.new("Camera")
	camera.FieldOfView = Theme.Size.iconButton
	camera.CFrame = CFrame.lookAt(Vector3.new(4.2, 4.0, 4.2), Vector3.new(0, 1.2, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	-- Langsame Drehung. Bei reduzierter Bewegung steht das Modell still.
	local spinConnection: RBXScriptConnection? = nil
	if props.spin ~= false and not Theme.reduceMotion then
		local angle = 0
		spinConnection = scope:track(
			game:GetService("RunService").RenderStepped:Connect(function(delta: number)
				angle += delta * Theme.Duration.fast
				model:PivotTo(CFrame.Angles(0, angle, 0))
			end)
		)
	end

	return {
		instance = viewport,
		setTint = function(color: Color3)
			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") and part.Color == props.accent then
					part.Color = color
				end
			end
		end,
		destroy = function()
			if spinConnection ~= nil then
				spinConnection:Disconnect()
			end
			scope:destroy()
			viewport:Destroy()
		end,
	}
end

return Preview
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX46">
						<Properties>
							<string name="Name">Responsive</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Responsive – ein UIScale pro ScreenGui plus Sicherheitsabstaende.

	Skalierung: Referenz 1920x1080 = 1.0, begrenzt auf 0.72 bis 1.25.
	Gerechnet wird gegen BEIDE Achsen (kleinerer Wert gewinnt), damit ein
	sehr breites oder sehr flaches Fenster nichts aus dem Bild schiebt.

	Wichtig fuer die Abnahme "Touch-Ziel >= 44 px NACH UIScale": weil die
	Untergrenze 0.72 ist, muss jede Tippflaeche im Entwurf mindestens
	44 / 0.72 = 62 px gross sein. Theme.Size.controlHeight (44) allein
	reicht also NICHT - deshalb liefert minTouchSize() die noetige
	Entwurfsgroesse, und tools/layout_check.py prueft sie nach.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local Responsive = {}

export type Viewport = {
	width: number,
	height: number,
	scale: number,
	portrait: boolean,
	compact: boolean,
	topInset: number,
	bottomInset: number,
}

function Responsive.scaleFor(width: number, height: number): number
	local rule = Theme.ScaleRule
	local factor = math.min(width / rule.referenceWidth, height / rule.referenceHeight)
	return math.clamp(factor, rule.min, rule.max)
end

-- Entwurfsgroesse, die nach der kleinstmoeglichen Skalierung noch 44 px ergibt.
function Responsive.minTouchSize(): number
	return math.ceil(Theme.Size.touchMin / Theme.ScaleRule.min)
end

function Responsive.read(gui: ScreenGui): Viewport
	local size = gui.AbsoluteSize
	-- Im ersten Frame ist AbsoluteSize noch (0,0).
	local width = if size.X > 0 then size.X else Theme.ScaleRule.referenceWidth
	local height = if size.Y > 0 then size.Y else Theme.ScaleRule.referenceHeight
	local portrait = height > width
	local compact = math.min(width, height) < Theme.ScaleRule.referenceHeight / 2

	--[[
		Die ScreenGui laeuft mit IgnoreGuiInset = false. Roblox zieht die
		Topbar-Hoehe dann BEREITS von der nutzbaren Flaeche ab - der
		Nullpunkt liegt unterhalb der Topbar. Hier noch einmal
		Theme.Safe.top zu addieren waere doppelt gezaehlt und wuerde auf
		dem Handy ein Drittel des Bildes verschenken. Es bleibt also nur
		der normale Randabstand.
	]]
	local topInset = Theme.Safe.edge
	local bottomInset = if portrait or compact
		then Theme.Safe.bottomMobile
		else Theme.Safe.edge

	return {
		width = width,
		height = height,
		scale = Responsive.scaleFor(width, height),
		portrait = portrait,
		compact = compact,
		topInset = topInset,
		bottomInset = bottomInset,
	}
end

--[[
	Haengt die globale UIScale an den Wurzelcontainer und ruft `onChange`
	bei jeder Groessenaenderung auf.

	Die UIScale sitzt auf einem Vollbild-Container mit AnchorPoint (0,0);
	dadurch skaliert sie den Inhalt vom linken oberen Eck aus. Damit
	unten und rechts verankerte Elemente trotzdem am Rand bleiben, werden
	sie ueber AnchorPoint und Scale-Position gesetzt (nie ueber feste
	Pixelpositionen) - dann verschiebt die Skalierung nur ihre Groesse.
]]
function Responsive.attach(gui: ScreenGui, root: GuiObject,
	onChange: (viewport: Viewport) -> ()): UIScale
	local scale = Instance.new("UIScale")
	scale.Parent = root

	local function apply()
		local viewport = Responsive.read(gui)
		scale.Scale = viewport.scale
		onChange(viewport)
	end
	apply()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(apply)
	return scale
end

return Responsive
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX47">
						<Properties>
							<string name="Name">Types</string>
							<bool name="Disabled">false</bool>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Types – gemeinsamer Vertrag aller UI-Komponenten.

	Jede Komponente liefert `instance` (zum Einhaengen ins Layout) und
	`destroy` (zum Aufraeumen von Tweens, Verbindungen und Instanz).
	Ohne diesen Vertrag muesste jeder Bildschirm wissen, wie er welche
	Komponente aufzuraeumen hat.
]]

export type Component = {
	instance: GuiObject,
	destroy: (() -> ()),
}

export type ButtonState = "idle" | "hover" | "pressed" | "disabled" | "loading"

return {}
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="Folder" referent="RBX62">
						<Properties>
							<string name="Name">Components</string>
						</Properties>
						<Item class="ModuleScript" referent="RBX48">
							<Properties>
								<string name="Name">Badge</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Badge – kleiner Marker fuer ungelesene oder abholbare Inhalte.

	Zwei Formen: reiner Punkt (ohne Zahl) und Zahlenkapsel. Sitzt immer in
	der oberen rechten Ecke seines Elternelements und liegt eine Feinstufe
	darueber, damit ihn kein Icon verdeckt.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Motion = require(UI.Motion)

local Badge = {}

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
	set: (visible: boolean, count: number?) -> (),
}

function Badge.create(parent: GuiObject, zIndex: number): Handle
	local scope = Motion.scope()

	local dot = Instance.new("Frame")
	dot.Name = "Badge"
	dot.Size = UDim2.fromOffset(Theme.Size.badge, Theme.Size.badge)
	dot.Position = UDim2.fromScale(1, 0)
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.BackgroundColor3 = Theme.Color.danger
	dot.BorderSizePixel = 0
	dot.ZIndex = zIndex
	dot.Visible = false
	dot.Parent = parent
	Theme.corner(dot, Theme.Radius.pill)
	-- Dunkler Ring: hebt den Marker von jeder Untergrundfarbe ab.
	Theme.stroke(dot, Theme.Color.bg0, Theme.Stroke.thin)

	local count = Theme.label({
		name = "Count", parent = dot, text = "", role = "numeric",
		size = Theme.TextSize.xs, color = Theme.Color.bg0,
		xAlign = Enum.TextXAlignment.Center,
		zIndex = zIndex + Theme.Depth.content, stroke = false,
	})

	local scale = Instance.new("UIScale")
	scale.Parent = dot

	return {
		instance = dot,
		set = function(visible: boolean, value: number?)
			if visible and not dot.Visible then
				dot.Visible = true
				scale.Scale = Theme.Scale.panelEnter
				scope:to(scale, { Scale = Theme.Scale.rest }, Theme.Duration.base, "pop")
			elseif not visible and dot.Visible then
				dot.Visible = false
			end
			if value ~= nil and value > 0 then
				count.Text = tostring(value)
				dot.Size = UDim2.fromOffset(Theme.Size.badge + Theme.Space.x8, Theme.Size.badge)
			else
				count.Text = ""
				dot.Size = UDim2.fromOffset(Theme.Size.badge, Theme.Size.badge)
			end
		end,
		destroy = function()
			scope:destroy()
			dot:Destroy()
		end,
	}
end

return Badge
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX49">
							<Properties>
								<string name="Name">Button</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Button – die Standardaktion.

	Varianten: primary, secondary, ghost, danger, premium, success.
	Zustaende: idle, hover, pressed, disabled, loading.

	Aufbau (vier Ebenen, mehr nicht):
	  TextButton (Flaeche, Radius, Rand, Verlauf)
	   +- UIScale        (Hover/Press-Feedback, veraendert NICHT die Groesse
	   |                  im Layout - sonst rechnet das UIListLayout jeden
	   |                  Frame neu und die Liste zappelt)
	   +- UIPadding      (Text klebt nie am Rand)
	   +- Inhalt         (Icon + Label in einem UIListLayout)

	Auf Touchgeraeten gibt es keinen Hover-Zustand - ein haengengebliebener
	Hover nach dem Antippen sieht aus wie ein Fehler.
]]

local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Icon = require(UI.Icon)
local Motion = require(UI.Motion)
local Types = require(UI.Types)

local Button = {}

export type Props = {
	parent: Instance?,
	text: string,
	variant: Theme.Variant?,
	icon: Icon.Name?,
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	zIndex: number,
	layoutOrder: number?,
	textSize: number?,
	onActivated: (() -> ())?,
}

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
	setState: (state: Types.ButtonState) -> (),
	setText: (text: string) -> (),
	setVariant: (variant: Theme.Variant) -> (),
	shake: () -> (),
	pulse: (color: Color3) -> (),
}

function Button.create(props: Props): Handle
	local variant: Theme.Variant = props.variant or "primary"
	local colors = Theme.variant(variant)
	local scope = Motion.scope()
	local state: Types.ButtonState = "idle"
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled

	local button = Instance.new("TextButton")
	button.Name = "Button"
	button.Size = props.size or UDim2.new(1, 0, 0, Theme.Size.controlHeight)
	button.Position = props.position or UDim2.fromScale(0, 0)
	button.AnchorPoint = props.anchor or Vector2.zero
	button.BackgroundColor3 = colors.fill
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	button.ZIndex = props.zIndex
	button.LayoutOrder = props.layoutOrder or 0
	button.Parent = props.parent

	Theme.corner(button, Theme.Radius.control)
	local stroke = Theme.stroke(button, colors.border, Theme.Stroke.thin)
	local gradient = Theme.gradient(button, colors.fill, Theme.Elevation.transparency / Theme.Space.x8)
	Theme.padding(button, { left = Theme.Space.x12, right = Theme.Space.x12 })

	local scale = Instance.new("UIScale")
	scale.Parent = button

	-- Inhalt: Icon und Text nebeneinander, zentriert, ueber ein Layout.
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.Size = UDim2.fromScale(1, 1)
	content.BackgroundTransparency = Theme.Alpha.hidden
	content.ZIndex = props.zIndex + Theme.Depth.content
	content.Parent = button
	Theme.list({
		parent = content, gap = Theme.Space.x8,
		direction = Enum.FillDirection.Horizontal,
		hAlign = Enum.HorizontalAlignment.Center,
		vAlign = Enum.VerticalAlignment.Center,
	})

	local iconHolder: Frame? = nil
	if props.icon ~= nil then
		iconHolder = Icon.create({
			name = props.icon, parent = content, size = Theme.Size.iconSm,
			color = colors.label, zIndex = props.zIndex + Theme.Depth.raised,
			layoutOrder = 1,
		})
	end

	local label = Theme.label({
		name = "Text", parent = content, text = props.text, role = "heading",
		size = props.textSize or Theme.TextSize.md, color = colors.label,
		layoutSize = UDim2.fromOffset(0, Theme.Size.controlHeight),
		autoSize = Enum.AutomaticSize.X,
		xAlign = Enum.TextXAlignment.Center,
		zIndex = props.zIndex + Theme.Depth.raised,
		layoutOrder = 2,
		-- Auf gefuellten Akzentflaechen ist der Kontrast rechnerisch
		-- gesichert; eine Kontur wuerde die Schrift dort nur verschmieren.
		stroke = variant == "ghost" or variant == "secondary",
	})

	-- Ladeanzeige: rotierender Ring, ersetzt den Text.
	local spinner = Instance.new("Frame")
	spinner.Name = "Spinner"
	spinner.Size = UDim2.fromOffset(Theme.Size.iconSm, Theme.Size.iconSm)
	spinner.Position = UDim2.fromScale(0.5, 0.5)
	spinner.AnchorPoint = Vector2.new(0.5, 0.5)
	spinner.BackgroundTransparency = Theme.Alpha.hidden
	spinner.ZIndex = props.zIndex + Theme.Depth.overlay
	spinner.Visible = false
	spinner.Parent = button
	local spinnerArc = Instance.new("Frame")
	spinnerArc.Size = UDim2.fromScale(1, 1)
	spinnerArc.BackgroundTransparency = Theme.Alpha.hidden
	spinnerArc.ZIndex = spinner.ZIndex
	spinnerArc.Parent = spinner
	Theme.stroke(spinnerArc, colors.label, Theme.Stroke.thin)
	Theme.corner(spinnerArc, Theme.Radius.pill)
	local notch = Instance.new("Frame")
	notch.Size = UDim2.fromScale(0.5, 0.5)
	notch.BackgroundColor3 = colors.fill
	notch.BorderSizePixel = 0
	notch.ZIndex = spinner.ZIndex + Theme.Depth.content
	notch.Parent = spinnerArc
	local spinTween: Tween? = nil

	-- ---- Zustandslogik ---------------------------------------------------

	local function fillFor(current: Types.ButtonState): Color3
		if current == "hover" then
			return colors.fillHover
		elseif current == "pressed" then
			return colors.fillPressed
		end
		return colors.fill
	end

	local function apply(next_: Types.ButtonState, duration: number)
		state = next_
		local disabled = next_ == "disabled"
		local loading = next_ == "loading"

		button.Active = not (disabled or loading)
		button.AutoButtonColor = false
		content.Visible = not loading
		spinner.Visible = loading

		local targetScale = if next_ == "hover" then Theme.Scale.hover
			elseif next_ == "pressed" then Theme.Scale.pressed
			else Theme.Scale.rest

		scope:to(button, {
			BackgroundColor3 = fillFor(next_),
			-- Deaktiviert: Flaeche halbdurchlaessig, damit sie sich
			-- eindeutig von "nur dunkler" unterscheidet.
			BackgroundTransparency = if disabled then Theme.Alpha.ghost else Theme.Alpha.opaque,
		}, duration, "enter")
		scope:to(scale, { Scale = targetScale }, duration, if next_ == "pressed" then "press" else "enter")
		scope:to(stroke, {
			Transparency = if disabled then Theme.Alpha.veil else Theme.Alpha.opaque,
		}, duration, "enter")
		scope:to(label, {
			TextTransparency = if disabled then Theme.Alpha.veil else Theme.Alpha.opaque,
		}, duration, "enter")

		if loading then
			local info = Theme.loopInfo(Theme.Duration.spin)
			if info ~= nil and spinTween == nil then
				spinTween = game:GetService("TweenService"):Create(
					spinnerArc, info, { Rotation = 360 })
				local active = spinTween
				if active ~= nil then
					active:Play()
				end
			end
		elseif spinTween ~= nil then
			spinTween:Cancel()
			spinTween:Destroy()
			spinTween = nil
			spinnerArc.Rotation = 0
		end
	end

	-- ---- Eingaben ----------------------------------------------------------

	if not touch then
		scope:track(button.MouseEnter:Connect(function()
			if state == "idle" then
				apply("hover", Theme.Duration.fast)
			end
		end))
		scope:track(button.MouseLeave:Connect(function()
			if state == "hover" or state == "pressed" then
				apply("idle", Theme.Duration.fast)
			end
		end))
	end

	scope:track(button.MouseButton1Down:Connect(function()
		if state == "disabled" or state == "loading" then
			return
		end
		apply("pressed", Theme.Duration.press)
	end))
	scope:track(button.MouseButton1Up:Connect(function()
		if state == "disabled" or state == "loading" then
			return
		end
		-- Loslassen federt ueber Back/Out zurueck.
		state = if touch then "idle" else "hover"
		scope:to(button, { BackgroundColor3 = fillFor(state) }, Theme.Duration.fast, "enter")
		scope:to(scale, { Scale = Theme.Scale.rest }, Theme.Duration.base, "pop")
	end))
	scope:track(button.Activated:Connect(function()
		if state == "disabled" or state == "loading" then
			return
		end
		local callback = props.onActivated
		if callback ~= nil then
			callback()
		end
	end))

	apply("idle", Theme.Duration.fast)

	-- ---- Handle -------------------------------------------------------------

	local handle: Handle
	handle = {
		instance = button,

		setState = function(next_: Types.ButtonState)
			apply(next_, Theme.Duration.fast)
		end,

		setText = function(text: string)
			label.Text = text
		end,

		setVariant = function(nextVariant: Theme.Variant)
			colors = Theme.variant(nextVariant)
			stroke.Color = colors.border
			label.TextColor3 = colors.label
			notch.BackgroundColor3 = colors.fill
			gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, colors.fill),
				ColorSequenceKeypoint.new(1, colors.fill),
			})
			if iconHolder ~= nil then
				Icon.recolor(iconHolder, colors.label)
			end
			apply(state, Theme.Duration.fast)
		end,

		--[[
			Fehlermeldung ohne Popup: kurzes horizontales Ruetteln.
			Drei Schwingungen in Theme.Duration.shake, danach exakt zurueck
			auf die Ausgangsposition - sonst wandert der Knopf im Layout.
		]]
		shake = function()
			local home = button.Position
			local amount = Theme.Space.x8 - Theme.Space.x2
			local step = Theme.Duration.shake / Theme.Space.x4
			local offsets = { amount, -amount, amount * 0.6, -amount * 0.6, 0 }
			task.spawn(function()
				for _, dx in ipairs(offsets) do
					scope:to(button, {
						Position = home + UDim2.fromOffset(dx, 0),
					}, step, "enter")
					task.wait(step)
				end
				button.Position = home
			end)
		end,

		-- Einmaliges Aufleuchten, z. B. nach erfolgreichem Kauf.
		pulse = function(color: Color3)
			scope:to(stroke, { Color = color, Thickness = Theme.Stroke.thick },
				Theme.Duration.fast, "pop")
			task.delay(Theme.Duration.base, function()
				if button.Parent == nil then
					return
				end
				scope:to(stroke, { Color = colors.border, Thickness = Theme.Stroke.thin },
					Theme.Duration.slow, "exit")
			end)
		end,

		destroy = function()
			if spinTween ~= nil then
				spinTween:Cancel()
				spinTween:Destroy()
				spinTween = nil
			end
			scope:destroy()
			button:Destroy()
		end,
	}
	return handle
end

return Button
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX50">
							<Properties>
								<string name="Name">Card</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Card – duenne Huelle um Theme.Card, damit Bildschirme eine Komponente
	mit Cleanup verwenden statt die Factory direkt.

	Die vier Schichten (Schatten, Flaeche, Rand, Verlauf) liegen bewusst
	in Theme.Card und nicht hier: auch Weltobjekte und Panels nutzen sie,
	und eine zweite Implementierung wuerde unweigerlich abweichen.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local Card = {}

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
}

function Card.create(props: Theme.CardProps): Handle
	local frame = Theme.Card(props)
	return {
		instance = frame,
		destroy = function()
			frame:Destroy()
		end,
	}
end

return Card
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX51">
							<Properties>
								<string name="Name">CurrencyPill</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CurrencyPill – Guthabenanzeige im HUD.

	Aufbau: rundes Icon-Feld in Akzentfarbe, Zahl rechts davon,
	optionaler Plus-Knopf ganz rechts.

	Zwei Details, die den Unterschied machen:

	  * Die Zahl zaehlt hoch statt zu springen. Ein NumberValue wird
	    getweent, sein Changed-Ereignis formatiert den Text. Bei
	    reduzierter Bewegung ist die Tweendauer 0 und der Wert steht sofort.
	  * Die Zahl ist RECHTSBUENDIG in einem Feld fester Breite. Gotham hat
	    keine Tabellenziffern; linksbuendig wuerde der Text bei jeder
	    Stellenaenderung sichtbar zappeln.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Format)
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Icon = require(UI.Icon)
local Motion = require(UI.Motion)

local CurrencyPill = {}

export type Props = {
	parent: Instance?,
	icon: Icon.Name,
	caption: string,
	accent: Color3,
	zIndex: number,
	layoutOrder: number?,
	onPlus: (() -> ())?,
}

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
	setValue: (value: number) -> (),
	flashError: () -> (),
}

function CurrencyPill.create(props: Props): Handle
	local scope = Motion.scope()

	local card = Theme.Card({
		name = "Pill_" .. props.icon,
		parent = props.parent,
		size = UDim2.fromOffset(Theme.Size.pillWidth, Theme.Size.pillHeight),
		fill = Theme.Color.bg2,
		radius = Theme.Radius.pill,
		zIndex = props.zIndex,
	})
	card.LayoutOrder = props.layoutOrder or 0
	Theme.padding(card, { all = Theme.Space.x4, right = Theme.Space.x12 })

	-- Rundes Icon-Feld
	local badge = Instance.new("Frame")
	badge.Name = "IconField"
	badge.Size = UDim2.fromOffset(Theme.Size.pillIcon + Theme.Space.x8,
		Theme.Size.pillIcon + Theme.Space.x8)
	badge.Position = UDim2.fromScale(0, 0.5)
	badge.AnchorPoint = Vector2.new(0, 0.5)
	badge.BackgroundColor3 = props.accent
	badge.BorderSizePixel = 0
	badge.ZIndex = props.zIndex + Theme.Depth.content
	badge.Parent = card
	Theme.corner(badge, Theme.Radius.pill)
	Theme.gradient(badge, props.accent, Theme.Elevation.transparency / Theme.Space.x8)
	Icon.create({
		name = props.icon, parent = badge, size = Theme.Size.iconInner,
		color = Theme.Color.bg0, zIndex = props.zIndex + Theme.Depth.raised,
		anchor = Vector2.new(0.5, 0.5), position = UDim2.fromScale(0.5, 0.5),
	})

	Theme.label({
		name = "Caption", parent = card, text = props.caption, role = "body",
		size = Theme.TextSize.xs, color = Theme.Color.textLow,
		layoutSize = UDim2.new(1, -(Theme.Size.pillIcon + Theme.Space.x32), 0, Theme.Space.x16),
		position = UDim2.fromOffset(Theme.Size.pillIcon + Theme.Space.x16, Theme.Space.x4),
		zIndex = props.zIndex + Theme.Depth.content, stroke = false,
	})

	local value = Theme.label({
		name = "Value", parent = card, text = "0", role = "numeric",
		size = Theme.TextSize.lg, color = Theme.Color.textHigh,
		layoutSize = UDim2.new(1, -(Theme.Size.pillIcon + Theme.Space.x32), 0, Theme.Space.x24),
		position = UDim2.fromOffset(Theme.Size.pillIcon + Theme.Space.x16, Theme.Space.x16),
		-- Rechtsbuendig: siehe Kopfkommentar (Ziffern zappeln sonst).
		xAlign = Enum.TextXAlignment.Right,
		zIndex = props.zIndex + Theme.Depth.content,
	})

	-- Der getweente Zwischenwert fuer das Hochzaehlen.
	local counter = Instance.new("NumberValue")
	counter.Parent = card
	local displayed = 0

	scope:track(counter.Changed:Connect(function(current: number)
		value.Text = Format.abbreviate(current)
	end))

	return {
		instance = card,

		setValue = function(target: number)
			if target == displayed then
				return
			end
			-- Farbe kurz anpassen: Zuwachs gruen, Abzug in Akzentfarbe.
			local rising = target > displayed
			displayed = target
			scope:to(counter, { Value = target }, Theme.Duration.countUp, "enter")
			scope:to(value, {
				TextColor3 = if rising then Theme.Color.success else props.accent,
			}, Theme.Duration.fast, "enter")
			task.delay(Theme.Duration.countUp, function()
				if card.Parent == nil then
					return
				end
				scope:to(value, { TextColor3 = Theme.Color.textHigh },
					Theme.Duration.slow, "exit")
			end)
		end,

		-- "Zu wenig Geld": Zahl blinkt rot, kein Popup.
		flashError = function()
			scope:to(value, { TextColor3 = Theme.Color.danger }, Theme.Duration.press, "enter")
			task.delay(Theme.Duration.slow, function()
				if card.Parent == nil then
					return
				end
				scope:to(value, { TextColor3 = Theme.Color.textHigh },
					Theme.Duration.base, "exit")
			end)
		end,

		destroy = function()
			scope:destroy()
			card:Destroy()
		end,
	}
end

return CurrencyPill
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX52">
							<Properties>
								<string name="Name">EmptyState</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	EmptyState – was da steht, wenn eine Liste leer ist.

	Eine leere ScrollingFrame ohne Erklaerung wirkt wie ein Ladefehler.
	Deshalb: gedaempftes Symbol, eine Ueberschrift, ein Satz Erklaerung.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Icon = require(UI.Icon)

local EmptyState = {}

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
	setVisible: (visible: boolean) -> (),
}

function EmptyState.create(parent: Instance, icon: Icon.Name, title: string,
	body: string, zIndex: number): Handle
	local holder = Instance.new("Frame")
	holder.Name = "EmptyState"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = Theme.Alpha.hidden
	holder.ZIndex = zIndex
	holder.Visible = false
	holder.Parent = parent

	local column = Instance.new("Frame")
	column.Size = UDim2.new(1, -Theme.Space.x48, 0, 0)
	column.Position = UDim2.fromScale(0.5, 0.5)
	column.AnchorPoint = Vector2.new(0.5, 0.5)
	column.AutomaticSize = Enum.AutomaticSize.Y
	column.BackgroundTransparency = Theme.Alpha.hidden
	column.ZIndex = zIndex
	column.Parent = holder
	Theme.list({
		parent = column, gap = Theme.Space.x12,
		hAlign = Enum.HorizontalAlignment.Center,
	})

	local glyph = Icon.create({
		name = icon, parent = column, size = Theme.Size.pillIcon,
		color = Theme.Color.textLow, zIndex = zIndex + Theme.Depth.content,
		layoutOrder = 1,
	})
	glyph.LayoutOrder = 1

	Theme.label({
		parent = column, text = title, role = "heading",
		size = Theme.TextSize.lg, color = Theme.Color.textMid,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x24),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = zIndex + Theme.Depth.content, layoutOrder = 2, stroke = false,
	})
	Theme.label({
		parent = column, text = body, role = "body",
		size = Theme.TextSize.sm, color = Theme.Color.textLow,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x48),
		xAlign = Enum.TextXAlignment.Center, wrapped = true,
		zIndex = zIndex + Theme.Depth.content, layoutOrder = 3, stroke = false,
	})

	return {
		instance = holder,
		setVisible = function(visible: boolean)
			holder.Visible = visible
		end,
		destroy = function()
			holder:Destroy()
		end,
	}
end

return EmptyState
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX53">
							<Properties>
								<string name="Name">IconButton</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	IconButton – quadratischer Knopf fuer die HUD-Leiste.

	Unterschiede zum Button: kein Text in der Flaeche, dafuer Tooltip bei
	Hover und optionaler Badge. Die Kantenlaenge kommt aus
	Responsive.minTouchSize(), damit die Flaeche auch bei der kleinsten
	erlaubten UIScale noch ueber 44 px liegt.
]]

local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Icon = require(UI.Icon)
local Motion = require(UI.Motion)
local Responsive = require(UI.Responsive)
local Badge = require(script.Parent.Badge)
local Tooltip = require(script.Parent.Tooltip)

local IconButton = {}

export type Props = {
	parent: Instance?,
	icon: Icon.Name,
	tooltip: string,
	zIndex: number,
	layoutOrder: number?,
	accent: Color3?,
	onActivated: (() -> ())?,
}

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
	setBadge: (visible: boolean, count: number?) -> (),
	setActive: (active: boolean) -> (),
}

function IconButton.create(props: Props): Handle
	local scope = Motion.scope()
	local accent = props.accent or Theme.Color.primary
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	local side = Responsive.minTouchSize()

	local button = Instance.new("TextButton")
	button.Name = "IconButton_" .. props.icon
	button.Size = UDim2.fromOffset(side, side)
	button.BackgroundColor3 = Theme.Color.bg2
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	button.ZIndex = props.zIndex
	button.LayoutOrder = props.layoutOrder or 0
	button.Parent = props.parent

	Theme.shadow(button, Theme.Radius.control)
	Theme.corner(button, Theme.Radius.control)
	local stroke = Theme.stroke(button, Theme.Color.bg3, Theme.Stroke.hair)
	Theme.gradient(button, Theme.Color.bg2, Theme.Elevation.transparency / Theme.Space.x8)

	local glyph = Icon.create({
		name = props.icon, parent = button, size = Theme.Size.iconInner,
		color = Theme.Color.textMid, zIndex = props.zIndex + Theme.Depth.content,
		anchor = Vector2.new(0.5, 0.5), position = UDim2.fromScale(0.5, 0.5),
	})

	local scale = Instance.new("UIScale")
	scale.Parent = button

	local badge = Badge.create(button, props.zIndex + Theme.Depth.overlay)
	local active = false

	local function paint(hover: boolean, pressed: boolean)
		local fill = if pressed then Theme.Color.bg1
			elseif hover or active then Theme.Color.bg3
			else Theme.Color.bg2
		scope:to(button, { BackgroundColor3 = fill }, Theme.Duration.fast, "enter")
		scope:to(stroke, { Color = if hover or active then accent else Theme.Color.bg3 },
			Theme.Duration.fast, "enter")
		Icon.recolor(glyph, if hover or active then accent else Theme.Color.textMid)
		scope:to(scale, {
			Scale = if pressed then Theme.Scale.pressed
				elseif hover then Theme.Scale.hover
				else Theme.Scale.rest,
		}, if pressed then Theme.Duration.press else Theme.Duration.fast,
			if pressed then "press" else "enter")
	end

	if not touch then
		scope:track(button.MouseEnter:Connect(function()
			paint(true, false)
			Tooltip.show(button, props.tooltip)
		end))
		scope:track(button.MouseLeave:Connect(function()
			paint(false, false)
			Tooltip.hide()
		end))
	end
	scope:track(button.MouseButton1Down:Connect(function()
		paint(true, true)
	end))
	scope:track(button.MouseButton1Up:Connect(function()
		scope:to(scale, { Scale = Theme.Scale.rest }, Theme.Duration.base, "pop")
		paint(not touch, false)
	end))
	scope:track(button.Activated:Connect(function()
		local callback = props.onActivated
		if callback ~= nil then
			callback()
		end
	end))

	return {
		instance = button,
		setBadge = badge.set,
		setActive = function(value: boolean)
			active = value
			paint(false, false)
		end,
		destroy = function()
			badge.destroy()
			scope:destroy()
			button:Destroy()
		end,
	}
end

return IconButton
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX54">
							<Properties>
								<string name="Name">ItemSlot</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ItemSlot – ein Shop-Eintrag.

	Aufbau (vier Ebenen):
	  Card
	   +- Preview (ViewportFrame mit echtem 3D-Modell)
	   +- Textblock (Name, Beschreibung)  -> UIListLayout
	   +- Fussleiste (Preis + Button oder Status)

	Drei Zustaende, die sich nicht nur in der Farbe unterscheiden:
	  * kaufbar   – Akzentrand, Preis in Cash-Farbe, Knopf aktiv
	  * zu teuer  – Rand neutral, Preis gedaempft, Knopf deaktiviert
	  * gesperrt  – Vorschau abgedunkelt, Schloss-Symbol, Voraussetzungstext
	  * gekauft   – abgedunkelt, Haekchen statt Knopf

	Nur Farbe zu aendern reicht nicht: Symbol und Text tragen dieselbe
	Aussage, damit der Zustand auch ohne Farbwahrnehmung lesbar ist.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Format)
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Icon = require(UI.Icon)
local Motion = require(UI.Motion)
local Preview = require(UI.Preview)
local Button = require(script.Parent.Button)

local ItemSlot = {}

export type State = "buyable" | "tooExpensive" | "locked" | "owned"

export type Props = {
	parent: Instance,
	id: string,
	rank: number,
	title: string,
	description: string,
	price: number,
	kind: Preview.Kind,
	zIndex: number,
	layoutOrder: number,
	onBuy: (() -> ())?,
}

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
	setState: (state: State, detail: string?) -> (),
	celebrate: () -> (),
	reject: () -> (),
}

function ItemSlot.create(props: Props): Handle
	local scope = Motion.scope()
	local zIndex = props.zIndex

	local card = Theme.Card({
		name = "Slot_" .. props.id, parent = props.parent,
		size = UDim2.fromOffset(Theme.Size.slotWidth, Theme.Size.slotHeight),
		fill = Theme.Color.bg2,
		radius = Theme.Radius.card,
		zIndex = zIndex,
	})
	card.LayoutOrder = props.layoutOrder
	Theme.padding(card, { all = Theme.Space.x12 })
	local cardStroke = card:FindFirstChildOfClass("UIStroke")

	-- Rangzahl als kleiner Chip oben links
	local rankChip = Instance.new("Frame")
	rankChip.Name = "Rank"
	rankChip.Size = UDim2.fromOffset(Theme.Space.x24, Theme.Space.x24)
	rankChip.Position = UDim2.fromScale(0, 0)
	rankChip.BackgroundColor3 = Theme.Color.bg0
	rankChip.BorderSizePixel = 0
	rankChip.ZIndex = zIndex + Theme.Depth.overlay
	rankChip.Parent = card
	Theme.corner(rankChip, Theme.Radius.chip)
	Theme.label({
		parent = rankChip, text = tostring(props.rank), role = "numeric",
		size = Theme.TextSize.xs, color = Theme.Color.textLow,
		xAlign = Enum.TextXAlignment.Center,
		zIndex = zIndex + Theme.Depth.overlay, stroke = false,
	})

	local preview = Preview.create({
		parent = card, kind = props.kind, accent = Theme.Color.primary,
		size = UDim2.new(1, 0, 0, Theme.Size.slotPreview),
		zIndex = zIndex + Theme.Depth.content,
	})

	-- Schloss ueber der Vorschau, nur im Zustand "gesperrt"
	local lockOverlay = Instance.new("Frame")
	lockOverlay.Name = "Lock"
	lockOverlay.Size = UDim2.fromScale(1, 1)
	lockOverlay.BackgroundColor3 = Theme.Color.bg0
	lockOverlay.BackgroundTransparency = Theme.Alpha.veil
	lockOverlay.BorderSizePixel = 0
	lockOverlay.Visible = false
	lockOverlay.ZIndex = zIndex + Theme.Depth.raised
	lockOverlay.Parent = preview.instance
	Theme.corner(lockOverlay, Theme.Radius.control)
	Icon.create({
		name = "lock", parent = lockOverlay, size = Theme.Size.pillIcon,
		color = Theme.Color.textMid, zIndex = zIndex + Theme.Depth.overlay,
		anchor = Vector2.new(0.5, 0.5), position = UDim2.fromScale(0.5, 0.5),
	})

	local title = Theme.label({
		name = "Title", parent = card, text = props.title, role = "heading",
		size = Theme.TextSize.md, color = Theme.Color.textHigh,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x24),
		position = UDim2.fromOffset(0, Theme.Size.slotPreview + Theme.Space.x8),
		zIndex = zIndex + Theme.Depth.content,
	})
	local description = Theme.label({
		name = "Desc", parent = card, text = props.description, role = "body",
		size = Theme.TextSize.xs, color = Theme.Color.textLow,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x32),
		position = UDim2.fromOffset(0, Theme.Size.slotPreview + Theme.Space.x32),
		wrapped = true, yAlign = Enum.TextYAlignment.Top,
		zIndex = zIndex + Theme.Depth.content, stroke = false,
	})

	local price = Theme.label({
		name = "Price", parent = card, text = Format.abbreviate(props.price) .. " $",
		role = "numeric",
		size = Theme.TextSize.md, color = Theme.Color.success,
		layoutSize = UDim2.new(1, 0, 0, Theme.Space.x24),
		position = UDim2.new(0, 0, 1, -(Theme.Size.controlHeight + Theme.Space.x24)),
		zIndex = zIndex + Theme.Depth.content,
	})

	local buy = Button.create({
		parent = card, text = "KAUFEN", variant = "primary", icon = "plus",
		size = UDim2.new(1, 0, 0, Theme.Size.controlHeight),
		position = UDim2.new(0, 0, 1, -Theme.Size.controlHeight),
		zIndex = zIndex + Theme.Depth.content,
		textSize = Theme.TextSize.sm,
		onActivated = props.onBuy,
	})

	-- Statuszeile, ersetzt den Knopf bei "gekauft"
	local ownedRow = Instance.new("Frame")
	ownedRow.Name = "Owned"
	ownedRow.Size = UDim2.new(1, 0, 0, Theme.Size.controlHeight)
	ownedRow.Position = UDim2.new(0, 0, 1, -Theme.Size.controlHeight)
	ownedRow.BackgroundTransparency = Theme.Alpha.hidden
	ownedRow.Visible = false
	ownedRow.ZIndex = zIndex + Theme.Depth.content
	ownedRow.Parent = card
	Theme.list({
		parent = ownedRow, gap = Theme.Space.x8,
		direction = Enum.FillDirection.Horizontal,
		hAlign = Enum.HorizontalAlignment.Center,
		vAlign = Enum.VerticalAlignment.Center,
	})
	local ownedIcon = Icon.create({
		name = "check", parent = ownedRow, size = Theme.Size.iconSm,
		color = Theme.Color.success, zIndex = zIndex + Theme.Depth.raised,
		layoutOrder = 1,
	})
	ownedIcon.LayoutOrder = 1
	Theme.label({
		parent = ownedRow, text = "GEKAUFT", role = "heading",
		size = Theme.TextSize.sm, color = Theme.Color.success,
		layoutSize = UDim2.fromOffset(Theme.Size.pillWidth / 2, Theme.Size.controlHeight),
		xAlign = Enum.TextXAlignment.Left,
		zIndex = zIndex + Theme.Depth.raised, layoutOrder = 2, stroke = false,
	})

	local function setState(state: State, detail: string?)
		local owned = state == "owned"
		local locked = state == "locked"
		local affordable = state == "buyable"

		lockOverlay.Visible = locked
		ownedRow.Visible = owned
		buy.instance.Visible = not owned
		price.Visible = not owned

		description.Text = detail or props.description

		scope:to(card, {
			BackgroundTransparency = if owned or locked
				then Theme.Alpha.glass
				else Theme.Alpha.opaque,
		}, Theme.Duration.base, "enter")

		if cardStroke ~= nil then
			scope:to(cardStroke, {
				Color = if owned then Theme.Color.successDeep
					elseif affordable then Theme.Color.primary
					else Theme.Color.bg3,
			}, Theme.Duration.base, "enter")
		end

		scope:to(title, {
			TextColor3 = if locked then Theme.Color.textLow else Theme.Color.textHigh,
		}, Theme.Duration.fast, "enter")
		scope:to(price, {
			TextColor3 = if affordable then Theme.Color.success else Theme.Color.textLow,
		}, Theme.Duration.fast, "enter")

		if owned then
			return
		end
		if locked then
			buy.setState("disabled")
			buy.setText("GESPERRT")
		elseif affordable then
			buy.setState("idle")
			buy.setText("KAUFEN")
		else
			buy.setState("disabled")
			buy.setText("ZU TEUER")
		end
	end

	setState("locked")

	return {
		instance = card,
		setState = setState,

		-- Erfolgreicher Kauf: einmaliges gruenes Pulsieren.
		celebrate = function()
			if cardStroke ~= nil then
				scope:to(cardStroke, {
					Color = Theme.Color.success, Thickness = Theme.Stroke.thick,
				}, Theme.Duration.fast, "pop")
				task.delay(Theme.Duration.slow, function()
					if card.Parent == nil then
						return
					end
					scope:to(cardStroke, {
						Color = Theme.Color.successDeep, Thickness = Theme.Stroke.hair,
					}, Theme.Duration.slow, "exit")
				end)
			end
		end,

		-- Zu wenig Geld: Ruetteln am Knopf, kein Popup.
		reject = buy.shake,

		destroy = function()
			buy.destroy()
			preview.destroy()
			scope:destroy()
			card:Destroy()
		end,
	}
end

return ItemSlot
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX55">
							<Properties>
								<string name="Name">Modal</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Modal – abdunkelnder Hintergrund hinter geoeffneten Panels.

	Zum "Backdrop Blur": Roblox kann GUI-Ebenen NICHT weichzeichnen. Es
	gibt keinen Filter, der auf ScreenGui-Inhalte wirkt. Machbar ist nur:

	  1. dunkles Overlay ueber der Welt (Transparency 0.45) – das ist der
	     eigentliche Traeger der Trennung, und
	  2. ein BlurEffect in Lighting, der die 3D-WELT hinter der
	     Oberflaeche weichzeichnet. Das kommt dem Effekt sehr nahe, weil
	     hinter einem Panel ohnehin fast nur Welt liegt.
	  3. eine leichte ColorCorrection-Absenkung, damit die Welt zusaetzlich
	     zuruecktritt.

	Die Ebenen des Interfaces selbst bleiben scharf. Etwas anderes ist in
	Roblox nicht moeglich, und ich behaupte es auch nicht.

	Der Backdrop ist zaehlergesteuert: mehrere Panels koennen ihn
	anfordern, er verschwindet erst, wenn das letzte geschlossen ist.
]]

local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Layers = require(UI.Layers)
local Motion = require(UI.Motion)

local Modal = {}

local backdrop: TextButton? = nil
local blur: BlurEffect? = nil
local correction: ColorCorrectionEffect? = nil
local scope = Motion.scope()
local openCount = 0

-- Wird gesetzt, damit ein Klick auf den Hintergrund das oberste Panel schliesst.
Modal.onBackdropClicked = function() end

local BLUR_MAX = Theme.Space.x16

function Modal.build(root: GuiObject)
	if backdrop ~= nil then
		return
	end
	-- TextButton statt Frame: faengt Klicks ab, damit man nicht durch das
	-- Overlay hindurch in die Welt klickt.
	local overlay = Instance.new("TextButton")
	overlay.Name = "Backdrop"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Theme.Color.bg0
	overlay.BackgroundTransparency = Theme.Alpha.hidden
	overlay.BorderSizePixel = 0
	overlay.AutoButtonColor = false
	overlay.Text = ""
	overlay.Visible = false
	overlay.ZIndex = Layers.at("modal", Theme.Depth.behind)
	overlay.Parent = root
	scope:track(overlay.Activated:Connect(function()
		Modal.onBackdropClicked()
	end))
	backdrop = overlay

	local blurEffect = Instance.new("BlurEffect")
	blurEffect.Name = "ModalBlur"
	blurEffect.Size = 0
	blurEffect.Enabled = false
	blurEffect.Parent = Lighting
	blur = blurEffect

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "ModalDim"
	cc.Brightness = 0
	cc.Enabled = false
	cc.Parent = Lighting
	correction = cc
end

function Modal.push()
	openCount += 1
	if openCount > 1 then
		return
	end
	local overlay, blurEffect, cc = backdrop, blur, correction
	if overlay == nil then
		return
	end
	overlay.Visible = true
	overlay.BackgroundTransparency = Theme.Alpha.hidden
	scope:to(overlay, { BackgroundTransparency = Theme.Alpha.backdrop },
		Theme.Duration.base, "enter")
	if blurEffect ~= nil then
		blurEffect.Enabled = true
		blurEffect.Size = 0
		scope:to(blurEffect, { Size = BLUR_MAX }, Theme.Duration.base, "enter")
	end
	if cc ~= nil then
		cc.Enabled = true
		cc.Brightness = 0
		scope:to(cc, { Brightness = -Theme.Alpha.glass }, Theme.Duration.base, "enter")
	end
end

function Modal.pop()
	openCount = math.max(0, openCount - 1)
	if openCount > 0 then
		return
	end
	local overlay, blurEffect, cc = backdrop, blur, correction
	if overlay == nil then
		return
	end
	local tween = scope:to(overlay, { BackgroundTransparency = Theme.Alpha.hidden },
		Theme.Duration.base, "exit")
	tween.Completed:Once(function()
		if openCount == 0 and backdrop ~= nil then
			backdrop.Visible = false
		end
	end)
	if blurEffect ~= nil then
		local blurTween = scope:to(blurEffect, { Size = 0 }, Theme.Duration.base, "exit")
		blurTween.Completed:Once(function()
			if openCount == 0 and blur ~= nil then
				-- Deaktivieren statt nur auf 0: ein aktiver BlurEffect
				-- kostet auch bei Groesse 0 einen Renderdurchgang.
				blur.Enabled = false
			end
		end)
	end
	if cc ~= nil then
		local ccTween = scope:to(cc, { Brightness = 0 }, Theme.Duration.base, "exit")
		ccTween.Completed:Once(function()
			if openCount == 0 and correction ~= nil then
				correction.Enabled = false
			end
		end)
	end
end

function Modal.destroy()
	scope:destroy()
	openCount = 0
	if backdrop ~= nil then
		backdrop:Destroy()
		backdrop = nil
	end
	if blur ~= nil then
		blur:Destroy()
		blur = nil
	end
	if correction ~= nil then
		correction:Destroy()
		correction = nil
	end
end

return Modal
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX56">
							<Properties>
								<string name="Name">Panel</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Panel – der Rahmen aller Dialoge.

	Aufbau:
	  Card (Schatten, Radius panel, Rand, Verlauf)
	   +- Header  (Titel, Untertitel, Close)
	   +- Divider
	   +- Body    (Frame oder ScrollingFrame, je nach `scrolling`)

	Groesse: Scale-basiert mit UISizeConstraint als Deckel und einem
	UIAspectRatioConstraint, dessen Verhaeltnis je nach Ausrichtung
	umgeschaltet wird. Ein fest eingestelltes Querformat-Verhaeltnis
	waere im Hochformat nur noch ein flacher Streifen.

	Ein- und Ausblenden laeuft IMMER ueber Tween (Scale 0.92 -> 1 plus
	Transparenz); `Visible` wird nur am Ende der Ausblend-Animation
	gesetzt, nie als alleiniges Mittel.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Icon = require(UI.Icon)
local Layers = require(UI.Layers)
local Motion = require(UI.Motion)
local Responsive = require(UI.Responsive)
local Modal = require(script.Parent.Modal)

local Panel = {}

export type Props = {
	parent: Instance,
	gui: ScreenGui,
	name: string,
	title: string,
	subtitle: string?,
	scrolling: boolean?,
	accent: Color3?,
	onClose: (() -> ())?,
}

export type Handle = {
	instance: GuiObject,
	body: GuiObject,
	destroy: (() -> ()),
	open: () -> (),
	close: () -> (),
	toggle: () -> (),
	isOpen: () -> boolean,
	setSubtitle: (text: string) -> (),
}

local ASPECT_LANDSCAPE = 1.45
local ASPECT_PORTRAIT = 0.78

function Panel.create(props: Props): Handle
	local scope = Motion.scope()
	local accent = props.accent or Theme.Color.primary
	local zIndex = Layers.at("panel", Theme.Depth.base)
	local open = false

	local card = Theme.Card({
		name = props.name, parent = props.parent,
		size = UDim2.fromScale(0.9, 0.84),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		fill = Theme.Color.bg1,
		radius = Theme.Radius.panel,
		strokeColor = accent,
		zIndex = zIndex,
		visible = false,
	})

	local sizeLimit = Instance.new("UISizeConstraint")
	sizeLimit.MaxSize = Vector2.new(Theme.Size.panelWidth, Theme.Size.panelHeight)
	sizeLimit.MinSize = Vector2.new(Theme.Size.slotWidth, Theme.Size.panelHeaderHeight * 3)
	sizeLimit.Parent = card

	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectType = Enum.AspectType.FitWithinMaxSize
	aspect.DominantAxis = Enum.DominantAxis.Width
	aspect.Parent = card

	local scale = Instance.new("UIScale")
	scale.Parent = card

	-- ---- Kopfzeile -------------------------------------------------------
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, Theme.Size.panelHeaderHeight)
	header.BackgroundTransparency = Theme.Alpha.hidden
	header.ZIndex = zIndex + Theme.Depth.content
	header.Parent = card
	Theme.padding(header, { left = Theme.Space.x24, right = Theme.Space.x16, top = Theme.Space.x16 })

	Theme.label({
		name = "Title", parent = header, text = props.title, role = "display",
		size = Theme.TextSize.xl, color = accent,
		layoutSize = UDim2.new(1, -Theme.Size.iconButton, 0, Theme.Space.x32),
		zIndex = zIndex + Theme.Depth.raised,
	})
	local subtitle = Theme.label({
		name = "Subtitle", parent = header, text = props.subtitle or "", role = "body",
		size = Theme.TextSize.sm, color = Theme.Color.textLow,
		layoutSize = UDim2.new(1, -Theme.Size.iconButton, 0, Theme.Space.x16),
		position = UDim2.fromOffset(0, Theme.Space.x32),
		zIndex = zIndex + Theme.Depth.raised, stroke = false,
	})

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.Size = UDim2.fromOffset(Responsive.minTouchSize(), Responsive.minTouchSize())
	close.Position = UDim2.fromScale(1, 0)
	close.AnchorPoint = Vector2.new(1, 0)
	close.BackgroundColor3 = Theme.Color.bg3
	close.BorderSizePixel = 0
	close.AutoButtonColor = false
	close.Text = ""
	close.ZIndex = zIndex + Theme.Depth.raised
	close.Parent = header
	Theme.corner(close, Theme.Radius.control)
	local closeStroke = Theme.stroke(close, Theme.Color.bg3, Theme.Stroke.hair)
	local closeGlyph = Icon.create({
		name = "close", parent = close, size = Theme.Size.iconSm,
		color = Theme.Color.textMid, zIndex = zIndex + Theme.Depth.overlay,
		anchor = Vector2.new(0.5, 0.5), position = UDim2.fromScale(0.5, 0.5),
	})
	scope:track(close.MouseEnter:Connect(function()
		scope:to(closeStroke, { Color = Theme.Color.danger }, Theme.Duration.fast, "enter")
		Icon.recolor(closeGlyph, Theme.Color.danger)
	end))
	scope:track(close.MouseLeave:Connect(function()
		scope:to(closeStroke, { Color = Theme.Color.bg3 }, Theme.Duration.fast, "enter")
		Icon.recolor(closeGlyph, Theme.Color.textMid)
	end))

	local divider = Theme.divider(card, 0)
	divider.Position = UDim2.fromOffset(0, Theme.Size.panelHeaderHeight)
	divider.ZIndex = zIndex + Theme.Depth.content

	-- ---- Inhalt ------------------------------------------------------------
	local body: GuiObject
	if props.scrolling then
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name = "Body"
		scroll.BackgroundTransparency = Theme.Alpha.hidden
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = Theme.Size.scrollBar
		scroll.ScrollBarImageColor3 = Theme.Color.bg3
		scroll.ScrollBarImageTransparency = Theme.Alpha.veil
		scroll.CanvasSize = UDim2.new()
		scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		scroll.ScrollingDirection = Enum.ScrollingDirection.Y
		scroll.ElasticBehavior = Enum.ElasticBehavior.Never
		body = scroll
	else
		local frame = Instance.new("Frame")
		frame.Name = "Body"
		frame.BackgroundTransparency = Theme.Alpha.hidden
		body = frame
	end
	body.Size = UDim2.new(1, 0, 1, -(Theme.Size.panelHeaderHeight + Theme.Size.dividerHeight))
	body.Position = UDim2.fromOffset(0, Theme.Size.panelHeaderHeight + Theme.Size.dividerHeight)
	body.ZIndex = zIndex + Theme.Depth.content
	body.Parent = card
	Theme.padding(body, { all = Theme.Space.x16 })

	-- ---- Ausrichtung ---------------------------------------------------------
	local function applyViewport()
		local viewport = Responsive.read(props.gui)
		aspect.AspectRatio = if viewport.portrait then ASPECT_PORTRAIT else ASPECT_LANDSCAPE
	end
	applyViewport()
	scope:track(props.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyViewport))

	-- ---- Oeffnen und Schliessen -------------------------------------------------
	local function doOpen()
		if open then
			return
		end
		open = true
		Modal.push()
		card.Visible = true
		scale.Scale = Theme.Scale.panelEnter
		card.BackgroundTransparency = Theme.Alpha.hidden
		scope:to(scale, { Scale = Theme.Scale.rest }, Theme.Duration.base, "enter")
		scope:to(card, { BackgroundTransparency = Theme.Alpha.opaque },
			Theme.Duration.base, "enter")
	end

	local function doClose()
		if not open then
			return
		end
		open = false
		Modal.pop()
		scope:to(scale, { Scale = Theme.Scale.panelEnter }, Theme.Duration.base, "exit")
		local fade = scope:to(card, { BackgroundTransparency = Theme.Alpha.hidden },
			Theme.Duration.base, "exit")
		fade.Completed:Once(function()
			if not open then
				card.Visible = false
			end
		end)
		local callback = props.onClose
		if callback ~= nil then
			callback()
		end
	end

	scope:track(close.Activated:Connect(doClose))

	return {
		instance = card,
		body = body,
		open = doOpen,
		close = doClose,
		toggle = function()
			if open then
				doClose()
			else
				doOpen()
			end
		end,
		isOpen = function(): boolean
			return open
		end,
		setSubtitle = function(text: string)
			subtitle.Text = text
		end,
		destroy = function()
			if open then
				Modal.pop()
				open = false
			end
			scope:destroy()
			card:Destroy()
		end,
	}
end

return Panel
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX57">
							<Properties>
								<string name="Name">ProgressBar</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProgressBar – Fortschritt mit animierter Fuellung und Glanzstreifen.

	Der Glanzstreifen laeuft nur, solange die Leiste weder leer noch voll
	ist: bei 0 % gibt es nichts zu bewerben, bei 100 % lenkt er vom
	Abholen-Knopf ab. Bei reduzierter Bewegung entfaellt er ganz
	(Theme.loopInfo liefert dann nil).
]]

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Motion = require(UI.Motion)

local ProgressBar = {}

export type Props = {
	parent: Instance?,
	zIndex: number,
	color: Color3?,
	size: UDim2?,
	layoutOrder: number?,
}

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
	set: (ratio: number, color: Color3?) -> (),
}

function ProgressBar.create(props: Props): Handle
	local scope = Motion.scope()

	local track = Instance.new("Frame")
	track.Name = "ProgressTrack"
	track.Size = props.size or UDim2.new(1, 0, 0, Theme.Size.barHeight)
	track.BackgroundColor3 = Theme.Color.bg0
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.ZIndex = props.zIndex
	track.LayoutOrder = props.layoutOrder or 0
	track.Parent = props.parent
	Theme.corner(track, Theme.Radius.pill)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = props.color or Theme.Color.success
	fill.BorderSizePixel = 0
	fill.ZIndex = props.zIndex + Theme.Depth.content
	fill.Parent = track
	Theme.corner(fill, Theme.Radius.pill)
	Theme.gradient(fill, props.color or Theme.Color.success,
		Theme.Elevation.transparency / Theme.Space.x4)

	-- Glanzstreifen: schmale helle Flaeche, die ueber die Fuellung wandert.
	local shine = Instance.new("Frame")
	shine.Name = "Shine"
	shine.Size = UDim2.new(0, Theme.Space.x24, 1, 0)
	shine.Position = UDim2.fromScale(-1, 0)
	shine.BackgroundColor3 = Theme.Color.textHigh
	shine.BackgroundTransparency = Theme.Alpha.ghost
	shine.BorderSizePixel = 0
	shine.Rotation = 12
	shine.ZIndex = props.zIndex + Theme.Depth.raised
	shine.Parent = fill
	local shineTween: Tween? = nil

	local function setShine(running: boolean)
		local current = shineTween
		if not running then
			if current ~= nil then
				current:Cancel()
				current:Destroy()
				shineTween = nil
				shine.Position = UDim2.fromScale(-1, 0)
			end
			return
		end
		if current ~= nil then
			return
		end
		local info = Theme.loopInfo(Theme.Duration.shine)
		if info == nil then
			return   -- reduzierte Bewegung: kein Glanzstreifen
		end
		local tween = TweenService:Create(shine, info, { Position = UDim2.fromScale(1, 0) })
		shineTween = tween
		tween:Play()
	end

	return {
		instance = track,
		set = function(ratio: number, color: Color3?)
			local clamped = math.clamp(ratio, 0, 1)
			scope:to(fill, { Size = UDim2.fromScale(clamped, 1) }, Theme.Duration.slow, "enter")
			if color ~= nil then
				scope:to(fill, { BackgroundColor3 = color }, Theme.Duration.base, "enter")
			end
			setShine(clamped > 0 and clamped < 1)
		end,
		destroy = function()
			setShine(false)
			scope:destroy()
			track:Destroy()
		end,
	}
end

return ProgressBar
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX58">
							<Properties>
								<string name="Name">SegmentedControl</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	SegmentedControl – Auswahl aus zwei bis vier Optionen.

	Der Auswahlbalken ist EIN Element, das zwischen den Segmenten
	wandert, statt pro Segment ein- und auszublenden. Das liest sich als
	Bewegung statt als Flackern und kostet nur einen Tween.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Motion = require(UI.Motion)
local Responsive = require(UI.Responsive)

local SegmentedControl = {}

export type Option = { id: string, label: string }

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
	select: (id: string, notify: boolean?) -> (),
	selected: () -> string,
}

function SegmentedControl.create(parent: Instance, options: { Option },
	zIndex: number, onChange: (id: string) -> ()): Handle
	local scope = Motion.scope()
	local current = options[1].id
	local count = #options

	local track = Instance.new("Frame")
	track.Name = "Segmented"
	track.Size = UDim2.new(1, 0, 0, Responsive.minTouchSize())
	track.BackgroundColor3 = Theme.Color.bg0
	track.BorderSizePixel = 0
	track.ZIndex = zIndex
	track.Parent = parent
	Theme.corner(track, Theme.Radius.control)
	Theme.padding(track, { all = Theme.Space.x4 })

	-- Wandernder Auswahlbalken, liegt UNTER den Beschriftungen.
	local thumb = Instance.new("Frame")
	thumb.Name = "Thumb"
	thumb.Size = UDim2.fromScale(1 / count, 1)
	thumb.BackgroundColor3 = Theme.Color.primary
	thumb.BorderSizePixel = 0
	thumb.ZIndex = zIndex + Theme.Depth.content
	thumb.Parent = track
	Theme.corner(thumb, Theme.Radius.chip)
	Theme.gradient(thumb, Theme.Color.primary, Theme.Elevation.transparency / Theme.Space.x8)

	local labels: { [string]: TextLabel } = {}

	local function paint(animate: boolean)
		local index = 1
		for position, option in ipairs(options) do
			if option.id == current then
				index = position
			end
		end
		local target = UDim2.fromScale((index - 1) / count, 0)
		if animate then
			scope:to(thumb, { Position = target }, Theme.Duration.base, "enter")
		else
			thumb.Position = target
		end
		for id, label in pairs(labels) do
			scope:to(label, {
				TextColor3 = if id == current then Theme.Color.bg0 else Theme.Color.textLow,
			}, Theme.Duration.fast, "enter")
		end
	end

	for index, option in ipairs(options) do
		local button = Instance.new("TextButton")
		button.Name = option.id
		button.Size = UDim2.fromScale(1 / count, 1)
		button.Position = UDim2.fromScale((index - 1) / count, 0)
		button.BackgroundTransparency = Theme.Alpha.hidden
		button.BorderSizePixel = 0
		button.AutoButtonColor = false
		button.Text = ""
		button.ZIndex = zIndex + Theme.Depth.raised
		button.Parent = track

		labels[option.id] = Theme.label({
			parent = button, text = option.label, role = "heading",
			size = Theme.TextSize.sm, color = Theme.Color.textLow,
			layoutSize = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Center,
			zIndex = zIndex + Theme.Depth.overlay, stroke = false,
		})

		scope:track(button.Activated:Connect(function()
			if current == option.id then
				return
			end
			current = option.id
			paint(true)
			onChange(option.id)
		end))
	end
	paint(false)

	return {
		instance = track,
		select = function(id: string, notify: boolean?)
			-- Optional annotiert: unbekannte Id liefert zur Laufzeit nil.
			local existing: TextLabel? = labels[id]
			if existing == nil or current == id then
				return
			end
			current = id
			paint(true)
			if notify ~= false then
				onChange(id)
			end
		end,
		selected = function(): string
			return current
		end,
		destroy = function()
			scope:destroy()
			track:Destroy()
		end,
	}
end

return SegmentedControl
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX59">
							<Properties>
								<string name="Name">Tabs</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Tabs – senkrechte Reiterspalte im Shop.

	Der aktive Reiter wird nicht nur eingefaerbt, sondern bekommt zusaetzlich
	einen Markierungsbalken links. Farbe allein ist als einziges
	Unterscheidungsmerkmal fuer Farbsehschwaechen zu wenig.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Motion = require(UI.Motion)
local Responsive = require(UI.Responsive)

local Tabs = {}

export type Item = { id: string, label: string }

export type Handle = {
	instance: GuiObject,
	destroy: (() -> ()),
	select: (id: string) -> (),
	selected: () -> string,
}

function Tabs.create(parent: Instance, items: { Item }, zIndex: number,
	onChange: (id: string) -> ()): Handle
	local scope = Motion.scope()
	local current = items[1].id

	local column = Instance.new("Frame")
	column.Name = "Tabs"
	column.Size = UDim2.new(0, Theme.Size.tabWidth, 1, 0)
	column.BackgroundTransparency = Theme.Alpha.hidden
	column.ZIndex = zIndex
	column.Parent = parent
	Theme.list({ parent = column, gap = Theme.Space.x4 })

	type Entry = { button: TextButton, marker: Frame, label: TextLabel }
	local entries: { [string]: Entry } = {}

	local function paint()
		for id, entry in pairs(entries) do
			local active = id == current
			scope:to(entry.button, {
				BackgroundColor3 = if active then Theme.Color.bg3 else Theme.Color.bg1,
				BackgroundTransparency = if active then Theme.Alpha.opaque else Theme.Alpha.glass,
			}, Theme.Duration.fast, "enter")
			scope:to(entry.label, {
				TextColor3 = if active then Theme.Color.textHigh else Theme.Color.textLow,
			}, Theme.Duration.fast, "enter")
			scope:to(entry.marker, {
				Size = UDim2.new(0, Theme.Space.x4, if active then 0.6 else 0, 0),
				BackgroundTransparency = if active then Theme.Alpha.opaque else Theme.Alpha.hidden,
			}, Theme.Duration.base, "enter")
		end
	end

	for index, item in ipairs(items) do
		local button = Instance.new("TextButton")
		button.Name = item.id
		button.Size = UDim2.new(1, 0, 0, Responsive.minTouchSize())
		button.BackgroundColor3 = Theme.Color.bg1
		button.BorderSizePixel = 0
		button.AutoButtonColor = false
		button.Text = ""
		button.LayoutOrder = index
		button.ZIndex = zIndex + Theme.Depth.content
		button.Parent = column
		Theme.corner(button, Theme.Radius.control)

		local marker = Instance.new("Frame")
		marker.Name = "Marker"
		marker.Size = UDim2.new(0, Theme.Space.x4, 0, 0)
		marker.Position = UDim2.new(0, Theme.Space.x8, 0.5, 0)
		marker.AnchorPoint = Vector2.new(0, 0.5)
		marker.BackgroundColor3 = Theme.Color.primary
		marker.BorderSizePixel = 0
		marker.ZIndex = zIndex + Theme.Depth.raised
		marker.Parent = button
		Theme.corner(marker, Theme.Radius.pill)

		local label = Theme.label({
			parent = button, text = item.label, role = "heading",
			size = Theme.TextSize.sm, color = Theme.Color.textLow,
			layoutSize = UDim2.new(1, -Theme.Space.x24, 1, 0),
			position = UDim2.fromOffset(Theme.Space.x24, 0),
			zIndex = zIndex + Theme.Depth.raised, stroke = false,
		})

		entries[item.id] = { button = button, marker = marker, label = label }
		scope:track(button.Activated:Connect(function()
			if current == item.id then
				return
			end
			current = item.id
			paint()
			onChange(item.id)
		end))
	end
	paint()

	return {
		instance = column,
		select = function(id: string)
			if entries[id] == nil or current == id then
				return
			end
			current = id
			paint()
			onChange(id)
		end,
		selected = function(): string
			return current
		end,
		destroy = function()
			scope:destroy()
			column:Destroy()
		end,
	}
end

return Tabs
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX60">
							<Properties>
								<string name="Name">Toast</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Toast – kurze Rueckmeldung oben rechts.

	Faehrt von rechts ein, nicht ein: die Bewegung kommt aus der Richtung,
	in der das Element liegt, das ist die ruhigste Variante. Maximal drei
	gleichzeitig; der aelteste weicht, statt dass sich der Stapel bis zum
	Bildschirmrand schiebt.

	Position ueber ein UIListLayout, nicht ueber gerechnete Pixel: beim
	Entfernen eines Toasts ruecken die uebrigen dadurch von selbst nach.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Icon = require(UI.Icon)
local Layers = require(UI.Layers)
local Motion = require(UI.Motion)

local Toast = {}

local MAX_VISIBLE = 3
local LIFETIME = 3.2

local holder: Frame? = nil
local scope = Motion.scope()

export type Kind = "success" | "error" | "info"

function Toast.build(root: GuiObject, topInset: number)
	if holder ~= nil then
		return
	end
	local frame = Instance.new("Frame")
	frame.Name = "Toasts"
	frame.Size = UDim2.new(0, Theme.Size.toastWidth, 1, -topInset)
	frame.Position = UDim2.new(1, -Theme.Safe.edge, 0, topInset)
	frame.AnchorPoint = Vector2.new(1, 0)
	frame.BackgroundTransparency = Theme.Alpha.hidden
	frame.ZIndex = Layers.at("toast", Theme.Depth.base)
	frame.Parent = root
	Theme.list({
		parent = frame, gap = Theme.Space.x8,
		hAlign = Enum.HorizontalAlignment.Right,
	})
	holder = frame
end

function Toast.setInset(topInset: number)
	if holder ~= nil then
		holder.Position = UDim2.new(1, -Theme.Safe.edge, 0, topInset)
		holder.Size = UDim2.new(0, Theme.Size.toastWidth, 1, -topInset)
	end
end

-- Die Icon-Namen werden explizit typisiert: als nackte Rueckgabeliterale
-- weitet Luau sie zu `string` und der Union-Typ passt dann nicht mehr.
local ICON_SUCCESS: Icon.Name = "check"
local ICON_ERROR: Icon.Name = "close"
local ICON_INFO: Icon.Name = "quest"

local function accentFor(kind: Kind): (Color3, Icon.Name)
	if kind == "success" then
		return Theme.Color.success, ICON_SUCCESS
	elseif kind == "error" then
		return Theme.Color.danger, ICON_ERROR
	end
	return Theme.Color.primary, ICON_INFO
end

function Toast.show(text: string, kind: Kind)
	local frame = holder
	if frame == nil then
		return
	end

	local live = {}
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(live, child)
		end
	end
	if #live >= MAX_VISIBLE then
		live[1]:Destroy()
	end

	local accent: Color3, iconName: Icon.Name = accentFor(kind)
	local zIndex = Layers.at("toast", Theme.Depth.content)

	local card = Theme.Card({
		name = "Toast", parent = frame,
		size = UDim2.new(1, 0, 0, Theme.Size.rowHeight),
		fill = Theme.Color.bg2,
		radius = Theme.Radius.card,
		strokeColor = accent,
		zIndex = zIndex,
	})
	card.LayoutOrder = math.floor(os.clock() * Theme.Size.touchMin)

	-- Farbstreifen links: traegt die Bedeutung auch ohne Icon.
	local stripe = Instance.new("Frame")
	stripe.Name = "Stripe"
	stripe.Size = UDim2.new(0, Theme.Space.x4, 1, -Theme.Space.x16)
	stripe.Position = UDim2.new(0, Theme.Space.x8, 0.5, 0)
	stripe.AnchorPoint = Vector2.new(0, 0.5)
	stripe.BackgroundColor3 = accent
	stripe.BorderSizePixel = 0
	stripe.ZIndex = zIndex + Theme.Depth.content
	stripe.Parent = card
	Theme.corner(stripe, Theme.Radius.pill)

	Icon.create({
		name = iconName, parent = card, size = Theme.Size.iconSm,
		color = accent, zIndex = zIndex + Theme.Depth.content,
		anchor = Vector2.new(0, 0.5),
		position = UDim2.new(0, Theme.Space.x24, 0.5, 0),
	})

	Theme.label({
		parent = card, text = text, role = "heading",
		size = Theme.TextSize.sm, color = Theme.Color.textHigh,
		layoutSize = UDim2.new(1, -(Theme.Space.x48 + Theme.Space.x16), 1, 0),
		position = UDim2.fromOffset(Theme.Space.x48, 0),
		wrapped = true, zIndex = zIndex + Theme.Depth.content,
	})

	-- Einfahren von rechts ueber eine UIScale-freie Positionsverschiebung
	-- innerhalb des Layouts waere nicht moeglich; stattdessen wandert der
	-- Inhalt ueber ein eigenes Offset-Frame.
	local slide = Instance.new("UIScale")
	slide.Scale = Theme.Scale.panelEnter
	slide.Parent = card
	card.BackgroundTransparency = Theme.Alpha.hidden
	scope:to(slide, { Scale = Theme.Scale.rest }, Theme.Duration.base, "pop")
	scope:to(card, { BackgroundTransparency = Theme.Alpha.opaque },
		Theme.Duration.base, "enter")

	task.delay(LIFETIME, function()
		if card.Parent == nil then
			return
		end
		local fade = scope:to(card, { BackgroundTransparency = Theme.Alpha.hidden },
			Theme.Duration.slow, "exit")
		scope:to(slide, { Scale = Theme.Scale.panelEnter }, Theme.Duration.slow, "exit")
		fade.Completed:Once(function()
			card:Destroy()
		end)
	end)
end

function Toast.destroy()
	scope:destroy()
	if holder ~= nil then
		holder:Destroy()
		holder = nil
	end
end

return Toast
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX61">
							<Properties>
								<string name="Name">Tooltip</string>
								<bool name="Disabled">false</bool>
								<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Tooltip – einer fuer das ganze Interface.

	Bewusst ein Singleton statt eines Tooltips pro Knopf: es kann immer
	nur einer sichtbar sein, und ein wandernder Tooltip haelt die
	Instanzzahl konstant statt mit jedem Knopf zu wachsen.

	Auf Touchgeraeten wird der Tooltip nie angezeigt - es gibt dort kein
	Hover, und ein Tooltip beim Antippen verdeckt nur das Ziel.
]]

local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local Layers = require(UI.Layers)
local Motion = require(UI.Motion)

local Tooltip = {}

local frame: Frame? = nil
local label: TextLabel? = nil
local scope = Motion.scope()

function Tooltip.build(root: GuiObject)
	if frame ~= nil then
		return
	end
	local zIndex = Layers.at("tooltip", Theme.Depth.base)
	local card = Theme.Card({
		name = "Tooltip", parent = root,
		size = UDim2.fromOffset(Theme.Size.tooltipMaxWidth, Theme.Size.controlHeightSm),
		anchor = Vector2.new(0.5, 1),
		fill = Theme.Color.bg3,
		radius = Theme.Radius.control,
		zIndex = zIndex,
		padding = Theme.Space.x8,
		visible = false,
	})
	card.AutomaticSize = Enum.AutomaticSize.X

	label = Theme.label({
		parent = card, text = "", role = "body",
		size = Theme.TextSize.sm, color = Theme.Color.textHigh,
		layoutSize = UDim2.fromScale(1, 1),
		xAlign = Enum.TextXAlignment.Center,
		zIndex = zIndex + Theme.Depth.content,
	})
	frame = card
end

-- Zeigt den Tooltip mittig ueber dem uebergebenen Element.
function Tooltip.show(anchor: GuiObject, text: string)
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return
	end
	local card, textLabel = frame, label
	if card == nil or textLabel == nil then
		return
	end
	textLabel.Text = text
	local position = anchor.AbsolutePosition
	local size = anchor.AbsoluteSize
	card.Position = UDim2.fromOffset(
		math.floor(position.X + size.X / 2),
		math.floor(position.Y - Theme.Space.x8)
	)
	card.Visible = true
	card.BackgroundTransparency = Theme.Alpha.hidden
	scope:to(card, { BackgroundTransparency = Theme.Alpha.opaque }, Theme.Duration.fast, "enter")
end

function Tooltip.hide()
	local card = frame
	if card == nil or not card.Visible then
		return
	end
	local tween = scope:to(card, { BackgroundTransparency = Theme.Alpha.hidden },
		Theme.Duration.fast, "exit")
	tween.Completed:Once(function()
		if frame ~= nil then
			frame.Visible = false
		end
	end)
end

function Tooltip.destroy()
	scope:destroy()
	if frame ~= nil then
		frame:Destroy()
		frame = nil
		label = nil
	end
end

return Tooltip
]]></ProtectedString>
							</Properties>
						</Item>
					</Item>
				</Item>
			</Item>
		</Item>
	</Item>
</roblox>
